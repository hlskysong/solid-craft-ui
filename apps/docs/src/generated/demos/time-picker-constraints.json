pan style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"时间区间\"</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;</span><span style=\"color:#005CC5\">TimePicker</span><span style=\"color:#6F42C1\"> defaultValue</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"09:00\"</span><span style=\"color:#6F42C1\"> min</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"08:30\"</span><span style=\"color:#6F42C1\"> max</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"18:00\"</span><span style=\"color:#6F42C1\"> aria-label</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"工作时间\"</span><span style=\"color:#24292E\"> /></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">      &#x3C;/</span><span style=\"color:#005CC5\">DemoSection</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E\">      &#x3C;</span><span style=\"color:#005CC5\">DemoSection</span><span style=\"color:#6F42C1\"> title</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"自定义禁用\"</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;</span><span style=\"color:#005CC5\">TimePicker</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">          defaultValue</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"10:00\"</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">          disabledTime</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{(</span><span style=\"color:#E36209\">time</span><span style=\"color:#24292E\">) </span><span style=\"color:#D73A49\">=></span><span style=\"color:#24292E\"> time.hour </span><span style=\"color:#D73A49\">>=</span><span style=\"color:#005CC5\"> 12</span><span style=\"color:#D73A49\"> &#x26;&#x26;</span><span style=\"color:#24292E\"> time.hour </span><span style=\"color:#D73A49\">&#x3C;</span><span style=\"color:#005CC5\"> 13</span><span style=\"color:#24292E\">}</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">          aria-label</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"排除午休\"</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        /></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;</span><span style=\"color:#005CC5\">TimePicker</span><span style=\"color:#6F42C1\"> defaultValue</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"10:00\"</span><span style=\"color:#6F42C1\"> disabled</span><span style=\"color:#6F42C1\"> aria-label</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"禁用\"</span><span style=\"color:#24292E\"> /></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">      &#x3C;/</span><span style=\"color:#005CC5\">DemoSection</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">    &#x3C;/></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  );</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">}</span></span>\n<span class=\"line\"></span></code></pre>"
