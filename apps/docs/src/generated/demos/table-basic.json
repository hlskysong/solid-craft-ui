"line\"><span style=\"color:#D73A49\">const</span><span style=\"color:#005CC5\"> columns</span><span style=\"color:#D73A49\">:</span><span style=\"color:#6F42C1\"> TableColumn</span><span style=\"color:#24292E\">&#x3C;</span><span style=\"color:#6F42C1\">Row</span><span style=\"color:#24292E\">>[] </span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\"> [</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  { title: </span><span style=\"color:#032F62\">'工号'</span><span style=\"color:#24292E\">, dataIndex: </span><span style=\"color:#032F62\">'id'</span><span style=\"color:#24292E\">, width: </span><span style=\"color:#005CC5\">96</span><span style=\"color:#24292E\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  { title: </span><span style=\"color:#032F62\">'姓名'</span><span style=\"color:#24292E\">, dataIndex: </span><span style=\"color:#032F62\">'name'</span><span style=\"color:#24292E\">, width: </span><span style=\"color:#005CC5\">120</span><span style=\"color:#24292E\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  { title: </span><span style=\"color:#032F62\">'部门'</span><span style=\"color:#24292E\">, dataIndex: </span><span style=\"color:#032F62\">'department'</span><span style=\"color:#24292E\">, align: </span><span style=\"color:#032F62\">'center'</span><span style=\"color:#24292E\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  {</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">    title: </span><span style=\"color:#032F62\">'年限'</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">    dataIndex: </span><span style=\"color:#032F62\">'years'</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">    align: </span><span style=\"color:#032F62\">'right'</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">    render</span><span style=\"color:#24292E\">: (</span><span style=\"color:#E36209\">value</span><span style=\"color:#24292E\">) </span><span style=\"color:#D73A49\">=></span><span style=\"color:#24292E\"> &#x3C;</span><span style=\"color:#22863A\">strong</span><span style=\"color:#24292E\">>{</span><span style=\"color:#6F42C1\">String</span><span style=\"color:#24292E\">(value)} 年&#x3C;/</span><span style=\"color:#22863A\">strong</span><span style=\"color:#24292E\">>,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  },</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">];</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">const</span><span style=\"color:#005CC5\"> rows</span><span style=\"color:#D73A49\">:</span><span style=\"color:#6F42C1\"> Row</span><span style=\"color:#24292E\">[] </span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\"> [</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  { id: </span><span style=\"color:#032F62\">'A01'</span><span style=\"color:#24292E\">, name: </span><span style=\"color:#032F62\">'张伟'</span><span style=\"color:#24292E\">, department: </span><span style=\"color:#032F62\">'研发'</span><span style=\"color:#24292E\">, years: </span><span style=\"color:#005CC5\">6</span><span style=\"color:#24292E\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  { id: </span><span style=\"color:#032F62\">'A02'</span><span style=\"color:#24292E\">, name: </span><span style=\"color:#032F62\">'李娜'</span><span style=\"color:#24292E\">, department: </span><span style=\"color:#032F62\">'设计'</span><span style=\"color:#24292E\">, years: </span><span style=\"color:#005CC5\">4</span><span style=\"color:#24292E\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  { id: </span><span style=\"color:#032F62\">'A03'</span><span style=\"color:#24292E\">, name: </span><span style=\"color:#032F62\">'王强'</span><span style=\"color:#24292E\">, department: </span><span style=\"color:#032F62\">'测试'</span><span style=\"color:#24292E\">, years: </span><span style=\"color:#005CC5\">3</span><span style=\"color:#24292E\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  { id: </span><span style=\"color:#032F62\">'A04'</span><span style=\"color:#24292E\">, name: </span><span style=\"color:#032F62\">'赵敏'</span><span style=\"color:#24292E\">, department: </span><span style=\"color:#032F62\">'运维'</span><span style=\"color:#24292E\">, years: </span><span style=\"color:#005CC5\">2</span><span style=\"color:#24292E\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">];</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">export</span><span style=\"color:#D73A49\"> const</span><span style=\"color:#005CC5\"> demo</span><span style=\"color:#D73A49\"> =</span><span style=\"color:#24292E\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  title: </span><span style=\"color:#032F62\">'基础用法'</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  description: </span><span style=\"color:#032F62\">'列配置、数据、行键与自定义渲染；第二张表开启加载态，只落状态属性。'</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">};</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">export</span><span style=\"color:#D73A49\"> default</span><span style=\"color:#D73A49\"> function</span><span style=\"color:#6F42C1\"> BasicDemo</span><span style=\"color:#24292E\">() {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">  return</span><span style=\"color:#24292E\"> (</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">    &#x3C;</span><span style=\"color:#005CC5\">DemoSection</span><span style=\"color:#6F42C1\"> title</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"基础表格\"</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">      &#x3C;</span><span style=\"color:#22863A\">div</span><span style=\"color:#6F42C1\"> class</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"demo-stack\"</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;</span><span style=\"color:#005CC5\">Table</span><span style=\"color:#6F42C1\"> columns</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{columns} </span><span style=\"color:#6F42C1\">data</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{rows} </span><span style=\"color:#6F42C1\">rowKey</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"id\"</span><span style=\"color:#6F42C1\"> aria-label</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"员工基础信息\"</span><span style=\"color:#24292E\"> /></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;</span><span style=\"color:#005CC5\">Table</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">          columns</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{columns}</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">          data</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{rows.</span><span style=\"color:#6F42C1\">slice</span><span style=\"color:#24292E\">(</span><span style=\"color:#005CC5\">0</span><span style=\"color:#24292E\">, </span><span style=\"color:#005CC5\">2</span><span style=\"color:#24292E\">)}</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">          rowKey</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"id\"</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">          loading</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">          aria-label</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"加载中的表格\"</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        /></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">      &#x3C;/</span><span style=\"color:#22863A\">div</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">    &#x3C;/</span><span style=\"color:#005CC5\">DemoSection</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  );</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">}</span></span>\n<span class=\"line\"></span></code></pre>"
