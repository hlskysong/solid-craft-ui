  "source": "import { App, Button, notification, useApp } from 'solid-craft';\nimport { DemoSection } from '../../demos/shared';\n\nexport const demo = {\n  title: '通知卡片',\n  description: '带描述与关闭按钮的卡片，覆盖静态与上下文两条通道。',\n};\n\nfunction NotificationPanel() {\n  const app = useApp();\n\n  return (\n    <DemoSection title=\"通知操作\">\n      <Button\n        onClick={() => {\n          notification.open({\n            content: '发布完成',\n            description: '新版本已部署到预览环境。',\n            kind: 'success',\n            duration: 0,\n          });\n        }}\n      >\n        打开成功通知\n      </Button>\n      <Button\n        onClick={() => {\n          app.notification.error('同步失败，请稍后重试');\n        }}\n      >\n        发送错误通知\n      </Button>\n    </DemoSection>\n  );\n}\n\nexport default function AppNotificationDemo() {\n  return (\n    <App notification={{ placement: 'top-right', duration: 0 }}>\n      <NotificationPanel />\n    </App>\n  );\n}\n",
