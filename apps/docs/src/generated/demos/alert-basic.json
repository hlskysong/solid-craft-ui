49\">:</span><span style=\"color:#005CC5\"> string</span><span style=\"color:#24292E\">; </span><span style=\"color:#E36209\">description</span><span style=\"color:#D73A49\">:</span><span style=\"color:#005CC5\"> string</span><span style=\"color:#24292E\"> }[] </span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\"> [</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  {</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">    kind: </span><span style=\"color:#032F62\">'info'</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">    title: </span><span style=\"color:#032F62\">'填报说明'</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">    description: </span><span style=\"color:#032F62\">'本次采购数量按年度维简计划填写，提交后进入审批流。'</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  },</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  { kind: </span><span style=\"color:#032F62\">'success'</span><span style=\"color:#24292E\">, title: </span><span style=\"color:#032F62\">'保存成功'</span><span style=\"color:#24292E\">, description: </span><span style=\"color:#032F62\">'采购明细已写入草稿，可继续添加设备。'</span><span style=\"color:#24292E\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  {</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">    kind: </span><span style=\"color:#032F62\">'warning'</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">    title: </span><span style=\"color:#032F62\">'金额超出预算'</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">    description: </span><span style=\"color:#032F62\">'本次采购金额高于季度预算，请复核后提交。'</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  },</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  { kind: </span><span style=\"color:#032F62\">'error'</span><span style=\"color:#24292E\">, title: </span><span style=\"color:#032F62\">'提交失败'</span><span style=\"color:#24292E\">, description: </span><span style=\"color:#032F62\">'网络请求未完成，已保留页面内容，请稍后重试。'</span><span style=\"color:#24292E\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">];</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">export</span><span style=\"color:#D73A49\"> default</span><span style=\"color:#D73A49\"> function</span><span style=\"color:#6F42C1\"> AlertBasicDemo</span><span style=\"color:#24292E\">() {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">  return</span><span style=\"color:#24292E\"> (</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">    &#x3C;</span><span style=\"color:#005CC5\">DemoSection</span><span style=\"color:#6F42C1\"> title</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"基础用法\"</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">      &#x3C;</span><span style=\"color:#22863A\">div</span><span style=\"color:#6F42C1\"> class</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"demo-column\"</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        {</span><span style=\"color:#005CC5\">KINDS</span><span style=\"color:#24292E\">.</span><span style=\"color:#6F42C1\">map</span><span style=\"color:#24292E\">((</span><span style=\"color:#E36209\">item</span><span style=\"color:#24292E\">) </span><span style=\"color:#D73A49\">=></span><span style=\"color:#24292E\"> (</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">          &#x3C;</span><span style=\"color:#005CC5\">Alert</span><span style=\"color:#6F42C1\"> kind</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{item.kind} </span><span style=\"color:#6F42C1\">title</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{item.title} </span><span style=\"color:#6F42C1\">description</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{item.description} /></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        ))}</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">      &#x3C;/</span><span style=\"color:#22863A\">div</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">    &#x3C;/</span><span style=\"color:#005CC5\">DemoSection</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  );</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">}</span></span>\n<span class=\"line\"></span></code></pre>"
