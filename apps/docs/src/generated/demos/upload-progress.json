{
  "path": "packages/core/src/components/upload/demos/progress.tsx",
  "source": "import { createSignal, onCleanup } from 'solid-js';\nimport { Upload, type UploadFile, type UploadRequestOptions } from 'solid-craft';\n\nimport { DemoSection } from '../../demos/shared';\n\nexport const demo = {\n  title: 'customRequest 进度 / 取消 / 重试',\n  description:\n    '组件不内置任何传输实现：customRequest 拿到 onProgress / onSuccess / onError 与 AbortSignal，删除或取消时 abort 并清掉定时器。列表初始态直接给出 uploading / done / error 三态静态骨架。',\n};\n\n// 三态静态初始数据：让基线一帧覆盖进度条、完成态与错误态。\nconst initial: UploadFile[] = [\n  {\n    uid: 'progress-1',\n    name: '主通风机参数表.pdf',\n    size: 20480,\n    status: 'uploading',\n    percent: 45,\n  },\n  { uid: 'progress-2', name: '年度计划汇总.pdf', size: 51200, status: 'done', percent: 100 },\n  {\n    uid: 'progress-3',\n    name: '审批附件.pdf',\n    size: 8192,\n    status: 'error',\n    error: '网络中断，可重试',\n  },\n];\n\nexport default function UploadProgressDemo() {\n  const [failNext, setFailNext] = createSignal(false);\n  const [log, setLog] = createSignal('等待上传');\n  const timers = new Set<ReturnType<typeof setInterval>>();\n\n  onCleanup(() => {\n    for (const timer of timers) clearInterval(timer);\n    timers.clear();\n  });\n\n  // 模拟传输：120ms 推进 20%，到 100 后按开关决定成功 / 失败；abort 立即清定时器。\n  const customRequest = (options: UploadRequestOptions): void => {\n    const shouldFail = failNext();\n    let percent = 0;\n    setLog(`开始上传 ${options.file.name}`);\n    const timer = setInterval(() => {\n      if (options.signal.aborted) {\n        clearInterval(timer);\n        timers.delete(timer);\n        return;\n      }\n      percent += 20;\n      options.onProgress(percent);\n      if (percent >= 100) {\n        clearInterval(timer);\n        timers.delete(timer);\n        if (shouldFail) {\n          setLog(`${options.file.name} 模拟失败`);\n          options.onError(new Error('模拟服务端失败'));\n        } else {\n          setLog(`${options.file.name} 上传完成`);\n          options.onSuccess({ url: '/uploads/demo' });\n        }\n      }\n    }, 120);\n    timers.add(timer);\n    options.signal.addEventListener(\n      'abort',\n      () => {\n        clearInterval(timer);\n        timers.delete(timer);\n      },\n      { once: true },\n    );\n  };\n\n  return (\n    <DemoSection title=\"进度与失败重试\">\n      <div class=\"demo-column\">\n        <p>打开「模拟失败」后选一个文件，失败后点「重试」即可重跑同一条链路。</p>\n        <label>\n          <input\n            type=\"checkbox\"\n            data-testid=\"upload-fail-toggle\"\n            checked={failNext()}\n            onChange={(event) => setFailNext(event.currentTarget.checked)}\n          />\n          下一次上传模拟失败\n        </label>\n        <Upload\n          defaultFileList={initial}\n          customRequest={customRequest}\n          aria-label=\"进度演示上传\"\n          data-testid=\"upload-progress\"\n        >\n          选择文件开始模拟上传\n        </Upload>\n        <p data-testid=\"upload-progress-log\">{log()}</p>\n      </div>\n    </DemoSection>\n  );\n}\n",
  "html": "<pre class=\"shiki github-light\" style=\"background-color:#fff;color:#24292e\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49\">import</span><span style=\"color:#24292E\"> { createSignal, onCleanup } </span><span style=\"color:#D73A49\">from</span><span style=\"color:#032F62\"> 'solid-js'</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">import</span><span style=\"color:#24292E\"> { Upload, </span><span style=\"color:#D73A49\">type</span><span style=\"color:#24292E\"> UploadFile, </span><span style=\"color:#D73A49\">type</span><span style=\"color:#24292E\"> UploadRequestOptions } </span><span style=\"color:#D73A49\">from</span><span style=\"color:#032F62\"> 'solid-craft'</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">import</span><span style=\"color:#24292E\"> { DemoSection } </span><span style=\"color:#D73A49\">from</span><span style=\"color:#032F62\"> '../../demos/shared'</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">export</span><span style=\"color:#D73A49\"> const</span><span style=\"color:#005CC5\"> demo</span><span style=\"color:#D73A49\"> =</span><span style=\"color:#24292E\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  title: </span><span style=\"color:#032F62\">'customRequest 进度 / 取消 / 重试'</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  description:</span></span>\n<span class=\"line\"><span style=\"color:#032F62\">    '组件不内置任何传输实现：customRequest 拿到 onProgress / onSuccess / onError 与 AbortSignal，删除或取消时 abort 并清掉定时器。列表初始态直接给出 uploading / done / error 三态静态骨架。'</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">};</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D\">// 三态静态初始数据：让基线一帧覆盖进度条、完成态与错误态。</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">const</span><span style=\"color:#005CC5\"> initial</span><span style=\"color:#D73A49\">:</span><span style=\"color:#6F42C1\"> UploadFile</span><span style=\"color:#24292E\">[] </span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\"> [</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  {</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">    uid: </span><span style=\"color:#032F62\">'progress-1'</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">    name: </span><span style=\"color:#032F62\">'主通风机参数表.pdf'</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">    size: </span><span style=\"color:#005CC5\">20480</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">    status: </span><span style=\"color:#032F62\">'uploading'</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">    percent: </span><span style=\"color:#005CC5\">45</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  },</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  { uid: </span><span style=\"color:#032F62\">'progress-2'</span><span style=\"color:#24292E\">, name: </span><span style=\"color:#032F62\">'年度计划汇总.pdf'</span><span style=\"color:#24292E\">, size: </span><span style=\"color:#005CC5\">51200</span><span style=\"color:#24292E\">, status: </span><span style=\"color:#032F62\">'done'</span><span style=\"color:#24292E\">, percent: </span><span style=\"color:#005CC5\">100</span><span style=\"color:#24292E\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  {</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">    uid: </span><span style=\"color:#032F62\">'progress-3'</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">    name: </span><span style=\"color:#032F62\">'审批附件.pdf'</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">    size: </span><span style=\"color:#005CC5\">8192</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">    status: </span><span style=\"color:#032F62\">'error'</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">    error: </span><span style=\"color:#032F62\">'网络中断，可重试'</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  },</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">];</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">export</span><span style=\"color:#D73A49\"> default</span><span style=\"color:#D73A49\"> function</span><span style=\"color:#6F42C1\"> UploadProgressDemo</span><span style=\"color:#24292E\">() {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">  const</span><span style=\"color:#24292E\"> [</span><span style=\"color:#005CC5\">failNext</span><span style=\"color:#24292E\">, </span><span style=\"color:#005CC5\">setFailNext</span><span style=\"color:#24292E\">] </span><span style=\"color:#D73A49\">=</span><span style=\"color:#6F42C1\"> createSignal</span><span style=\"color:#24292E\">(</span><span style=\"color:#005CC5\">false</span><span style=\"color:#24292E\">);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">  const</span><span style=\"color:#24292E\"> [</span><span style=\"color:#005CC5\">log</span><span style=\"color:#24292E\">, </span><span style=\"color:#005CC5\">setLog</span><span style=\"color:#24292E\">] </span><span style=\"color:#D73A49\">=</span><span style=\"color:#6F42C1\"> createSignal</span><span style=\"color:#24292E\">(</span><span style=\"color:#032F62\">'等待上传'</span><span style=\"color:#24292E\">);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">  const</span><span style=\"color:#005CC5\"> timers</span><span style=\"color:#D73A49\"> =</span><span style=\"color:#D73A49\"> new</span><span style=\"color:#6F42C1\"> Set</span><span style=\"color:#24292E\">&#x3C;</span><span style=\"color:#6F42C1\">ReturnType</span><span style=\"color:#24292E\">&#x3C;</span><span style=\"color:#D73A49\">typeof</span><span style=\"color:#24292E\"> setInterval>>();</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">  onCleanup</span><span style=\"color:#24292E\">(() </span><span style=\"color:#D73A49\">=></span><span style=\"color:#24292E\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">    for</span><span style=\"color:#24292E\"> (</span><span style=\"color:#D73A49\">const</span><span style=\"color:#005CC5\"> timer</span><span style=\"color:#D73A49\"> of</span><span style=\"color:#24292E\"> timers) </span><span style=\"color:#6F42C1\">clearInterval</span><span style=\"color:#24292E\">(timer);</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">    timers.</span><span style=\"color:#6F42C1\">clear</span><span style=\"color:#24292E\">();</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  });</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D\">  // 模拟传输：120ms 推进 20%，到 100 后按开关决定成功 / 失败；abort 立即清定时器。</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">  const</span><span style=\"color:#6F42C1\"> customRequest</span><span style=\"color:#D73A49\"> =</span><span style=\"color:#24292E\"> (</span><span style=\"color:#E36209\">options</span><span style=\"color:#D73A49\">:</span><span style=\"color:#6F42C1\"> UploadRequestOptions</span><span style=\"color:#24292E\">)</span><span style=\"color:#D73A49\">:</span><span style=\"color:#005CC5\"> void</span><span style=\"color:#D73A49\"> =></span><span style=\"color:#24292E\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">    const</span><span style=\"color:#005CC5\"> shouldFail</span><span style=\"color:#D73A49\"> =</span><span style=\"color:#6F42C1\"> failNext</span><span style=\"color:#24292E\">();</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">    let</span><span style=\"color:#24292E\"> percent </span><span style=\"color:#D73A49\">=</span><span style=\"color:#005CC5\"> 0</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">    setLog</span><span style=\"color:#24292E\">(</span><span style=\"color:#032F62\">`开始上传 ${</span><span style=\"color:#24292E\">options</span><span style=\"color:#032F62\">.</span><span style=\"color:#24292E\">file</span><span style=\"color:#032F62\">.</span><span style=\"color:#24292E\">name</span><span style=\"color:#032F62\">}`</span><span style=\"color:#24292E\">);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">    const</span><span style=\"color:#005CC5\"> timer</span><span style=\"color:#D73A49\"> =</span><span style=\"color:#6F42C1\"> setInterval</span><span style=\"color:#24292E\">(() </span><span style=\"color:#D73A49\">=></span><span style=\"color:#24292E\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">      if</span><span style=\"color:#24292E\"> (options.signal.aborted) {</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">        clearInterval</span><span style=\"color:#24292E\">(timer);</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        timers.</span><span style=\"color:#6F42C1\">delete</span><span style=\"color:#24292E\">(timer);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">        return</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">      }</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">      percent </span><span style=\"color:#D73A49\">+=</span><span style=\"color:#005CC5\"> 20</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">      options.</span><span style=\"color:#6F42C1\">onProgress</span><span style=\"color:#24292E\">(percent);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">      if</span><span style=\"color:#24292E\"> (percent </span><span style=\"color:#D73A49\">>=</span><span style=\"color:#005CC5\"> 100</span><span style=\"color:#24292E\">) {</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">        clearInterval</span><span style=\"color:#24292E\">(timer);</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        timers.</span><span style=\"color:#6F42C1\">delete</span><span style=\"color:#24292E\">(timer);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">        if</span><span style=\"color:#24292E\"> (shouldFail) {</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">          setLog</span><span style=\"color:#24292E\">(</span><span style=\"color:#032F62\">`${</span><span style=\"color:#24292E\">options</span><span style=\"color:#032F62\">.</span><span style=\"color:#24292E\">file</span><span style=\"color:#032F62\">.</span><span style=\"color:#24292E\">name</span><span style=\"color:#032F62\">} 模拟失败`</span><span style=\"color:#24292E\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">          options.</span><span style=\"color:#6F42C1\">onError</span><span style=\"color:#24292E\">(</span><span style=\"color:#D73A49\">new</span><span style=\"color:#6F42C1\"> Error</span><span style=\"color:#24292E\">(</span><span style=\"color:#032F62\">'模拟服务端失败'</span><span style=\"color:#24292E\">));</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        } </span><span style=\"color:#D73A49\">else</span><span style=\"color:#24292E\"> {</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">          setLog</span><span style=\"color:#24292E\">(</span><span style=\"color:#032F62\">`${</span><span style=\"color:#24292E\">options</span><span style=\"color:#032F62\">.</span><span style=\"color:#24292E\">file</span><span style=\"color:#032F62\">.</span><span style=\"color:#24292E\">name</span><span style=\"color:#032F62\">} 上传完成`</span><span style=\"color:#24292E\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">          options.</span><span style=\"color:#6F42C1\">onSuccess</span><span style=\"color:#24292E\">({ url: </span><span style=\"color:#032F62\">'/uploads/demo'</span><span style=\"color:#24292E\"> });</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        }</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">      }</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">    }, </span><span style=\"color:#005CC5\">120</span><span style=\"color:#24292E\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">    timers.</span><span style=\"color:#6F42C1\">add</span><span style=\"color:#24292E\">(timer);</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">    options.signal.</span><span style=\"color:#6F42C1\">addEventListener</span><span style=\"color:#24292E\">(</span></span>\n<span class=\"line\"><span style=\"color:#032F62\">      'abort'</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">      () </span><span style=\"color:#D73A49\">=></span><span style=\"color:#24292E\"> {</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">        clearInterval</span><span style=\"color:#24292E\">(timer);</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        timers.</span><span style=\"color:#6F42C1\">delete</span><span style=\"color:#24292E\">(timer);</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">      },</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">      { once: </span><span style=\"color:#005CC5\">true</span><span style=\"color:#24292E\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">    );</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  };</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">  return</span><span style=\"color:#24292E\"> (</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">    &#x3C;</span><span style=\"color:#005CC5\">DemoSection</span><span style=\"color:#6F42C1\"> title</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"进度与失败重试\"</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">      &#x3C;</span><span style=\"color:#22863A\">div</span><span style=\"color:#6F42C1\"> class</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"demo-column\"</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;</span><span style=\"color:#22863A\">p</span><span style=\"color:#24292E\">>打开「模拟失败」后选一个文件，失败后点「重试」即可重跑同一条链路。&#x3C;/</span><span style=\"color:#22863A\">p</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;</span><span style=\"color:#22863A\">label</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">          &#x3C;</span><span style=\"color:#22863A\">input</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">            type</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"checkbox\"</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">            data-testid</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"upload-fail-toggle\"</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">            checked</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{</span><span style=\"color:#6F42C1\">failNext</span><span style=\"color:#24292E\">()}</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">            onChange</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{(</span><span style=\"color:#E36209\">event</span><span style=\"color:#24292E\">) </span><span style=\"color:#D73A49\">=></span><span style=\"color:#6F42C1\"> setFailNext</span><span style=\"color:#24292E\">(event.currentTarget.checked)}</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">          /></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">          下一次上传模拟失败</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;/</span><span style=\"color:#22863A\">label</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;</span><span style=\"color:#005CC5\">Upload</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">          defaultFileList</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{initial}</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">          customRequest</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{customRequest}</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">          aria-label</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"进度演示上传\"</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">          data-testid</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"upload-progress\"</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        ></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">          选择文件开始模拟上传</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;/</span><span style=\"color:#005CC5\">Upload</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;</span><span style=\"color:#22863A\">p</span><span style=\"color:#6F42C1\"> data-testid</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"upload-progress-log\"</span><span style=\"color:#24292E\">>{</span><span style=\"color:#6F42C1\">log</span><span style=\"color:#24292E\">()}&#x3C;/</span><span style=\"color:#22863A\">p</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">      &#x3C;/</span><span style=\"color:#22863A\">div</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">    &#x3C;/</span><span style=\"color:#005CC5\">DemoSection</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  );</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">}</span></span>\n<span class=\"line\"></span></code></pre>"
