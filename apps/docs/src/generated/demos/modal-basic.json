{
  "path": "packages/core/src/components/modal/demos/basic.tsx",
  "source": "import { createSignal } from 'solid-js';\nimport { Button, Modal, type ModalSize } from 'solid-craft';\n\nimport { DemoSection } from '../../demos/shared';\n\nexport const demo = {\n  title: '基础用法',\n  description:\n    '外部按钮受控打开；默认底部是「取消 / 确定」。三档尺寸共用同一套交互，显式 width 可覆盖尺寸档位。',\n};\n\nexport default function ModalBasicDemo() {\n  const [open, setOpen] = createSignal(false);\n  const [size, setSize] = createSignal<ModalSize>('medium');\n  const [customOpen, setCustomOpen] = createSignal(false);\n\n  const openWith = (next: ModalSize) => {\n    setSize(next);\n    setOpen(true);\n  };\n\n  return (\n    <>\n      <DemoSection title=\"三档尺寸\">\n        <div class=\"demo-row\">\n          <Button variant=\"outline\" onClick={() => openWith('small')}>\n            打开 small\n          </Button>\n          <Button variant=\"outline\" onClick={() => openWith('medium')}>\n            打开 medium\n          </Button>\n          <Button variant=\"outline\" onClick={() => openWith('large')}>\n            打开 large\n          </Button>\n        </div>\n        <Modal title=\"新增设备采购计划\" open={open()} size={size()} onOpenChange={setOpen}>\n          <p>按年度维简计划填写本次采购数量与本次采购单价，提交后进入审批流。</p>\n          <p>当前尺寸：{size()}</p>\n        </Modal>\n      </DemoSection>\n\n      <DemoSection title=\"自定义宽度与 footer\">\n        <Button variant=\"outline\" onClick={() => setCustomOpen(true)}>\n          打开纯展示对话框\n        </Button>\n        <Modal\n          title=\"采购明细说明\"\n          open={customOpen()}\n          width=\"60vw\"\n          onOpenChange={setCustomOpen}\n          footer={null}\n        >\n          <p>纯展示场景可以去掉底部按钮，只保留右上角关闭按钮。</p>\n        </Modal>\n      </DemoSection>\n    </>\n  );\n}\n",
  "html": "<pre class=\"shiki github-light\" style=\"background-color:#fff;color:#24292e\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49\">import</span><span style=\"color:#24292E\"> { createSignal } </span><span style=\"color:#D73A49\">from</span><span style=\"color:#032F62\"> 'solid-js'</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">import</span><span style=\"color:#24292E\"> { Button, Modal, </span><span style=\"color:#D73A49\">type</span><span style=\"color:#24292E\"> ModalSize } </span><span style=\"color:#D73A49\">from</span><span style=\"color:#032F62\"> 'solid-craft'</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">import</span><span style=\"color:#24292E\"> { DemoSection } </span><span style=\"color:#D73A49\">from</span><span style=\"color:#032F62\"> '../../demos/shared'</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">export</span><span style=\"color:#D73A49\"> const</span><span style=\"color:#005CC5\"> demo</span><span style=\"color:#D73A49\"> =</span><span style=\"color:#24292E\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  title: </span><span style=\"color:#032F62\">'基础用法'</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  description:</span></span>\n<span class=\"line\"><span style=\"color:#032F62\">    '外部按钮受控打开；默认底部是「取消 / 确定」。三档尺寸共用同一套交互，显式 width 可覆盖尺寸档位。'</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">};</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">export</span><span style=\"color:#D73A49\"> default</span><span style=\"color:#D73A49\"> function</span><span style=\"color:#6F42C1\"> ModalBasicDemo</span><span style=\"color:#24292E\">() {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">  const</span><span style=\"color:#24292E\"> [</span><span style=\"color:#005CC5\">open</span><span style=\"color:#24292E\">, </span><span style=\"color:#005CC5\">setOpen</span><span style=\"color:#24292E\">] </span><span style=\"color:#D73A49\">=</span><span style=\"color:#6F42C1\"> createSignal</span><span style=\"color:#24292E\">(</span><span style=\"color:#005CC5\">false</span><span style=\"color:#24292E\">);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">  const</span><span style=\"color:#24292E\"> [</span><span style=\"color:#005CC5\">size</span><span style=\"color:#24292E\">, </span><span style=\"color:#005CC5\">setSize</span><span style=\"color:#24292E\">] </span><span style=\"color:#D73A49\">=</span><span style=\"color:#6F42C1\"> createSignal</span><span style=\"color:#24292E\">&#x3C;</span><span style=\"color:#6F42C1\">ModalSize</span><span style=\"color:#24292E\">>(</span><span style=\"color:#032F62\">'medium'</span><span style=\"color:#24292E\">);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">  const</span><span style=\"color:#24292E\"> [</span><span style=\"color:#005CC5\">customOpen</span><span style=\"color:#24292E\">, </span><span style=\"color:#005CC5\">setCustomOpen</span><span style=\"color:#24292E\">] </span><span style=\"color:#D73A49\">=</span><span style=\"color:#6F42C1\"> createSignal</span><span style=\"color:#24292E\">(</span><span style=\"color:#005CC5\">false</span><span style=\"color:#24292E\">);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">  const</span><span style=\"color:#6F42C1\"> openWith</span><span style=\"color:#D73A49\"> =</span><span style=\"color:#24292E\"> (</span><span style=\"color:#E36209\">next</span><span style=\"color:#D73A49\">:</span><span style=\"color:#6F42C1\"> ModalSize</span><span style=\"color:#24292E\">) </span><span style=\"color:#D73A49\">=></span><span style=\"color:#24292E\"> {</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">    setSize</span><span style=\"color:#24292E\">(next);</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">    setOpen</span><span style=\"color:#24292E\">(</span><span style=\"color:#005CC5\">true</span><span style=\"color:#24292E\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  };</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">  return</span><span style=\"color:#24292E\"> (</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">    &#x3C;></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">      &#x3C;</span><span style=\"color:#005CC5\">DemoSection</span><span style=\"color:#6F42C1\"> title</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"三档尺寸\"</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;</span><span style=\"color:#22863A\">div</span><span style=\"color:#6F42C1\"> class</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"demo-row\"</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">          &#x3C;</span><span style=\"color:#005CC5\">Button</span><span style=\"color:#6F42C1\"> variant</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"outline\"</span><span style=\"color:#6F42C1\"> onClick</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{() </span><span style=\"color:#D73A49\">=></span><span style=\"color:#6F42C1\"> openWith</span><span style=\"color:#24292E\">(</span><span style=\"color:#032F62\">'small'</span><span style=\"color:#24292E\">)}></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">            打开 small</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">          &#x3C;/</span><span style=\"color:#005CC5\">Button</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">          &#x3C;</span><span style=\"color:#005CC5\">Button</span><span style=\"color:#6F42C1\"> variant</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"outline\"</span><span style=\"color:#6F42C1\"> onClick</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{() </span><span style=\"color:#D73A49\">=></span><span style=\"color:#6F42C1\"> openWith</span><span style=\"color:#24292E\">(</span><span style=\"color:#032F62\">'medium'</span><span style=\"color:#24292E\">)}></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">            打开 medium</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">          &#x3C;/</span><span style=\"color:#005CC5\">Button</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">          &#x3C;</span><span style=\"color:#005CC5\">Button</span><span style=\"color:#6F42C1\"> variant</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"outline\"</span><span style=\"color:#6F42C1\"> onClick</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{() </span><span style=\"color:#D73A49\">=></span><span style=\"color:#6F42C1\"> openWith</span><span style=\"color:#24292E\">(</span><span style=\"color:#032F62\">'large'</span><span style=\"color:#24292E\">)}></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">            打开 large</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">          &#x3C;/</span><span style=\"color:#005CC5\">Button</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;/</span><span style=\"color:#22863A\">div</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;</s