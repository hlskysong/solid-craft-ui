{
  "path": "packages/core/src/components/form/demos/real-form.tsx",
  "source": "import { createSignal } from 'solid-js';\nimport {\n  Button,\n  Checkbox,\n  CheckboxGroup,\n  Form,\n  Input,\n  InputNumber,\n  RadioGroup,\n  Select,\n  Switch,\n  Textarea,\n  useForm,\n  type FormValues,\n} from 'solid-craft';\nimport { DemoSection } from '../../demos/shared';\n\nexport const demo = {\n  title: '真实表单页（新增 / 编辑）',\n  description:\n    '八字段覆盖 Input / Textarea / InputNumber / Checkbox / Radio / Switch / Select 七类控件，共用一条 useForm 实例；可载入既有记录编辑、切回新增、提交校验并回显全量快照。',\n};\n\nconst CITY_OPTIONS = [\n  { value: 'sjz', label: '石家庄' },\n  { value: 'hd', label: '邯郸' },\n  { value: 'xt', label: '邢台' },\n];\n\nconst SKILL_OPTIONS = [\n  { value: 'solid', label: 'SolidJS' },\n  { value: 'a11y', label: '无障碍' },\n  { value: 'docs', label: '文档' },\n];\n\nconst LEVEL_OPTIONS = [\n  { value: 'junior', label: '初级' },\n  { value: 'senior', label: '高级' },\n  { value: 'lead', label: '负责人' },\n];\n\n/** 新增模式的空白底稿：既是 useForm 初值，也是 resetFields 的回落目标。 */\nconst EMPTY_VALUES: FormValues = {\n  name: '',\n  city: '',\n  age: null,\n  bio: '',\n  skills: [],\n  level: '',\n  enabled: false,\n  agree: false,\n};\n\n/** 编辑模式的既有记录：由 setFieldsValue 一次灌进同一条实例。 */\nconst EDIT_VALUES: FormValues = {\n  name: '张三',\n  city: 'hd',\n  age: 32,\n  bio: '负责设备维检计划的前端开发。',\n  skills: ['solid', 'a11y'],\n  level: 'senior',\n  enabled: true,\n  agree: true,\n};\n\nexport default function RealFormDemo() {\n  // T2-09 的核心：Demo 与字段值都用一条实例，控件不各自持有 value / onChange，\n  // 全部由 <Form.Item> 的 FieldProvider 接管（T2-03~T2-07 一行未改）。\n  const [form] = useForm<FormValues>(EMPTY_VALUES);\n  const [mode, setMode] = createSignal<'create' | 'edit'>('create');\n  const [result, setResult] = createSignal('尚未提交');\n\n  const loadEdit = () => {\n    form.setFieldsValue(EDIT_VALUES);\n    setMode('edit');\n    setResult('尚未提交');\n  };\n\n  const backToCreate = () => {\n    form.resetFields();\n    setMode('create');\n    setResult('尚未提交');\n  };\n\n  return (\n    <DemoSection title=\"员工档案：新增与编辑\">\n      <div class=\"demo-row\" data-testid=\"real-form-toolbar\">\n        <Button variant=\"outline\" color=\"neutral\" data-testid=\"real-form-edit\" onClick={loadEdit}>\n          载入编辑数据\n        </Button>\n        <Button\n          variant=\"outline\"\n          color=\"neutral\"\n          data-testid=\"real-form-create\"\n          onClick={backToCreate}\n        >\n          切回新增\n        </Button>\n        <span>\n          当前模式：\n          <output data-testid=\"real-form-mode\">{mode() === 'edit' ? '编辑' : '新增'}</output>\n        </span>\n      </div>\n\n      <Form\n        form={form}\n        aria-label=\"员工档案\"\n        onFinish={(values) => setResult(`通过 ${JSON.stringify(values)}`)}\n        onFinishFailed={(errors) => setResult(`失败 ${JSON.stringify(errors)}`)}\n      >\n        <Form.Item name=\"name\" label=\"姓名\" rules={[{ required: true, message: '请输入姓名' }]}>\n          <Input placeholder=\"请输入姓名\" data-testid=\"real-form-name\" />\n        </Form.Item>\n        <Form.Item\n          name=\"city\"\n          label=\"工作城市\"\n          rules={[{ required: true, message: '请选择工作城市' }]}\n        >\n          <Select options={CITY_OPTIONS} searchable clearable placeholder=\"请选择城市\" />\n        </Form.Item>\n        <Form.Item name=\"age\" label=\"年龄\" rules={[{ min: 18, message: '年龄不得低于 18 岁' }]}>\n          <InputNumber min={18} max={65} step={1} />\n        </Form.Item>\n        <Form.Item name=\"bio\" label=\"简介\">\n          <Textarea autoSize showCount maxLength={120} placeholder=\"请填写简介\" />\n        </Form.Item>\n        <Form.Item\n          name=\"skills\"\n          label=\"技能标签\"\n          rules={[{ required: true, message: '请至少选择一项技能' }]}\n        >\n          <CheckboxGroup options={SKILL_OPTIONS} />\n        </Form.Item>\n        <Form.Item name=\"level\" label=\"职级\">\n          <RadioGroup options={LEVEL_OPTIONS} />\n        </Form.Item>\n        <Form.Item name=\"enabled\" label=\"启用账号\">\n          <Switch />\n        </Form.Item>\n        <Form.Item\n          name=\"agree\"\n          label=\"同意条款\"\n          rules={[{ validator: (value) => (value === true ? undefined : '请先同意条款') }]}\n        >\n          <Checkbox>我已阅读并同意</Checkbox>\n        </Form.Item>\n        <Button htmlType=\"submit\" data-testid=\"real-form-submit\">\n          提交\n        </Button>\n      </Form>\n\n      <span>\n        提交结果：<output data-testid=\"real-form-result\">{result()}</output>\n      </span>\n    </DemoSection>\n  );\n}\n",
  "html": "<pre class=\"shiki github-light\" style=\"background-color:#fff;color:#24292e\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49\">import</span><span style=\"color:#24292E\"> { createSignal } </span><span style=\"color:#D73A49\">from</span><span style=\"color:#032F62\"> 'solid-js'</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">import</span><span style=\"color:#24292E\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  Button,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  Checkbox,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  CheckboxGroup,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  Form,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  Input,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  InputNumber,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  RadioGroup,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  Select,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  Switch,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  Textarea,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  useForm,</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">  type</span><span style=\"color:#24292E\"> FormValues,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">} </span><span style=\"color:#D73A49\">from</span><span style=\"color:#032F62\"> 'solid-craft'</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">import</span><span style=\"color:#24292E\"> { DemoSection } </span><span style=\"color:#D73A49\">from</span><span style=\"color:#032F62\"> '../../demos/shared'</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">export</span><span style=\"color:#D73A49\"> const</span><span style=\"color:#005CC5\"> demo</span><span style=\"color:#D73A49\"> =</span><span style=\"color:#24292E\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  title: </span><span style=\"color:#032F62\">'真实表单页（新增 / 编辑）'</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  description:</span></span>\n<span class=\"line\"><span style=\"color:#032F62\">    '八字段覆盖 Input / Textarea / InputNumber / Checkbox / Radio / Switch / Select 七类控件，共用一条 useForm 实例；可载入既有记录编辑、切回新增、提交校验并回显全量快照。'</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">};</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">const</span><span style=\"color:#005CC5\"> CITY_OPTIONS</span><span style=\"color:#D73A49\"> =</span><span style=\"color:#24292E\"> [</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  { value: </span><span style=\"color:#032F62\">'sjz'</span><span style=\"color:#24292E\">, label: </span><span style=\"color:#032F62\">'石家庄'</span><span style=\"color:#24292E\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  { value: </span><span style=\"color:#032F62\">'hd'</span><span style=\"color:#24292E\">, label: </span><span style=\"color:#032F62\">'邯郸'</span><span style=\"color:#24292E\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  { value: </span><span style=\"color:#032F62\">'xt'</span><span style=\"color:#24292E\">, label: </span><span style=\"color:#032F62\">'邢台'</span><span style=\"color:#24292E\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">];</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">const</span><span style=\"color:#005CC5\"> SKILL_OPTIONS</span><span style=\"color:#D73A49\"> =</span><span style=\"color:#24292E\"> [</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  { value: </span><span style=\"color:#032F62\">'solid'</span><span style=\"color:#24292E\">, label: </span><span style=\"color:#032F62\">'SolidJS'</span><span style=\"color:#24292E\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  { value: </span><span style=\"color:#032F62\">'a11y'</span><span style=\"color:#24292E\">, label: </span><span style=\"color:#032F62\">'无障碍'</span><span style=\"color:#24292E\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  { value: </span><span style=\"color:#032F62\">'docs'</span><span style=\"color:#24292E\">, label: </span><span style=\"color:#032F62\">'文档'</span><span style=\"color:#24292E\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">];</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">const</span><span style=\"color:#005CC5\"> LEVEL_OPTIONS</span><span style=\"color:#D73A49\"> =</span><span style=\"color:#24292E\"> [</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  { value: </span><span style=\"color:#032F62\">'junior'</span><span style=\"color:#24292E\">, label: </span><span style=\"color:#032F62\">'初级'</span><span style=\"color:#24292E\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  { value: </span><span style=\"color:#032F62\">'senior'</span><span style=\"color:#24292E\">, label: </span><span style=\"color:#032F62\">'高级'</span><span style=\"color:#24292E\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  { value: </span><span style=\"color:#032F62\">'lead'</span><span style=\"color:#24292E\">, label: </span><span style=\"color:#032F62\">'负责人'</span><span style=\"color:#24292E\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">];</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D\">/** 新增模式的空白底稿：既是 useForm 初值，也是 resetFields 的回落目标。 */</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">const</span><span style=\"color:#005CC5\"> EMPTY_VALUES</span><span style=\"color:#D73A49\">:</span><span style=\"color:#6F42C1\"> FormValues</span><span style=\"color:#D73A49\"> =</span><span style=\"color:#24292E\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  name: </span><span style=\"color:#032F62\">''</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  city: </span><span style=\"color:#032F62\">''</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  age: </span><span style=\"color:#005CC5\">null</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  bio: </span><span style=\"color:#032F62\">''</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  skills: [],</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  level: </span><span style=\"color:#032F62\">''</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  enabled: </span><span style=\"color:#005CC5\">false</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  agree: </span><span style=\"color:#005CC5\">false</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">};</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D\">/** 编辑模式的既有记录：由 setFieldsValue 一次灌进同一条实例。 */</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">const</span><span style=\"color:#005CC5\"> EDIT_VALUES</span><span style=\"color:#D73A49\">:</span><span style=\"color:#6F42C1\"> FormValues</span><span style=\"color:#D73A49\"> =</span><span style=\"color:#24292E\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  name: </span><span style=\"color:#032F62\">'张三'</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  city: </span><span style=\"color:#032F62\">'hd'</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  age: </span><span style=\"color:#005CC5\">32</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  bio: </span><span style=\"color:#032F62\">'负责设备维检计划的前端开发。'</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  skills: [</span><span style=\"color:#032F62\">'solid'</span><span style=\"color:#24292E\">, </span><span style=\"color:#032F62\">'a11y'</span><span style=\"color:#24292E\">],</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  level: </span><span style=\"color:#032F62\">'senior'</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  enabled: </span><span style=\"color:#005CC5\">true</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  agree: </span><span style=\"color:#005CC5\">true</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">};</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">export</span><span style=\"color:#D73A49\"> default</span><span style=\"color:#D73A49\"> function</span><span style=\"color:#6F42C1\"> RealFormDemo</span><span style=\"color:#24292E\">() {</span></span>\n<span class=\"line\"><span style=\"color:#6A737D\">  // T2-09 的核心：Demo 与字段值都用一条实例，控件不各自持有 value / onChange，</span></span>\n<span class=\"line\"><span style=\"color:#6A737D\">  // 全部由 &#x3C;Form.Item> 的 FieldProvider 接管（T2-03~T2-07 一行未改）。</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">  const</span><span style=\"color:#24292E\"> [</span><span style=\"color:#005CC5\">form</span><span style=\"color:#24292E\">] </span><span style=\"color:#D73A49\">=</span><span style=\"color:#6F42C1\"> useForm</span><span style=\"color:#24292E\">&#x3C;</span><span style=\"color:#6F42C1\">FormValues</span><span style=\"color:#24292E\">>(</span><span style=\"color:#005CC5\">EMPTY_VALUES</span><span style=\"color:#24292E\">);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">  const</span><span style=\"color:#24292E\"> [</span><span style=\"color:#005CC5\">mode</span><span style=\"color:#24292E\">, </span><span style=\"color:#005CC5\">setMode</span><span style=\"color:#24292E\">] </span><span style=\"color:#D73A49\">=</span><span style=\"color:#6F42C1\"> createSignal</span><span style=\"color:#24292E\">&#x3C;</span><span style=\"color:#032F62\">'create'</span><span style=\"color:#D73A49\"> |</span><span style=\"color:#032F62\"> 'edit'</span><span style=\"color:#24292E\">>(</span><span style=\"color:#032F62\">'create'</span><span style=\"color:#24292E\">);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">  const</span><span style=\"color:#24292E\"> [</span><span style=\"color:#005CC5\">result</span><span style=\"color:#24292E\">, </span><span style=\"color:#005CC5\">setResult</span><span style=\"color:#24292E\">] </span><span style=\"color:#D73A49\">=</span><span style=\"color:#6F42C1\"> createSignal</span><span style=\"color:#24292E\">(</span><span style=\"color:#032F62\">'尚未提交'</span><span style=\"color:#24292E\">);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">  const</span><span style=\"color:#6F42C1\"> loadEdit</span><span style=\"color:#D73A49\"> =</span><span style=\"color:#24292E\"> () </span><span style=\"color:#D73A49\">=></span><span style=\"color:#24292E\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">    form.</span><span style=\"color:#6F42C1\">setFieldsValue</span><span style=\"color:#24292E\">(<