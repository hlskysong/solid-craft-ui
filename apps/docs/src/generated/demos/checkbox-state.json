or:#032F62\">'reading'</span><span style=\"color:#24292E\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  { label: </span><span style=\"color:#032F62\">'音乐'</span><span style=\"color:#24292E\">, value: </span><span style=\"color:#032F62\">'music'</span><span style=\"color:#24292E\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  { label: </span><span style=\"color:#032F62\">'运动'</span><span style=\"color:#24292E\">, value: </span><span style=\"color:#032F62\">'sports'</span><span style=\"color:#24292E\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">];</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">export</span><span style=\"color:#D73A49\"> default</span><span style=\"color:#D73A49\"> function</span><span style=\"color:#6F42C1\"> CheckboxStateDemo</span><span style=\"color:#24292E\">() {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">  const</span><span style=\"color:#24292E\"> [</span><span style=\"color:#005CC5\">agreed</span><span style=\"color:#24292E\">, </span><span style=\"color:#005CC5\">setAgreed</span><span style=\"color:#24292E\">] </span><span style=\"color:#D73A49\">=</span><span style=\"color:#6F42C1\"> createSignal</span><span style=\"color:#24292E\">(</span><span style=\"color:#005CC5\">false</span><span style=\"color:#24292E\">);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">  const</span><span style=\"color:#24292E\"> [</span><span style=\"color:#005CC5\">hobbies</span><span style=\"color:#24292E\">, </span><span style=\"color:#005CC5\">setHobbies</span><span style=\"color:#24292E\">] </span><span style=\"color:#D73A49\">=</span><span style=\"color:#6F42C1\"> createSignal</span><span style=\"color:#24292E\">&#x3C;</span><span style=\"color:#005CC5\">string</span><span style=\"color:#24292E\">[]>([</span><span style=\"color:#032F62\">'reading'</span><span style=\"color:#24292E\">]);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">  return</span><span style=\"color:#24292E\"> (</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">    &#x3C;></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">      &#x3C;</span><span style=\"color:#005CC5\">DemoSection</span><span style=\"color:#6F42C1\"> title</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"受控值\"</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;</span><span style=\"color:#005CC5\">Checkbox</span><span style=\"color:#6F42C1\"> checked</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{</span><span style=\"color:#6F42C1\">agreed</span><span style=\"color:#24292E\">()} </span><span style=\"color:#6F42C1\">onChange</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{(</span><span style=\"color:#E36209\">checked</span><span style=\"color:#24292E\">) </span><span style=\"color:#D73A49\">=></span><span style=\"color:#6F42C1\"> setAgreed</span><span style=\"color:#24292E\">(checked)}></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">          我已阅读并同意用户协议</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;/</span><span style=\"color:#005CC5\">Checkbox</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;</span><span style=\"color:#22863A\">span</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">          当前状态：&#x3C;</span><span style=\"color:#22863A\">output</span><span style=\"color:#24292E\">>{</span><span style=\"color:#6F42C1\">agreed</span><span style=\"color:#24292E\">() </span><span style=\"color:#D73A49\">?</span><span style=\"color:#032F62\"> '已同意'</span><span style=\"color:#D73A49\"> :</span><span style=\"color:#032F62\"> '未同意'</span><span style=\"color:#24292E\">}&#x3C;/</span><span style=\"color:#22863A\">output</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;/</span><span style=\"color:#22863A\">span</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">      &#x3C;/</span><span style=\"color:#005CC5\">DemoSection</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E\">      &#x3C;</span><span style=\"color:#005CC5\">DemoSection</span><span style=\"color:#6F42C1\"> title</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"垂直排列\"</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;</span><span style=\"color:#005CC5\">CheckboxGroup</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">          aria-label</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"兴趣爱好\"</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">          orientation</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"vertical\"</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">          options</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{</span><span style=\"color:#005CC5\">HOBBY_OPTIONS</span><span style=\"color:#24292E\">}</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">          value</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{</span><span style=\"color:#6F42C1\">hobbies</span><span style=\"color:#24292E\">()}</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">          onChange</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{(</span><span style=\"color:#E36209\">values</span><span style=\"color:#24292E\">) </span><span style=\"color:#D73A49\">=></span><span style=\"color:#6F42C1\"> setHobbies</span><span style=\"color:#24292E\">(values)}</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        /></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;</span><span style=\"color:#22863A\">span</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">          已选：&#x3C;</span><span style=\"color:#22863A\">output</span><span style=\"color:#24292E\">>{</span><span style=\"color:#6F42C1\">hobbies</span><span style=\"color:#24292E\">().</span><span style=\"color:#005CC5\">length</span><span style=\"color:#D73A49\"> ></span><span style=\"color:#005CC5\"> 0</span><span style=\"color:#D73A49\"> ?</span><span style=\"color:#6F42C1\"> hobbies</span><span style=\"color:#24292E\">().</span><span style=\"color:#6F42C1\">join</span><span style=\"color:#24292E\">(</span><span style=\"color:#032F62\">'、'</span><span style=\"color:#24292E\">) </span><span style=\"color:#D73A49\">:</span><span style=\"color:#032F62\"> '（无）'</span><span style=\"color:#24292E\">}&#x3C;/</span><span style=\"color:#22863A\">output</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;/</span><span style=\"color:#22863A\">span</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">      &#x3C;/</span><span style=\"color:#005CC5\">DemoSection</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">    &#x3C;/></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  );</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">}</span></span>\n<span class=\"line\"></span></code></pre>"
