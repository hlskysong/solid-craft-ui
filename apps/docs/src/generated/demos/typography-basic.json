span style=\"color:#24292E\">    &#x3C;></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">      &#x3C;</span><span style=\"color:#005CC5\">DemoSection</span><span style=\"color:#6F42C1\"> title</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"标题层级\"</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;</span><span style=\"color:#005CC5\">For</span><span style=\"color:#6F42C1\"> each</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{</span><span style=\"color:#005CC5\">LEVELS</span><span style=\"color:#24292E\">}>{(</span><span style=\"color:#E36209\">level</span><span style=\"color:#24292E\">) </span><span style=\"color:#D73A49\">=></span><span style=\"color:#24292E\"> &#x3C;</span><span style=\"color:#005CC5\">Title</span><span style=\"color:#6F42C1\"> level</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{level}>{</span><span style=\"color:#032F62\">`H${</span><span style=\"color:#24292E\">level</span><span style=\"color:#032F62\">} 标题`</span><span style=\"color:#24292E\">}&#x3C;/</span><span style=\"color:#005CC5\">Title</span><span style=\"color:#24292E\">>}&#x3C;/</span><span style=\"color:#005CC5\">For</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">      &#x3C;/</span><span style=\"color:#005CC5\">DemoSection</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">      &#x3C;</span><span style=\"color:#005CC5\">DemoSection</span><span style=\"color:#6F42C1\"> title</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"文本修饰\"</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;</span><span style=\"color:#005CC5\">Text</span><span style=\"color:#6F42C1\"> bold</span><span style=\"color:#24292E\">>bold&#x3C;/</span>