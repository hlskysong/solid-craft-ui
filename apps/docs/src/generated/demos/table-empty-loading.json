{
  "path": "packages/core/src/components/table/demos/empty-loading.tsx",
  "source": "import { createSignal } from 'solid-js';\nimport { Button, Table } from 'solid-craft';\nimport type { TableColumn } from 'solid-craft';\nimport { DemoSection } from '../../demos/shared';\n\ninterface Row {\n  id: string;\n  name: string;\n  department: string;\n}\n\nconst columns: TableColumn<Row>[] = [\n  { title: '工号', dataIndex: 'id', width: 96 },\n  { title: '姓名', dataIndex: 'name', width: 120 },\n  { title: '部门', dataIndex: 'department' },\n];\n\nconst rows: Row[] = [\n  { id: 'A01', name: '张伟', department: '研发' },\n  { id: 'A02', name: '李娜', department: '设计' },\n  { id: 'A03', name: '王强', department: '测试' },\n];\n\ntype ViewState = 'empty' | 'loading' | 'ready';\n\nexport const demo = {\n  title: '空态与加载态',\n  description:\n    '空数据复用 Empty 占位，加载中复用 Spin 遮罩且分页禁用；两者互斥，切换时表头与列宽不变，不产生布局抖动。',\n};\n\nexport default function EmptyLoadingDemo() {\n  const [view, setView] = createSignal<ViewState>('empty');\n\n  return (\n    <DemoSection title=\"空态与加载态\">\n      <div class=\"demo-stack\">\n        <div class=\"demo-row\">\n          <Button data-testid=\"state-empty\" onClick={() => setView('empty')}>\n            空数据\n          </Button>\n          <Button data-testid=\"state-loading\" onClick={() => setView('loading')}>\n            加载中\n          </Button>\n          <Button data-testid=\"state-ready\" onClick={() => setView('ready')}>\n            有数据\n          </Button>\n        </div>\n        <Table\n          columns={columns}\n          data={view() === 'ready' ? rows : []}\n          rowKey=\"id\"\n          loading={view() === 'loading'}\n          pagination={{ pageSize: 5 }}\n          aria-label=\"空态与加载态表格\"\n        />\n      </div>\n    </DemoSection>\n  );\n}\n",
  "html": "<pre class=\"shiki github-light\" style=\"background-color:#fff;color:#24292e\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49\">import</span><span style=\"color:#24292E\"> { createSignal } </span><span style=\"color:#D73A49\">from</span><span style=\"color:#032F62\"> 'solid-js'</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">import</span><span style=\"color:#24292E\"> { Button, Table } </span><span style=\"color:#D73A49\">from</span><span style=\"color:#032F62\"> 'solid-craft'</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">import</span><span style=\"color:#D73A49\"> type</span><span style=\"color:#24292E\"> { TableColumn } </span><span style=\"color:#D73A49\">from</span><span style=\"color:#032F62\"> 'solid-craft'</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">import</span><span style=\"color:#24292E\"> { DemoSection } </span><span style=\"color:#D73A49\">from</span><span style=\"color:#032F62\"> '../../demos/shared'</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">interface</span><span style=\"color:#6F42C1\"> Row</span><span style=\"color:#24292E\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209\">  id</span><span style=\"color:#D73A49\">:</span><span style=\"color:#005CC5\"> string</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209\">  name</span><span style=\"color:#D73A49\">:</span><span style=\"color:#005CC5\"> string</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209\">  department</span><span style=\"color:#D73A49\">:</span><span style=\"color:#005CC5\"> string</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">const</span><span style=\"color:#005CC5\"> columns</span><span style=\"color:#D73A49\">:</span><span style=\"color:#6F42C1\"> TableColumn</span><span style=\"color:#24292E\">&#x3C;</span><span style=\"color:#6F42C1\">Row</span><span style=\"color:#24292E\">>[] </span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\"> [</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  { title: </span><span style=\"color:#032F62\">'工号'</span><span style=\"color:#24292E\">, dataIndex: </span><span style=\"color:#032F62\">'id'</span><span style=\"color:#24292E\">, width: </span><span style=\"color:#005CC5\">96</span><span style=\"color:#24292E\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  { title: </span><span style=\"color:#032F62\">'姓名'</span><span style=\"color:#24292E\">, dataIndex: </span><span style=\"color:#032F62\">'name'</span><span style=\"color:#24292E\">, width: </span><span style=\"color:#005CC5\">120</span><span style=\"color:#24292E\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  { title: </span><span style=\"color:#032F62\">'部门'</span><span style=\"color:#24292E\">, dataIndex: </span><span style=\"color:#032F62\">'department'</span><span style=\"color:#24292E\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">];</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">const</span><span style=\"color:#005CC5\"> rows</span><span style=\"color:#D73A49\">:</span><span style=\"color:#6F42C1\"> Row</span><span style=\"color:#24292E\">[] </span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\"> [</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  { id: </span><span style=\"color:#032F62\">'A01'</span><span style=\"color:#24292E\">, name: </span><span style=\"color:#032F62\">'张伟'</span><span style=\"color:#24292E\">, department: </span><span style=\"color:#032F62\">'研发'</span><span style=\"color:#24292E\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  { id: </span><span style=\"color:#032F62\">'A02'</span><span style=\"color:#24292E\">, name: </span><span style=\"color:#032F62\">'李娜'</span><span style=\"color:#24292E\">, department: </span><span style=\"color:#032F62\">'设计'</span><span style=\"color:#24292E\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  { id: </span><span style=\"color:#032F62\">'A03'</span><span style=\"color:#24292E\">, name: </span><span style=\"color:#032F62\">'王强'</span><span style=\"color:#24292E\">, department: </span><span style=\"color:#032F62\">'测试'</span><span style=\"color:#24292E\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">];</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">type</span><span style=\"color:#6F42C1\"> ViewState</span><span style=\"color:#D73A49\"> =</span><span style=\"color:#032F62\"> 'empty'</span><span style=\"color:#D73A49\"> |</span><span style=\"color:#032F62\"> 'loading'</span><span style=\"color:#D73A49\"> |</span><span style=\"color:#032F62\"> 'ready'</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">export</span><span style=\"color:#D73A49\"> const</span><span style=\"color:#005CC5\"> demo</span><span style=\"color:#D73A49\"> =</span><span style=\"color:#24292E\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  title: </span><span style=\"color:#032F62\">'空态与加载态'</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  description:</span></span>\n<span class=\"line\"><span style=\"color:#032F62\">    '空数据复用 Empty 占位，加载中复用 Spin 遮罩且分页禁用；两者互斥，切换时表头与列宽不变，不产生布局抖动。'</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">};</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">export</span><span style=\"color:#D73A49\"> default</span><span style=\"color:#D73A49\"> function</span><span style=\"color:#6F42C1\"> EmptyLoadingDemo</span><span style=\"color:#24292E\">() {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">  const</span><span style=\"color:#24292E\"> [</span><span style=\"color:#005CC5\">view</span><span style=\"color:#24292E\">, </span><span style=\"color:#005CC5\">setView</span><span style=\"color:#24292E\">] </span><span style=\"color:#D73A49\">=</span><span style=\"color:#6F42C1\"> createSignal</span><span style=\"color:#24292E\">&#x3C;</span><span style=\"color:#6F42C1\">ViewState</span><span style=\"color:#24292E\">>(</span><span style=\"color:#032F62\">'empty'</span><span style=\"color:#24292E\">);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">  return</span><span style=\"color:#24292E\"> (</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">    &#x3C;</span><span style=\"color:#005CC5\">DemoSection</span><span style=\"color:#6F42C1\"> title</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"空态与加载态\"</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">      &#x3C;</span><span style=\"color:#22863A\">div</span><span style=\"color:#6F42C1\"> class</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"demo-stack\"</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;</span><span style=\"color:#22863A\">div</span><span style=\"color:#6F42C1\"> class</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"demo-row\"</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">          &#x