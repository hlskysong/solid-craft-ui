  "source": "import { createSignal } from 'solid-js';\nimport { Table } from 'solid-craft';\nimport type { TableChange, TableColumn } from 'solid-craft';\nimport { DemoSection } from '../../demos/shared';\n\ninterface Row {\n  id: string;\n  name: string;\n  department: string;\n  years: number;\n}\n\nconst columns: TableColumn<Row>[] = [\n  { title: '工号', dataIndex: 'id', width: 96 },\n  { title: '姓名', dataIndex: 'name', width: 120 },\n  { title: '部门', dataIndex: 'department', sorter: true },\n  { title: '年限', dataIndex: 'years', align: 'right' },\n];\n\nconst rows: Row[] = [\n  { id: 'A01', name: '张伟', department: '研发', years: 6 },\n  { id: 'A02', name: '李娜', department: '设计', years: 4 },\n  { id: 'A03', name: '王强', department: '测试', years: 3 },\n  { id: 'A04', name: '赵敏', department: '运维', years: 2 },\n  { id: 'A05', name: '陈静', department: '研发', years: 8 },\n  { id: 'A06', name: '刘洋', department: '设计', years: 5 },\n  { id: 'A07', name: '杨帆', department: '测试', years: 2 },\n  { id: 'A08', name: '周敏', department: '运维', years: 7 },\n  { id: 'A09', name: '吴磊', department: '研发', years: 3 },\n  { id: 'A10', name: '徐丽', department: '设计', years: 6 },\n  { id: 'A11', name: '孙浩', department: '测试', years: 4 },\n  { id: 'A12', name: '马超', department: '运维', years: 9 },\n];\n\nexport const demo = {\n  title: '客户端分页',\n  description:\n    '数据全在前端时，Table 自己按筛选与排序后的结果切页，total 恒等于结果行数；翻页、排序、筛选共用 onChange 一个三参出口。',\n};\n\nexport default function PaginationClientDemo() {\n  const [lastChange, setLastChange] = createSignal('尚未变更');\n\n  const onChange = (change: TableChange): void => {\n    const paging = change.pagination;\n    const sorter = change.sorter.map((item) => `${item.columnKey} ${item.direction}`).join('、');\n    setLastChange(\n      paging === undefined\n        ? '未启用分页'\n        : `第 ${paging.current} 页 / 每页 ${paging.pageSize} 条 / 共 ${paging.total} 条；排序：${sorter || '无'}`,\n    );\n  };\n\n  return (\n    <DemoSection title=\"客户端分页\">\n      <div class=\"demo-stack\">\n        <Table\n          columns={columns}\n          data={rows}\n          rowKey=\"id\"\n          pagination={{\n            defaultPageSize: 5,\n            pageSizeOptions: [5, 10, 20],\n            showSizeChanger: true,\n            showQuickJumper: true,\n            showTotal: (total, range) => (\n              <span>\n                共 {total} 条，当前 {range[0]}–{range[1]} 条\n              </span>\n            ),\n          }}\n          onChange={onChange}\n          aria-label=\"客户端分页表格\"\n        />\n        <span>\n          最近一次变更：<output>{lastChange()}</output>\n        </span>\n      </div>\n    </DemoSection>\n  );\n}\n",
  "html": "<pre class=\"shiki github-light\" style=\"background-color:#fff;color:#24292e\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49\">import</span><span style=\"color:#24292E\"> { createSignal } </span><span style=\"color:#D73A49\">from</span><span style=\"color:#032F62\"> 'solid-js'</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">import</span><span style=\"color:#24292E\"> { Table } </span><span style=\"color:#D73A49\">from</span><span style=\"color:#032F62\"> 'solid-craft'</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">import</span><span style=\"color:#D73A49\"> type</span><span style=\"color:#24292E\"> { TableChange, TableColumn } </span><span style=\"color:#D73A49\">from</span><span style=\"color:#032F62\"> 'solid-craft'</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">import</span><span style=\"color:#24292E\"> { DemoSection } </span><span style=\"color:#D73A49\">from</span><span style=\"color:#032F62\"> '../../demos/shared'</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">interface</span><span style=\"color:#6F42C1\"> Row</span><span style=\"color:#24292E\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209\">  id</span><span style=\"color:#D73A49\">:</span><span style=\"color:#005CC5\"> string</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209\">  name</span><span style=\"color:#D73A49\">:</span><span style=\"color:#005CC5\"> string</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209\">  department</span><span style=\"color:#D73A49\">:</span><span style=\"color:#005CC5\"> string</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"><span style=\"co