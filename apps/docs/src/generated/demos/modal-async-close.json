{
  "path": "packages/core/src/components/modal/demos/async-close.tsx",
  "source": "import { createSignal } from 'solid-js';\nimport { Button, Modal } from 'solid-craft';\n\nimport { DemoSection } from '../../demos/shared';\n\nexport const demo = {\n  title: '异步关闭',\n  description:\n    'onOk 返回 Promise 时进入等待态：确认按钮转圈、取消与右上关闭禁用、ESC 与遮罩点击被拦截，重复点击不会再发一次请求。',\n};\n\n/** 模拟一次 900ms 的提交请求；真实业务里换成接口调用即可。 */\nfunction submit(): Promise<void> {\n  return new Promise((resolve) => {\n    window.setTimeout(resolve, 900);\n  });\n}\n\nexport default function ModalAsyncCloseDemo() {\n  const [open, setOpen] = createSignal(false);\n  const [submits, setSubmits] = createSignal(0);\n  const [log, setLog] = createSignal('尚未提交');\n\n  const onOk = (): Promise<void> => {\n    setSubmits((count) => count + 1);\n    setLog('提交中…');\n    return submit().then(() => {\n      setLog('提交完成');\n    });\n  };\n\n  return (\n    <>\n      <DemoSection title=\"异步确认\">\n        <Button onClick={() => setOpen(true)}>打开并提交</Button>\n        <output data-testid=\"modal-submit-count\" style=\"margin-inline-start: 12px\">\n          请求次数：{submits()}\n        </output>\n        <output data-testid=\"modal-submit-log\" style=\"margin-inline-start: 12px\">\n          {log()}\n        </output>\n        <Modal\n          title=\"确认提交采购计划\"\n          open={open()}\n          onOpenChange={setOpen}\n          onOk={onOk}\n          okText=\"提交审批\"\n        >\n          <p>提交后计划将锁定，等待期内请重复点击「提交审批」验证防重。</p>\n        </Modal>\n      </DemoSection>\n    </>\n  );\n}\n",
  "html": "<pre class=\"shiki github-light\" style=\"background-color:#fff;color:#24292e\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49\">import</span><span style=\"color:#24292E\"> { createSignal } </span><span style=\"color:#D73A49\">from</span><span style=\"color:#032F62\"> 'solid-js'</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">import</span><span style=\"color:#24292E\"> { Button, Modal } </span><span style=\"color:#D73A49\">from</span><span style=\"color:#032F62\"> 'solid-craft'</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">import</span><span style=\"color:#24292E\"> { DemoSection } </span><span style=\"color:#D73A49\">from</span><span style=\"color:#032F62\"> '../../demos/shared'</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">export</span><span style=\"color:#D73A49\"> const</span><span style=\"color:#005CC5\"> demo</span><span style=\"color:#D73A49\"> =</span><span style=\"color:#24292E\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  title: </span><span style=\"color:#032F62\">'异步关闭'</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  description:</span></span>\n<span class=\"line\"><span style=\"color:#032F62\">    'onOk 返回 Promise 时进入等待态：确认按钮转圈、取消与右上关闭禁用、ESC 与遮罩点击被拦截，重复点击不会再发一次请求。'</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">};</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D\">/** 模拟一次 900ms 的提交请求；真实业务里换成接口调用即可。 */</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">function</span><span style=\"color:#6F42C1\"> submit</span><span style=\"color:#24292E\">()</span><span style=\"color:#D73A49\">:</span><span style=\"color:#6F42C1\"> Promise</span><span style=\"color:#24292E\">&#x3C;</span><span style=\"color:#005CC5\">void</span><span style=\"color:#24292E\">> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">  return</span><span style=\"color:#D73A49\"> new</span><span style=\"color:#005CC5\"> Promise</span><span style=\"color:#24292E\">((</span><span style=\"color:#E36209\">resolve</span><span style=\"color:#24292E\">) </span><span style=\"color:#D73A49\">=></span><span style=\"color:#24292E\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">    window.</span><span style=\"color:#6F42C1\">setTimeout</span><span style=\"color:#24292E\">(resolve, </span><span style=\"color:#005CC5\">900</span><span style=\"color:#24292E\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  });</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">export</span><span style=\"color:#D73A49\"> default</span><span style=\"color:#D73A49\"> function</span><span style=\"color:#6F42C1\"> ModalAsyncCloseDemo</span><span style=\"color:#24292E\">() {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">  const</span><span style=\"color:#24292E\"> [</span><span style=\"color:#005CC5\">open</span><span style=\"color:#24292E\">, </span><span style=\"color:#005CC5\">setOpen</span><span style=\"color:#24292E\">] </span><span style=\"color:#D73A49\">=</span><span style=\"color:#6F42C1\"> createSignal</span><span style=\"color:#24292E\">(</span><span style=\"color:#005CC5\">false</span><span style=\"color:#24292E\">);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">  const</span><span style=\"color:#24292E\"> [</span><span style=\"color:#005CC5\">submits</span><span style=\"color:#24292E\">, </span><span style=\"color:#005CC5\">setSubmits</span><span style=\"color:#24292E\">] </span><span style=\"color:#D73A49\">=</span><span style=\"color:#6F42C1\"> createSignal</span><span style=\"color:#24292E\">(</span><span style=\"color:#005CC5\">0</span><span style=\"color:#24292E\">);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">  const</span><span style=\"color:#24292E\"> [</span><span style=\"color:#005CC5\">log</span><span style=\"color:#24292E\">, </span><span style=\"color:#005CC5\">setLog</span><span style=\"color:#24292E\">] </span><span style=\"color:#D73A49\">=</span><span style=\"color:#6F42C1\"> createSignal</span><span style=\"color:#24292E\">(</span><span style=\"color:#032F62\">'尚未提交'</span><span style=\"color:#24292E\">);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">  const</span><span style=\"color:#6F42C1\"> onOk</span><span style=\"color:#D73A49\"> =</span><span style=\"color:#24292E\"> ()</span><span style=\"color:#D73A49\">:</span><span style=\"color:#6F42C1\"> Promise</span><span style=\"color:#24292E\">&#x3C;</span><span style=\"color:#005CC5\">void</span><span style=\"color:#24292E\">> </span><span style=\"color:#D73A49\">=></span><span style=\"color:#24292E\"> {</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">    setSubmits</span><span style=\"color:#24292E\">((</span><span style=\"color:#E36209\">count</span><span style=\"color:#24292E\">) </span><span style=\"color:#D73A49\">=></span><span style=\"color:#24292E\"> count </span><span style=\"color:#D73A49\">+</span><span style=\"color:#005CC5\"> 1</span><span style=\"color:#24292E\">);</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">    setLog</span><span style=\"color:#24292E\">(</span><span style=\"color:#032F62\">'提交中…'</span><span style=\"color:#24292E\">);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">    return</span><span style=\"color:#6F42C1\"> submit</span><span style=\"color:#24292E\">().</span><span style=\"color:#6F42C1\">then</span><span style=\"color:#24292E\">(() </span><span style=\"color:#D73A49\">=></span><span style=\"color:#24292E\"> {</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">      setLog</span><span style=\"color:#24292E\">(</span><span style=\"color:#032F62\">'提交完成'</span><span style=\"color:#24292E\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">    });</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  };</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">  return</span><span style=\"color:#24292E\"> (</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">    &#x3C;></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">      &#x3C;</span><span style=\"color:#005CC5\">DemoSection</span><span style=\"color:#6F42C1\"> title</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"异步确认\"</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;</span><span style=\"color:#005CC5\">Button</span><span style=\"color:#6F42C1\"> onClick</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{() </span><span style=\"color:#D73A49\">=></span><span style=\"color:#6F42C1\"> setOpen</span><span style=\"color:#24292E\">(</span><span style=\"color:#005CC5\">true</span><span style=\"color:#24292E\">)}>打开并提交&#x3C;/</span><span style=\"color:#005CC5\">Button</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;</span><span style=\"color:#22863A\">output</span><span style=\"color:#6F42C1\"> data-testid</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"modal-submit-count\"</span><span style=\"color:#6F42C1\"> style</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"margin-inline-start: 12px\"</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">          请求次数：{</span><span style=\"color:#6F42C1\">submits</span><span style=\"color:#24292E\">()}</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;/</span><span style=\"color:#22863A\">output</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;</span><span style=\"color:#22863A\">output</span><span style=\"color:#6F42C1\"> data-testid</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"modal-submit-log\"</span><span style=\"color:#6F42C1\"> style</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"margin-inline-start: 12px\"</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">          {</span><span style=\"color:#6F42C1\">log</span><span style=\"color:#24292E\">()}</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;/</span><span style=\"color:#22863A\">output</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;</span><span style=\"color:#005CC5\">Modal</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">          title</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"确认提交采购计划\"</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">          open</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{</span><span style=\"color:#6F42C1\">open</span><span style=\"color:#24292E\">()}</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">          onOpenChange</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{setOpen}</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">          onOk</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{onOk}</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">          okText</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"提交审批\"</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        ></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">          &#x3C;</span><span style=\"color:#22863A\">p</span><span style=\"color:#24292E\">>提交后计划将锁定，等待期内请重复点击「提交审批」验证防重。&#x3C;/</span><span style=\"color:#22863A\">p</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;/</span><span style=\"color:#005CC5\">Modal</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">      &#x3C;/</span><span style=\"color:#005CC5\">DemoSection</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">    &#x3C;/></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  );</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">}</span></span>\n<span class=\"line\"></span></code></pre>"
}
