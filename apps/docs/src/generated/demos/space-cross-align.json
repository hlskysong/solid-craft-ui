  "source": "import { For } from 'solid-js';\nimport { Space, Text } from 'solid-craft';\nimport { DemoSection } from '../../demos/shared';\n\nexport const demo = {\n  title: '交叉轴对齐',\n  description: '四种 align 在高度不一致的子项上如何对齐。',\n};\n\nconst ALIGNS = ['start', 'center', 'end', 'baseline'] as const;\n\n/** 用不同字号撑出高度差，让 align 的差异肉眼可见。 */\nfunction Box(props: { size: 'small' | 'medium' | 'large'; label: string }) {\n  return (\n    <span\n      style={{\n        display: 'inline-flex',\n        'align-items': 'center',\n        padding: '4px 8px',\n        border: '1px solid #d9d9d9',\n        'background-color': '#fafafa',\n      }}\n    >\n      <Text size={props.size}>{props.label}</Text>\n    </span>\n  );\n}\n\nexport default function CrossAlign() {\n  return (\n    <DemoSection title=\"align\">\n      <div class=\"demo-stack\">\n        <For each={ALIGNS}>\n          {(align) => (\n            <Space align={align} size=\"small\">\n              <Box size=\"small\" label={`${align} · small`} />\n              <Box size=\"large\" label={`${align} · large`} />\n              <Box size=\"medium\" label={`${align} · medium`} />\n            </Space>\n          )}\n        </For>\n      </div>\n    </DemoSection>\n  );\n}\n",
  "html": "<pre class=\"shiki github-light\" style=\"background-color:#fff;color:#24292e\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49\">import</span><span style=\"color:#24292E\"> { For } </span><span style=\"color:#D73A49\">from</span><span style=\"color:#032F62\"> 'solid-js'</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">import</span><span style=\"color:#24292E\"> { Space, Text } </span><span style=\"color:#D73A49\">from</span><span style=\"color:#032F62\"> 'solid-craft'</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">import</span><span style=\"color:#24292E\"> { DemoSection } </span><span style=\"color:#D73A49\">from</span><span style=\"color:#032F62\"> '../../demos/shared'</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">export</span><span style=\"color:#D73A49\"> const</span><span style=\"color:#005CC5\"> demo</span><span style=\"color:#D73A49\"> =</span><span style=\"color:#24292E\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  title: </span><span style=\"color:#032F62\">'交叉轴对齐'</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  description: </span><span style=\"color:#032F62\">'四种 align 在高度不一致的子项上如何对齐。'</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">};</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">const</span><span style=\"color:#005CC5\"> ALIGNS</span><span style=\"color:#D73A49\"> =</span><span style=\"color:#24292E\"> [</span><span style=\"color:#032F62\">'start'</span><span style=\"color:#24292E\">, </span><span style=\"color:#032F62\">'center'</span><span style=\"color:#24292E\">, </span><span style=\"color:#032F62\">'end'</span><span style=\"color:#24292E\">, </span><span style=\"color:#032F62\">'baseline'</span><span style=\"color:#24292E\">] </span><span style=\"color:#D73A49\">as</span><span style=\"color:#D73A49\"> const</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D\">/** 用不同字号撑出高度差，让 align 的差异肉眼可见。 */</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">function</span><span style=\"color:#6F42C1\"> Box</span><span style=\"color:#24292E\">(</span><span style=\"color:#E36209\">props</span><span style=\"color:#D73A49\">:</span><span style=\"color:#24292E\"> { </span><span style=\"color:#E36209\">size</span><span style=\"color:#D73A49\">:</span><span style=\"color:#032F62\"> 'small'</span><span style=\"color:#D73A49\"> |</span><span style=\"color:#032F62\"> 'medium'</span><span style=\"color:#D73A49\"> |</span><span style=\"color:#032F62\"> 'large'</span><span style=\"color:#24292E\">; </span><span style=\"color:#E36209\">label</span><span style=\"color:#D73A49\">:</span><span style=\"color:#005CC5\"> string</span><span style=\"color:#24292E\"> }) {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">  return</span><span style=\"color:#24292E\"> (</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">    &#x3C;</span><span style=\"color:#22863A\">span</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">      style</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{{</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        display: </span><span style=\"color:#032F62\">'inline-flex'</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#032F62\">        'align-items'</span><span style=\"color:#24292E\">: </span><span style=\"color:#032F62\">'center'</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        padding: </span><span style=\"color:#032F62\">'4px 8px'</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        border: </span><span style=\"color:#032F62\">'1px solid #d9d9d9'</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#032F62\">        'background-color'</span><span style=\"color:#24292E\">: </span><span style=\"color:#032F62\">'#fafafa'</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">      }}</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">    ></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">      &#x3C;</span><span style=\"color:#005CC5\">Text</span><span style=\"color:#6F42C1\"> size</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{props.size}>{props.label}&#x3C;/</span><span style=\"color:#005CC5\">Text</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">    &#x3C;/</span><span style=\"color:#22863A\">span</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  );</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">export</span><span style=\"color:#D73A49\"> default</span><span style=\"color:#D73A49\"> function</span><span style=\"color:#6F42C1\"> CrossAlign</span><span style=\"color:#24292E\">() {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">  return</span><span style=\"color:#24292E\"> (</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">    &#x3C;</span><span style=\"color:#005CC5\">DemoSection</span><span style=\"color:#6F42C1\"> title</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"align\"</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">      &#x3C;</span><span style=\"color:#22863A\">div</span><span style=\"color:#6F42C1\"> class</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"demo-stack\"</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;</span><span style=\"color:#005CC5\">For</span><span style=\"color:#6F42C1\"> each</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{</span><span style=\"color:#005CC5\">ALIGNS</span><span style=\"color:#24292E\">}></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">          {(</span><span style=\"color:#E36209\">align</span><span style=\"color:#24292E\">) </span><span style=\"color:#D73A49\">=></span><span style=\"color:#24292E\"> (</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">            &#x3C;</span><span style=\"color:#005CC5\">Space</span><span style=\"color:#6F42C1\"> align</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{align} </span><span style=\"color:#6F42C1\">size</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"small\"</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">              &#x3C;</span><span style=\"color:#005CC5\">Box</span><span style=\"color:#6F42C1\"> size</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"small\"</span><span style=\"color:#6F42C1\"> label</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{</span><span style=\"color:#032F62\">`${</span><span style=\"color:#24292E\">align</span><span style=\"color:#032F62\">} · small`</span><span style=\"color:#24292E\">} /></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">              &#x3C;</span><span style=\"color:#005CC5\">Box</span><span style=\"color:#6F42C1\"> size</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"large\"</span><span style=\"color:#6F42C1\"> label</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{</span><span style=\"color:#032F62\">`${</span><span style=\"color:#24292E\">align</span><span style=\"color:#032F62\">} · large`</span><span style=\"color:#24292E\">} /></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">              &#x3C;</span><span style=\"color:#005CC5\">Box</span><span style=\"color:#6F42C1\"> size</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"medium\"</span><span style=\"color:#6F42C1\"> label</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{</span><span style=\"color:#032F62\">`${</span><span style=\"color:#24292E\">align</span><span style=\"color:#032F62\">} · medium`</span><span style=\"color:#24292E\">} /></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">            &#x3C;/</span><span style=\"color:#005CC5\">Space</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">          )}</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;/</span><span style=\"color:#005CC5\">For</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">      &#x3C;/</span><span style=\"color:#22863A\">div</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">    &#x3C;/</span><span style=\"color:#005CC5\">DemoSection</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  );</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">}</span></span>\n<span class=\"line\"></span></code></pre>"
