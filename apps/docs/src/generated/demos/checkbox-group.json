{
  "path": "packages/core/src/components/checkbox/demos/group.tsx",
  "source": "import { createMemo, createSignal } from 'solid-js';\nimport { Checkbox, CheckboxGroup } from 'solid-craft';\nimport { DemoSection } from '../../demos/shared';\n\nexport const demo = {\n  title: '多选框组',\n  description: '选项数组、手写子项与全选联动，整组值与勾选状态保持同步。',\n};\n\nconst FRUIT_OPTIONS = [\n  { label: '苹果', value: 'apple' },\n  { label: '香蕉', value: 'banana' },\n  { label: '橙子', value: 'orange' },\n];\n\nexport default function CheckboxGroupDemo() {\n  const [selected, setSelected] = createSignal<string[]>(['apple']);\n  const allSelected = createMemo(() => selected().length === FRUIT_OPTIONS.length);\n  const partial = createMemo(() => selected().length > 0 && !allSelected());\n\n  const toggleAll = (checked: boolean) => {\n    setSelected(checked ? FRUIT_OPTIONS.map((option) => option.value) : []);\n  };\n\n  return (\n    <>\n      <DemoSection title=\"options 写法\">\n        <CheckboxGroup aria-label=\"喜欢的水果\" options={FRUIT_OPTIONS} defaultValue={['banana']} />\n      </DemoSection>\n\n      <DemoSection title=\"手写子项\">\n        <CheckboxGroup aria-label=\"去过的城市\" defaultValue={['beijing']}>\n          <Checkbox value=\"beijing\">北京</Checkbox>\n          <Checkbox value=\"shanghai\">上海</Checkbox>\n          <Checkbox value=\"shenzhen\">深圳</Checkbox>\n        </CheckboxGroup>\n      </DemoSection>\n\n      <DemoSection title=\"全选联动\">\n        <Checkbox checked={allSelected()} indeterminate={partial()} onChange={toggleAll}>\n          全选\n        </Checkbox>\n        <CheckboxGroup\n          aria-label=\"喜欢的水果（全选联动）\"\n          options={FRUIT_OPTIONS}\n          value={selected()}\n          onChange={(values) => setSelected(values)}\n        />\n        <span>\n          已选：<output>{selected().length > 0 ? selected().join('、') : '（无）'}</output>\n        </span>\n      </DemoSection>\n    </>\n  );\n}\n",
  "html": "<pre class=\"shiki github-light\" style=\"background-color:#fff;color:#24292e\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49\">import</span><span style=\"color:#24292E\"> { createMemo, createSignal } </span><span style=\"color:#D73A49\">from</span><span style=\"color:#032F62\"> 'solid-js'</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">import</span><span style=\"color:#24292E\"> { Checkbox, CheckboxGroup } </span><span style=\"color:#D73A49\">from</span><span style=\"color:#032F62\"> 'solid-craft'</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">import</span><span style=\"color:#24292E\"> { DemoSection } </span><span style=\"color:#D73A49\">from</span><span style=\"color:#032F62\"> '../../demos/shared'</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">export</span><span style=\"color:#D73A49\"> const</span><span style=\"color:#005CC5\"> demo</span><span style=\"color:#D73A49\"> =</span><span style=\"color:#24292E\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  title: </span><span style=\"color:#032F62\">'多选框组'</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  description: </span><span style=\"color:#032F62\">'选项数组、手写子项与全选联动，整组值与勾选状态保持同步。'</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">};</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">const</span><span style=\"color:#005CC5\"> FRUIT_OPTIONS</span><span style=\"color:#D73A49\"> =</span><span style=\"color:#24292E\"> [</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  { label: </span><span style=\"color:#032F62\">'苹果'</span><span style=\"color:#24292E\">, value: </span><span style=\"color:#032F62\">'apple'</span><span style=\"color:#24292E\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  { label: </span><span style=\"color:#032F62\">'香蕉'</span><span style=\"color:#24292E\">, value: </span><span style=\"color:#032F62\">'banana'</span><span style=\"color:#24292E\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  { label: </span><span style=\"color:#032F62\">'橙子'</span><span style=\"color:#24292E\">, value: </span><span style=\"color:#032F62\">'orange'</span><span style=\"color:#24292E\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">];</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">export</span><span style=\"color:#D73A49\"> default</span><span style=\"color:#D73A49\"> function</span><span style=\"color:#6F42C1\"> CheckboxGroupDemo</span><span style=\"color:#24292E\">() {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">  const</span><span style=\"color:#24292E\"> [</span><span style=\"color:#005CC5\">selected</span><span style=\"color:#24292E\">, </span><span style=\"color:#005CC5\">setSelected</span><span style=\"color:#24292E\">] </span><span style=\"color:#D73A49\">=</span><span style=\"color:#6F42C1\"> createSignal</span><span style=\"color:#24292E\">&#x3C;</span><span style=\"color:#005CC5\">string</span><span style=\"color:#24292E\">[]>([</span><span style=\"color:#032F62\">'apple'</span><span style=\"color:#24292E\">]);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">  const</span><span style=\"color:#005CC5\"> allSelected</span><span style=\"color:#D73A49\"> =</span><span style=\"color:#6F42C1\"> createMemo</span><span style=\"color:#24292E\">(() </span><span style=\"color:#D73A49\">=></span><span style=\"color:#6F42C1\"> selected</span><span style=\"color:#24292E\">().</span><span style=\"color:#005CC5\">length</span><span style=\"color:#D73A49\"> ===</span><span style=\"color:#005CC5\"> FRUIT_OPTIONS</span><span style=\"color:#24292E\">.</span><span style=\"color:#005CC5\">length</span><span style=\"color:#24292E\">);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">  const</span><span style=\"color:#005CC5\"> partial</span><span style=\"color:#D73A49\"> =</span><span style=\"color:#6F42C1\"> createMemo</span><span style=\"color:#24292E\">(() </span><span style=\"color:#D73A49\">=></span><span style=\"color:#6F42C1\"> selected</span><span style=\"color:#24292E\">().</span><span style=\"color:#005CC5\">length</span><span style=\"color:#D73A49\"> ></span><span style=\"color:#005CC5\"> 0</span><span style=\"color:#D73A49\"> &#x26;&#x26;</span><span style=\"color:#D73A49\"> !</span><span style=\"color:#6F42C1\">allSelected</span><span style=\"color:#24292E\">());</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">  const</span><span style=\"color:#6F42C1\"> toggleAll</span><span style=\"color:#D73A49\"> =</span><span style=\"color:#24292E\"> (</span><span style=\"color:#E36209\">checked</span><span style=\"color:#D73A49\">:</span><span style=\"color:#005CC5\"> boolean</span><span style=\"color:#24292E\">) </span><span style=\"color:#D73A49\">=></span><span style=\"color:#24292E\"> {</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">    setSelected</span><span style=\"color:#24292E\">(checked </span><span style=\"color:#D73A49\">?</span><span style=\"color:#005CC5\"> FRUIT_OPTIONS</span><span style=\"color:#24292E\">.</span><span style=\"color:#6F42C1\">map</span><span style=\"color:#24292E\">((</span><span style=\"color:#E36209\">option</span><span style=\"color:#24292E\">) </span><span style=\"color:#D73A49\">=></span><span style=\"color:#24292E\"> option.value) </span><span style=\"color:#D73A49\">:</span><span style=\"color:#24292E\"> []);</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  };</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">  return</span><span style=\"color:#24292E\"> (</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">    &#x3C;></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">      &#x3C;</span><span style=\"color:#005CC5\">DemoSection</span><span style=\"color:#6F42C1\"> title</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"options 写法\"</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;</span><span style=\"color:#005CC5\">CheckboxGroup</span><span style=\"color:#6F42C1\"> aria-label</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"喜欢的水果\"</span><span style=\"color:#6F42C1\"> options</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{</span><span style=\"color:#005CC5\">FRUIT_OPTIONS</span><span style=\"color:#24292E\">} </span><span style=\"color:#6F42C1\">defaultValue</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{[</span><span style=\"color:#032F62\">'banana'</span><span style=\"color:#24292E\">]} /></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">      &#x3C;/</span><span style=\"color:#005CC5\">DemoSection</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E\">      &#x3C;</span><span style=\"color:#005CC5\">DemoSection</span><span style=\"color:#6F42C1\"> title</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"手写子项\"</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;</span><span style=\"color:#005CC5\">CheckboxGroup</span><span style=\"color:#6F42C1\"> aria-label</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"去过的城市\"</span><span style=\"color:#6F42C1\"> defaultValue</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{[</span><span style=\"color:#032F62\">'beijing'</span><span style=\"color:#24292E\">]}></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">          &#x3C;</span><span style=\"color:#005CC5\">Checkbox</span><span style=\"color:#6F42C1\"> value</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"beijing\"</span><span style=\"color:#24292E\">>北京&#x3C;/</span><span style=\"color:#005CC5\">Checkbox</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">          &#x3C;</span><span style=\"color:#005CC5\">Checkbox</span><span style=\"color:#6F42C1\"> value</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"shanghai\"</span><span style=\"color:#24292E\">>上海&#x3C;/</span><span style=\"color:#005CC5\">Checkbox</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">          &#x3C;</span><span style=\"color:#005CC5\">Checkbox</span><span style=\"color:#6F42C1\"> value</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"shenzhen\"</span><span style=\"color:#24292E\">>深圳&#x3C;/</span><span style=\"color:#005CC5\">Checkbox</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;/</span><span style=\"color:#005CC5\">CheckboxGroup</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">      &#x3C;/</span><span style=\"color:#005CC5\">DemoSection</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E\">      &#x3C;</span><span style=\"color:#005CC5\">DemoSection</span><span style=\"color:#6F42C1\"> title</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"全选联动\"</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;</span><span style=\"color:#005CC5\">Checkbox</span><span style=\"color:#6F42C1\"> checked</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{</span><span style=\"color:#6F42C1\">allSelected</span><span style=\"color:#24292E\">()} </span><span style=\"color:#6F42C1\">indeterminate</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{</span><span style=\"color:#6F42C1\">partial</span><span style=\"color:#24292E\">()} </span><span style=\"color:#6F42C1\">onChange</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{toggleAll}></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">          全选</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;/</span><span style=\"color:#005CC5\">Checkbox</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;</span><span style=\"color:#005CC5\">CheckboxGroup</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">          aria-label</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"喜欢的水果（全选联动）\"</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">          options</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{</span><span style=\"color:#005CC5\">FRUIT_OPTIONS</span><span style=\"color:#24292E\">}</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">          value</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{</span><span style=\"color:#6F42C1\">selected</span><span style=\"color:#24292E\">()}</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">          onChange</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{(</span><span style=\"color:#E36209\">values</span><span style=\"color:#24292E\">) </span><span style=\"color:#D73A49\">=></span><span style=\"color:#6F42C1\"> setSelected</span><span style=\"color:#24292E\">(values)}</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        /></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;</span><span style=\"color:#22863A\">span</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">          已选：&#x3C;</span><span style=\"color:#22863A\">output</span><span style=\"color:#24292E\">>{</span><span style=\"color:#6F42C1\">selected</span><span style=\"color:#24292E\">().</span><span style=\"color:#005CC5\">length</span><span style=\"color:#D73A49\"> ></span><span style=\"color:#005CC5\"> 0</span><span style=\"color:#D73A49\"> ?</span><span style=\"color:#6F42C1\"> selected</span><span style=\"color:#24292E\">().</span><span style=\"color:#6F42C1\">join</span><span style=\"color:#24292E\">(</span><span style=\"color:#032F62\">'、'</span><span style=\"color:#24292E\">) </span><span style=\"color:#D73A49\">:</span><span style=\"color:#032F62\"> '（无）'</span><span style=\"color:#24292E\">}&#x3C;/</span><span style=\"color:#22863A\">output</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;/</span><span style=\"color:#22863A\">span</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">      &#x3C;/</span><span style=\"color:#005CC5\">DemoSection</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">    &#x3C;/></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  );</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">}</span></span>\n<span class=\"line\"></span></code></pre>"
