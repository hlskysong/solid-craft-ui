e=\"color:#6F42C1\"> class</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"demo-layout\"</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">          &#x3C;</span><span style=\"color:#005CC5\">Sider</span><span style=\"color:#6F42C1\"> collapsed</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{</span><span style=\"color:#6F42C1\">collapsed</span><span style=\"color:#24292E\">()} </span><span style=\"color:#6F42C1\">width</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{</span><span style=\"color:#005CC5\">160</span><span style=\"color:#24292E\">} </span><span style=\"color:#6F42C1\">collapsedWidth</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{</span><span style=\"color:#005CC5\">64</span><span style=\"color:#24292E\">}></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">            {</span><span style=\"color:#6F42C1\">collapsed</span><span style=\"color:#24292E\">() </span><span style=\"color:#D73A49\">?</span><span style=\"color:#032F62\"> '菜单'</span><span style=\"color:#D73A49\"> :</span><span style=\"color:#032F62\"> '计划菜单'</span><span style=\"color:#24292E\">}</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">          &#x3C;/</span><span style=\"color:#005CC5\">Sider</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">          &#x3C;</span><span style=\"color:#005CC5\">Layout</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">            &#x3C;</span><span style=\"color:#005CC5\">Header</span><span style=\"color:#24292E\">>设备维检计划&#x3C;/</span><span style=\"color:#005CC5\">Header</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">            &#x3C;</span><span style=\"color:#005CC5\">Content</span><span style=\"colo