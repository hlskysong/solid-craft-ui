st</span><span style=\"color:#24292E\"> [</span><span style=\"color:#005CC5\">open</span><span style=\"color:#24292E\">, </span><span style=\"color:#005CC5\">setOpen</span><span style=\"color:#24292E\">] </span><span style=\"color:#D73A49\">=</span><span style=\"color:#6F42C1\"> createSignal</span><span style=\"color:#24292E\">(</span><span style=\"color:#005CC5\">false</span><span style=\"color:#24292E\">);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">  return</span><span style=\"color:#24292E\"> (</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">    &#x3C;></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">      &#x3C;</span><span style=\"color:#005CC5\">DemoSection</span><span style=\"color:#6F42C1\"> title</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"键盘链路\"</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;</span><span style=\"color:#005CC5\">Button</span><span style=\"color:#6F42C1\"> data-testid</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"modal-focus-trigger\"</span><span style=\"color:#6F42C1\"> onClick</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{() </span><span style=\"color:#D73A49\">=></span><span style=\"color:#6F42C1\"> setOpen</span><span style=\"color:#24292E\">(</span><span style=\"color:#005CC5\">true</span><span style=\"color:#24292E\">)}></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">          打开并检查焦点</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;/</span><span style=\"color:#005CC5\">Button</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;</span><span style=\"color:#005CC5\">Modal</span><span style=\"color:#6F42C1\"> title</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"设备信息登记\"</span><span style=\"color:#6F42C1\"> open</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{</span><span style=\"color:#6F42C1\">open</span><span style=\"color:#24292E\">()} </span><span style=\"color:#6F42C1\">onOpenChange</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{setOpen} </span><span style=\"color:#6F42C1\">okText</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"保存\"</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">          &#x3C;</span><span style=\"color:#22863A\">label</span><span style=\"color:#6F42C1\"> style</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"display: block; margin-block-end: 8px\"</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">            计划名称</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">            &#x3C;</span><span style=\"color:#22863A\">input</span><span style=\"color:#6F42C1\"> data-testid</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"modal-focus-input\"</span><span style=\"color:#6F42C1\"> style</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"display: block\"</span><span style=\"color:#24292E\"> /></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">          &#x3C;/</span><span style=\"color:#22863A\">label</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">          &#x3C;</span><span style=\"color:#22863A\">label</span><span style=\"color:#6F42C1\"> style</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"display: block\"</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">            备注</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">            &#x3C;</