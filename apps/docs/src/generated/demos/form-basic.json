  "source": "import { createSignal } from 'solid-js';\nimport { Button, Form, Input, useForm } from 'solid-craft';\nimport { DemoSection } from '../../demos/shared';\n\nexport const demo = {\n  title: '基础用法',\n  description: 'useForm 创建实例，Form.Item 接管控件取值，提交后回显全量快照。',\n};\n\nexport default function BasicDemo() {\n  const [form] = useForm({ username: '', department: '' });\n  const [submitted, setSubmitted] = createSignal('尚未提交');\n\n  return (\n    <DemoSection title=\"受控表单\">\n      <Form form={form} onFinish={(values) => setSubmitted(JSON.stringify(values))}>\n        <Form.Item name=\"username\" label=\"姓名\">\n          <Input placeholder=\"请输入姓名\" />\n        </Form.Item>\n        <Form.Item name=\"department\" label=\"部门\">\n          <Input placeholder=\"请输入部门\" />\n        </Form.Item>\n        <Button htmlType=\"submit\">提交</Button>\n      </Form>\n      <span>\n        提交结果：<output>{submitted()}</output>\n      </span>\n    </DemoSection>\n  );\n}\n",
  "html": "<pre class=\"shiki github-light\" style=\"background-color:#fff;color:#24292e\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49\">import</span><span style=\"color:#24292E\"> { createSignal } </span><span style=\"color:#D73A49\">from</span><span style=\"color:#032F62\"> 'solid-js'</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">import</span><span style=\"color:#24292E\"> { Button, Form, Input, useForm } </span><span style=\"color:#D73A49\">from</span><span style=\"color:#032F62\"> 'solid-craft'</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">import</span><span style=\"color:#24292E\"> { DemoSection } </span><span style=\"color:#D73A49\">from</span><span style=\"color:#032F62\"> '../../demos/shared'</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">export</span><span style=\"color:#D73A49\"> const</span><span style=\"color:#005CC5\"> demo</span><span style=\"color:#D73A49\"> =</span><span style=\"color:#24292E\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  title: </span><span style=\"color:#032F62\">'基础用法'</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  description: </span><span style=\"color:#032F62\">'useForm 创建实例，Form.Item 接管控件取值，提交后回显全量快照。'</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">};</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">export</span><span style=\"color:#D73A49\"> default</span><span style=\"color:#D73A49\"> function</span><span style=\"color:#6F42C1\"> BasicDemo</span><span style=\"color:#24292E\">() {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">  const</span><span style=\"color:#24292E\"> [</span><span style=\"color:#005CC5\">form</span><span style=\"color:#24292E\">] </span><span style=\"color:#D73A49\">=</span><span style=\"color:#6F42C1\"> useForm</span><span style=\"color:#24292E\">({ username: </span><span style=\"color:#032F62\">''</span><span style=\"color:#24292E\">, department: </span><span style=\"color:#032F62\">''</span><span style=\"color:#24292E\"> });</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">  const</span><span style=\"color:#24292E\"> [</span><span style=\"color:#005CC5\">submitted</span><span style=\"color:#24292E\">, </span><span style=\"color:#005CC5\">setSubmitted</span><span style=\"color:#24292E\">] </span><span style=\"color:#D73A49\">=</span><span style=\"color:#6F42C1\"> createSignal</span><span style=\"color:#24292E\">(</span><span style=\"color:#032F62\">'尚未提交'</span><span style=\"color:#24292E\">);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">  return</span><span style=\"color:#24292E\"> (</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">    &#x3C;</span><span style=\"color:#005CC5\">DemoSection</span><span style=\"color:#6F42C1\"> title</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"受控表单\"</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">      &#x3C;</span><span style=\"color:#005CC5\">Form</span><span style=\"color:#6F42C1\"> form</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{form} </span><span style=\"color:#6F42C1\">onFinish</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{(</span><span style=\"color:#E36209\">values</span><span style=\"color:#24292E\">) </span><span style=\"color:#D73A49\">=></span><span style=\"color:#6F42C1\"> setSubmitted</span><span style=\"color:#24292E\">(</span><span style=\"color:#005CC5\">JSON</span><span style=\"color:#24292E\">.</span><span style=\"color:#6F42C1\">stringify</span><span style=\"color:#24292E\">(values))}></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;</span><span style=\"color:#005CC5\">Form.Item</span><span style=\"color:#6F42C1\"> name</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"username\"</span><span style=\"color:#6F42C1\"> label</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"姓名\"</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">          &#x3C;</span><span style=\"color:#005CC5\">Input</span><span style=\"color:#6F42C1\"> placeholder</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"请输入姓名\"</span><span style=\"color:#24292E\"> /></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;/</span><span style=\"color:#005CC5\">Form.Item</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;</span><span style=\"color:#005CC5\">Form.Item</span><span style=\"color:#6F42C1\"> name</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"department\"</span><span style=\"color:#6F42C1\"> label</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"部门\"</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">          &#x3C;</span><span style=\"color:#005CC5\">Input</span><span style=\"color:#6F42C1\"> placeholder</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"请输入部门\"</span><span style=\"color:#24292E\"> /></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;/</span><span style=\"color:#005CC5\">Form.Item</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;</span><span style=\"color:#005CC5\">Button</span><span style=\"color:#6F42C1\"> htmlType</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"submit\"</span><span style=\"color:#24292E\">>提交&#x3C;/</span><span style=\"color:#005CC5\">Button</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">      &#x3C;/</span><span style=\"color:#005CC5\">Form</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">      &#x3C;</span><span style=\"color:#22863A\">span</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        提交结果：&#x3C;</span><span style=\"color:#22863A\">output</span><span style=\"color:#24292E\">>{</span><span style=\"color:#6F42C1\">submitted</span><span style=\"color:#24292E\">()}&#x3C;/</span><span style=\"color:#22863A\">output</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">      &#x3C;/</span><span style=\"color:#22863A\">span</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">    &#x3C;/</span><span style=\"color:#005CC5\">DemoSection</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  );</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">}</span></span>\n<span class=\"line\"></span></code></pre>"
}
