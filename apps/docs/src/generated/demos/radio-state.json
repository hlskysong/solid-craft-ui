  "source": "import { createSignal } from 'solid-js';\nimport { RadioGroup } from 'solid-craft';\nimport { DemoSection } from '../../demos/shared';\n\nexport const demo = {\n  title: '受控状态',\n  description: '受控 value 配合 onChange 回显，整组禁用时保持当前选中项。',\n};\n\nconst SPEED_OPTIONS = [\n  { label: '慢速', value: 'slow' },\n  { label: '标准', value: 'standard' },\n  { label: '快速', value: 'fast' },\n];\n\nexport default function RadioStateDemo() {\n  const [speed, setSpeed] = createSignal('standard');\n  const speedLabel = () =>\n    SPEED_OPTIONS.find((option) => option.value === speed())?.label ?? speed();\n\n  return (\n    <>\n      <DemoSection title=\"受控值\">\n        <RadioGroup\n          aria-label=\"运行速度\"\n          options={SPEED_OPTIONS}\n          value={speed()}\n          onChange={(value) => setSpeed(value)}\n        />\n        <span>\n          当前速度：<output>{speedLabel()}</output>\n        </span>\n      </DemoSection>\n\n      <DemoSection title=\"整组禁用\">\n        <RadioGroup\n          aria-label=\"禁用的运行速度\"\n          options={SPEED_OPTIONS}\n          defaultValue=\"fast\"\n          disabled\n        />\n      </DemoSection>\n    </>\n  );\n}\n",
  "html": "<pre class=\"shiki github-light\" style=\"background-color:#fff;color:#24292e\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49\">import</span><span style=\"color:#24292E\"> { createSignal } </span><span style=\"color:#D73A49\">from</span><span style=\"color:#032F62\"> 'solid-js'</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">import</span><span style=\"color:#24292E\"> { RadioGroup } </span><span style=\"color:#D73A49\">from</span><span style=\"color:#032F62\"> 'solid-craft'</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">import</span><span style=\"color:#24292E\"> { DemoSection } </span><span style=\"color:#D73A49\">from</span><span style=\"color:#032F62\"> '../../demos/shared'</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">export</span><span style=\"color:#D73A49\"> const</span><span style=\"color:#005CC5\"> demo</span><span style=\"color:#D73A49\"> =</span><span style=\"color:#24292E\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  title: </span><span style=\"color:#032F62\">'受控状态'</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  description: </span><span style=\"color:#032F62\">'受控 value 配合 onChange 回显，整组禁用时保持当前选中项。'</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">};</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">const</span><span style=\"color:#005CC5\"> SPEED_OPTIONS</span><span style=\"color:#D73A49\"> =</span><span style=\"color:#24292E\"> [</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  { label: </span><span style=\"color:#032F62\">'慢速'</span><span style=\"color:#24292E\">, value: </span><span style=\"color:#032F62\">'slow'</span><span style=\"color:#24292E\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  { label: </span><span style=\"color:#032F62\">'标准'</span><span style=\"color:#24292E\">, value: </span><span style=\"color:#032F62\">'standard'</span><span style=\"color:#24292E\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  { label: </span><span style=\"color:#032F62\">'快速'</span><span style=\"color:#24292E\">, value: </span><span style=\"color:#032F62\">'fast'</span><span style=\"color:#24292E\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">];</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">export</span><span style=\"color:#D73A49\"> default</span><span style=\"color:#D73A49\"> function</span><span style=\"color:#6F42C1\"> RadioStateDemo</span><span style=\"color:#24292E\">() {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">  const</span><span style=\"color:#24292E\"> [</span><span style=\"color:#005CC5\">speed</span><span style=\"color:#24292E\">, </span><span style=\"color:#005CC5\">setSpeed</span><span style=\"color:#24292E\">] </span><span style=\"color:#D73A49\">=</span><span style=\"color:#6F42C1\"> createSignal</span><span style=\"color:#24292E\">(</span><span style=\"color:#032F62\">'standard'</span><span style=\"color:#24292E\">);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">  const</span><span style=\"color:#6F42C1\"> speedLabel</span><span style=\"color:#D73A49\"> =</span><span style=\"color:#24292E\"> () </span><span style=\"color:#D73A49\">=></span></span>\n<span class=\"line\"><span style=\"color:#005CC5\">    SPEED_OPTIONS</span><span style=\"color:#24292E\">.</span><span style=\"color:#6F42C1\">find</span><span style=\"color:#24292E\">((</span><span style=\"color:#E36209\">option</span><span style=\"color:#24292E\">) </span><span style=\"color:#D73A49\">=></span><span style=\"color:#24292E\"> option.value </span><span style=\"color:#D73A49\">===</span><span style=\"color:#6F42C1\"> speed</span><span style=\"color:#24292E\">())?.label </span><span style=\"color:#D73A49\">??</span><span style=\"color:#6F42C1\"> speed</span><span style=\"color:#24292E\">();</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">  return</span><span style=\"color:#24292E\"> (</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">    &#x3C;></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">      &#x3C;</span><span style=\"color:#005CC5\">DemoSection</span><span style=\"color:#6F42C1\"> title</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"受控值\"</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;</span><span style=\"color:#005CC5\">RadioGroup</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">          aria-label</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"运行速度\"</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">          options</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{</span><span style=\"color:#005CC5\">SPEED_OPTIONS</span><span style=\"color:#24292E\">}</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">          value</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{</span><span style=\"color:#6F42C1\">speed</span><span style=\"color:#24292E\">()}</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">          onChange</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{(</span><span style=\"color:#E36209\">value</span><span style=\"color:#24292E\">) </span><span style=\"color:#D73A49\">=></span><span style=\"color:#6F42C1\"> setSpeed</span><span style=\"color:#24292E\">(value)}</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        /></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;</span><span style=\"color:#22863A\">span</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">          当前速度：&#x3C;</span><span style=\"color:#22863A\">output</span><span style=\"color:#24292E\">>{</span><span style=\"color:#6F42C1\">speedLabel</span><span style=\"color:#24292E\">()}&#x3C;/</span><span style=\"color:#22863A\">output</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;/</span><span style=\"color:#22863A\">span</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">      &#x3C;/</span><span style=\"color:#005CC5\">DemoSection</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E\">      &#x3C;</span><span style=\"color:#005CC5\">DemoSection</span><span style=\"color:#6F42C1\"> title</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"整组禁用\"</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;</span><span style=\"color:#005CC5\">RadioGroup</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">          aria-label</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"禁用的运行速度\"</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">          options</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{</span><span style=\"color:#005CC5\">SPEED_OPTIONS</span><span style=\"color:#24292E\">}</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">          defaultValue</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"fast\"</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">          disabled</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        /></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">      &#x3C;/</span><span style=\"color:#005CC5\">DemoSection</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">    &#x3C;/></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  );</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">}</span></span>\n<span class=\"line\"></span></code></pre>"
}
