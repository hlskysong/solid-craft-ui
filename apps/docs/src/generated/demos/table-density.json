>,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  compact: </span><span style=\"color:#032F62\">'紧凑 8 / 8'</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">};</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">export</span><span style=\"color:#D73A49\"> const</span><span style=\"color:#005CC5\"> demo</span><span style=\"color:#D73A49\"> =</span><span style=\"color:#24292E\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  title: </span><span style=\"color:#032F62\">'密度档位'</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  description: </span><span style=\"color:#032F62\">'舒适、默认、紧凑三档单元格内距；密度只改内距，不改变行高与字号。'</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">};</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">export</span><span style=\"color:#D73A49\"> default</span><span style=\"color:#D73A49\"> function</span><span style=\"color:#6F42C1\"> DensityDemo</span><span style=\"color:#24292E\">() {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">  return</span><span style=\"color:#24292E\"> (</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">    &#x3C;</span><span style=\"color:#005CC5\">DemoSection</span><span style=\"color:#6F42C1\"> title</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"密度档位\"</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">      &#x3C;</span><span style=\"color:#22863A\">div</span><span style=\"color:#6F42C1\"> class</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"demo-stack\"</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;</span><span style=\"color:#005CC5\">For</span><span style=\"color:#6F42C1\"> each</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{densities}></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">          {(</span><span style=\"color:#E36209\">density</span><span style=\"color:#24292E\">) </span><span style=\"color:#D73A49\">=></span><span style=\"color:#24292E\"> (</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">            &#x3C;</span><span style=\"color:#005CC5\">Table</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">              columns</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{columns}</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">              data</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{rows}</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">              rowKey</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"id\"</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">              density</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{density}</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">              aria-label</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{labels[density]}</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">            /></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">          )}</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;/</span><span style=\"color:#005CC5\">For</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">      &#x3C;/</span><span style=\"color:#22863A\">div</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">    &#x3C;/</span><span style=\"color:#005CC5\">DemoSection</span><span style=\"colo