{
  "path": "packages/core/src/components/input/demos/number-format.tsx",
  "source": "import { createSignal } from 'solid-js';\nimport { InputNumber } from 'solid-craft';\nimport { DemoSection } from '../../demos/shared';\n\nexport const demo = {\n  title: '精度与格式化',\n  description: 'precision 控制小数位、thousands 展示千分位，以及受控值在失焦时被夹到 max。',\n};\n\nexport default function NumberFormatDemo() {\n  const [integer, setInteger] = createSignal<number | null>(42);\n  const [price, setPrice] = createSignal<number | null>(1234.5);\n  const [clamped, setClamped] = createSignal<number | null>(50);\n\n  return (\n    <>\n      <DemoSection title=\"precision 取整（0 位）\">\n        <InputNumber\n          precision={0}\n          aria-label=\"取整数字\"\n          value={integer()}\n          onChange={(value) => setInteger(value)}\n        />\n        <span>\n          当前值：\n          <output>{integer() ?? '空'}</output>\n        </span>\n      </DemoSection>\n\n      <DemoSection title=\"precision 两位小数\">\n        <InputNumber precision={2} aria-label=\"两位小数\" defaultValue={12.3456} />\n        <InputNumber precision={2} step={0.01} aria-label=\"两位小数步进\" defaultValue={9.99} />\n        <span>输入与步进的结果都会被裁到 2 位小数。</span>\n      </DemoSection>\n\n      <DemoSection title=\"千分位\">\n        <InputNumber\n          thousands\n          aria-label=\"千分位金额\"\n          value={price()}\n          onChange={(value) => setPrice(value)}\n        />\n        <span>\n          当前值：\n          <output>{price() ?? '空'}</output>，输入时可带逗号也可不带。\n        </span>\n        <InputNumber thousands precision={0} aria-label=\"千分位整数\" defaultValue={1234567} />\n      </DemoSection>\n\n      <DemoSection title=\"失焦归一化\">\n        <InputNumber\n          min={0}\n          max={100}\n          aria-label=\"0 到 100 的数字\"\n          value={clamped()}\n          onChange={(value) => setClamped(value)}\n        />\n        <span>\n          当前值：\n          <output>{clamped() ?? '空'}</output>，输入 123 后失焦会被夹到 100。\n        </span>\n      </DemoSection>\n    </>\n  );\n}\n",
  "html": "<pre class=\"shiki github-light\" style=\"background-color:#fff;color:#24292e\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49\">import</span><span style=\"color:#24292E\"> { createSignal } </span><span style=\"color:#D73A49\">from</span><span style=\"color:#032F62\"> 'solid-js'</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">import</span><span style=\"color:#24292E\"> { InputNumber } </span><span style=\"color:#D73A49\">from</span><span style=\"color:#032F62\"> 'solid-craft'</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">import</span><span style=\"color:#24292E\"> { DemoSection } </span><span style=\"color:#D73A49\">from</span><span style=\"color:#032F62\"> '../../demos/shared'</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">export</span><span style=\"color:#D73A49\"> const</span><span style=\"color:#005CC5\"> demo</span><span style=\"color:#D73A49\"> =</span><span style=\"color:#24292E\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  title: </span><span style=\"color:#032F62\">'精度与格式化'</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  description: </span><span style=\"color:#032F62\">'precision 控制小数位、thousands 展示千分位，以及受控值在失焦时被夹到 max。'</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">};</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">export</span><span style=\"color:#D73A49\"> default</span><span style=\"color:#D73A49\"> function</span><span style=\"color:#6F42C1\"> NumberFormatDemo</span><span style=\"color:#24292E\">() {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">  const</span><span style=\"color:#24292E\"> [</span><span style=\"col