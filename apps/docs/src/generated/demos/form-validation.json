  "path": "packages/core/src/components/form/demos/validation.tsx",
  "source": "import { createSignal } from 'solid-js';\nimport { Button, Form, Input } from 'solid-craft';\nimport { DemoSection } from '../../demos/shared';\n\nexport const demo = {\n  title: '校验规则',\n  description: '必填、长度、正则、类型与自定义规则按数组顺序执行，失败时展示错误并回显结果。',\n};\n\nexport default function ValidationDemo() {\n  const [result, setResult] = createSignal('尚未校验');\n\n  return (\n    <DemoSection title=\"提交时校验\">\n      <Form\n        initialValues={{ username: '', code: '', email: '' }}\n        onFinish={(values) => setResult(`通过 ${JSON.stringify(values)}`)}\n        onFinishFailed={(errors) => setResult(`失败 ${JSON.stringify(errors)}`)}\n      >\n        <Form.Item name=\"username\" label=\"姓名\" rules={[{ required: true, message: '请输入姓名' }]}>\n          <Input placeholder=\"必填\" />\n        </Form.Item>\n        <Form.Item\n          name=\"code\"\n          label=\"编码\"\n          rules={[\n            { required: true, message: '请输入编码' },\n            { pattern: /^[A-Z]{3}$/, message: '需三位大写字母' },\n          ]}\n        >\n          <Input placeholder=\"例如 ABC\" />\n        </Form.Item>\n        <Form.Item name=\"email\" label=\"邮箱\" rules={[{ type: 'email', message: '邮箱格式不正确' }]}>\n          <Input placeholder=\"非必填，填写后校验格式\" />\n        </Form.Item>\n        <Button htmlType=\"submit\">校验并提交</Button>\n      </Form>\n      <span>\n        校验结果：<output>{result()}</output>\n      </span>\n    </DemoSection>\n  );\n}\n",
  "html": "<pre class=\"shiki github-light\" style=\"background-color:#fff;color:#24292e\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49\">import</span><span style=\"color:#24292E\"> { createSignal } </span><span style=\"color:#D73A49\">from</span><span style=\"color:#032F62\"> 'solid-js'</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">import</span><span style=\"color:#24292E\"> { Button, Form, Input } </span><span style=\"color:#D73A49\">from</span><span style=\"color:#032F62\"> 'solid-craft'</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">import</span><span style=\"color:#24292E\"> { DemoSection } </span><span style=\"color:#D73A49\">from</span><span style=\"color:#032F62\"> '../../demos/shared'</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">export</span><span style=\"color:#D73A49\"> const</span><span style=\"color:#005CC5\"> demo</span><span style=\"color:#D73A49\"> =</span><span style=\"color:#24292E\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  title: </span><span style=\"color:#032F62\">'校验规则'</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  description: </span><span style=\"color:#032F62\">'必填、长度、正则、类型与自定义规则按数组顺序执行，失败时展示错误并回显结果。'</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">};</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">export</span><span style=\"color:#D73A49\"> default</span><span style=\"color:#D73A49\"> function</span><span style=\"color:#6F42C1\"> ValidationDemo</span><span style=\"color:#24292E\">() {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">  const</span><span style=\"color:#24292E\"> [</span><span style=\"color:#005CC5\">result</span><span style=\"color:#24292E\">, </span><span style=\"color:#005CC5\">setResult</span><span style=\"color:#24292E\">] </span><span style=\"color:#D73A49\">=</span><span style=\"color:#6F42C1\"> createSignal</span><span style=\"color:#24292E\">(</span><span style=\"color:#032F62\">'尚未校验'</span><span style=\"color:#24292E\">);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">  return</span><span style=\"color:#24292E\"> (</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">    &#x3C;</span><span style=\"color:#005CC5\">DemoSection</span><span style=\"color:#6F42C1\"> title</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"提交时校验\"</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">      &#x3C;</span><span style=\"color:#005CC5\">Form</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">        initialValues</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{{ username: </span><span style=\"color:#032F62\">''</span><span style=\"color:#24292E\">, code: </span><span style=\"color:#032F62\">''</span><span style=\"color:#24292E\">, email: </span><span style=\"color:#032F62\">''</span><span style=\"color:#24292E\"> }}</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">        onFinish</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{(</span><span style=\"color:#E36209\">values</span><span style=\"color:#24292E\">) </span><span style=\"color:#D73A49\">=></span><span style=\"color:#6F42C1\"> setResult</span><span style=\"color:#24292E\">(</span><span style=\"color:#032F62\">`通过 ${</span><span style=\"color:#005CC5\">JSON</span><span style=\"color:#032F62\">.</span><span style=\"color:#6F42C1\">stringify</span><span style=\"color:#032F62\">(</span><span style=\"color:#24292E\">values</span><span style=\"color:#032F62\">)</span><span style=\"colo