">booked</span><span style=\"color:#24292E\">, </span><span style=\"color:#005CC5\">setBooked</span><span style=\"color:#24292E\">] </span><span style=\"color:#D73A49\">=</span><span style=\"color:#6F42C1\"> createSignal</span><span style=\"color:#24292E\">(</span><span style=\"color:#032F62\">'2026-03-16'</span><span style=\"color:#24292E\">);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">  return</span><span style=\"color:#24292E\"> (</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">    &#x3C;></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">      &#x3C;</span><span style=\"color:#005CC5\">DemoSection</span><span style=\"color:#6F42C1\"> title</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"min / max\"</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;</span><span style=\"color:#005CC5\">DatePicker</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">          min</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"2026-03-10\"</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">          max</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"2026-03-20\"</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">          defaultValue</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"2026-03-15\"</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">          aria-label</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"仅 3 月 10 至 20 日\"</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        /></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">      &#x3C;/</span><span style=\"color:#005CC5\">DemoSection</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><