{
  "path": "packages/core/src/components/popconfirm/demos/placement.tsx",
  "source": "import { createSignal } from 'solid-js';\nimport { Button, Popconfirm, type PopconfirmPlacement } from 'solid-craft';\n\nimport { DemoSection } from '../../demos/shared';\n\nexport const demo = {\n  title: '定位与文案覆盖',\n  description:\n    '四向 placement 由 Floating UI 负责翻转；okText / cancelText 与 arrow 开关都只影响展示，不改变异步确认协议。',\n};\n\nconst SIDES: readonly PopconfirmPlacement[] = ['top', 'bottom', 'left', 'right'];\n\nexport default function PopconfirmPlacementDemo() {\n  const [placement, setPlacement] = createSignal<PopconfirmPlacement>('top');\n  const [arrow, setArrow] = createSignal(true);\n\n  return (\n    <>\n      <DemoSection title=\"四向定位\">\n        <div class=\"demo-row\">\n          {SIDES.map((item) => (\n            <Button variant=\"outline\" color=\"neutral\" onClick={() => setPlacement(item)}>\n              {item}\n            </Button>\n          ))}\n        </div>\n        <p>当前方向：{placement()}</p>\n      </DemoSection>\n\n      <DemoSection title=\"自定义文案\">\n        <Popconfirm\n          title=\"确认归档？\"\n          description=\"归档后该计划不再出现在待办列表。\"\n          placement={placement()}\n          arrow={arrow()}\n          okText=\"归档\"\n          cancelText=\"返回\"\n          onOk={() => undefined}\n        >\n          归档计划\n        </Popconfirm>\n        <Button variant=\"outline\" color=\"neutral\" onClick={() => setArrow(!arrow())}>\n          {arrow() ? '隐藏箭头' : '显示箭头'}\n        </Button>\n      </DemoSection>\n    </>\n  );\n}\n",
  "html": "<pre class=\"shiki github-light\" style=\"background-color:#fff;color:#24292e\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49\">import</span><span style=\"color:#24292E\"> { createSignal } </span><span style=\"color:#D73A49\">from</span><span style=\"color:#032F62\"> 'solid-js'</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">import</span><span style=\"color:#24292E\"> { Button, Popconfirm, </span><span style=\"color:#D73A49\">type</span><span style=\"color:#24292E\"> PopconfirmPlacement } </span><span style=\"color:#D73A49\">from</span><span style=\"color:#032F62\"> 'solid-craft'</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">import</span><span style=\"color:#24292E\"> { DemoSection } </span><span style=\"color:#D73A49\">from</span><span style=\"color:#032F62\"> '../../demos/shared'</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">export</span><span style=\"color:#D73A49\"> const</span><span style=\"color:#005CC5\"> demo</span><span style=\"color:#D73A49\"> =</span><span style=\"color:#24292E\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  title: </span><span style=\"color:#032F62\">'定位与文案覆盖'</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  description:</span></span>\n<span class=\"line\"><span style=\"color:#032F62\">    '四向 placement 由 Floating UI 负责翻转；okText / cancelText 与 arrow 开关都只影响展示，不改变异步确认协议。'</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">};</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">const</span><span style=\"color:#005CC5\"> SIDES</span><span style=\"color:#D73A49\">:</span><span style=\"color:#D73A49\"> readonly</span><span style=\"color:#6F42C1\"> PopconfirmPlacement</span><span style=\"color:#24292E\">[] </span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\"> [</span><span style=\"color:#032F62\">'top'</span><span style=\"color:#24292E\">, </span><span style=\"color:#032F62\">'bottom'</span><span style=\"color:#24292E\">, </span><span style=\"color:#032F62\">'left'</span><span style=\"color:#24292E\">, </span><span style=\"color:#032F62\">'right'</span><span style=\"color:#24292E\">];</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">export</span><span style=\"color:#D73A49\"> default</span><span style=\"color:#D73A49\"> function</span><span style=\"color:#6F42C1\"> PopconfirmPlacementDemo</span><span style=\"color:#24292E\">() {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">  const</span><span style=\"color:#24292E\"> [</span><span style=\"color:#005CC5\">placement</span><span style=\"color:#24292E\">, </span><span style=\"color:#005CC5\">setPlacement</span><span style=\"color:#24292E\">] </span><span style=\"color:#D73A49\">=</span><span style=\"color:#6F42C1\"> createSignal</span><span style=\"color:#24292E\">&#x3C;</span><span style=\"color:#6F42C1\">PopconfirmPlacement</span><span style=\"color:#24292E\">>(</span><span style=\"color:#032F62\">'top'</span><span style=\"color:#24292E\">);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">  const</span><span style=\"color:#24292E\"> [</span><span style=\"color:#005CC5\">arrow</span><span style=\"color:#24292E\">, </span><span style=\"color:#005CC5\">setArrow</span><span style=\"color:#24292E\">] </span><span style=\"color:#D73A49\">=</span><span style=\"color:#6F42C1\"> createSignal</span><span style=\"color:#24292E\">(</span><span style=\"color:#005CC5\">true</span><span style=\"color:#24292E\">);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">  return</span><span s