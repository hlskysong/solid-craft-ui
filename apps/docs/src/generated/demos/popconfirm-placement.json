class=\"line\"><span style=\"color:#24292E\">          ))}</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;/</span><span style=\"color:#22863A\">div</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;</span><span style=\"color:#22863A\">p</span><span style=\"color:#24292E\">>当前方向：{</span><span style=\"color:#6F42C1\">placement</span><span style=\"color:#24292E\">()}&#x3C;/</span><span style=\"color:#22863A\">p</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">      &#x3C;/</span><span style=\"color:#005CC5\">DemoSection</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E\">      &#x3C;</span><span style=\"color:#005CC5\">DemoSection</span><span style=\"color:#6F42C1\"> title</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"自定义文案\"</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;</span><span style=\"color:#005CC5\">Popconfirm</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">          title</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"确认归档？\"</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">          description</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"归档后该计划不再出现在待办列表。\"</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">          placement</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{</span><span style=\"color:#6F42C1\">placement</span><span style=\"color:#24292E\">()}</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">          arrow</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{</span><span style=\"color:#6F42C1\">arrow</span><span style=\"color:#24292E\">()}</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">          okText</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"归档\"</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">          cancelText</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"返回\"</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">          onOk</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{() </span><span style=\"color:#D73A49\">=></span><span style=\"color:#005CC5\"> undefined</span><span style=\"color:#24292E\">}</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        ></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">          归档计划</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;/</span><span style=\"color:#005CC5\">Popconfirm</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;</span><span style=\"color:#005CC5\">Button</span><span style=\"color:#6F42C1\"> variant</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"outline\"</span><span style=\"color:#6F42C1\"> color</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"neutral\"</span><span style=\"color:#6F42C1\"> onClick</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{() </span><span style=\"color:#D73A49\">=></span><span style=\"color:#6F42C1\"> setArrow</span><span style=\"color:#24292E\">(</span><span style=\"color:#D73A49\">!</span><span style=\"color:#6F42C1\">arrow</span><span style=\"color:#24292E\">())}></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">          {</span><span style=\"color:#6F42C1\">arrow</span><span style=\"color:#24292E\">() </span><span style=\"color:#D73A49\">?</span><span style=\"color:#032F62\"> '隐藏箭头'</span><span style=\"color:#D73A49\"> :</span><span style=\"color:#032F62\"> '显示箭头'</span><span style=\"color:#24292E\">}</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;/</span><span style=\"color:#005CC5\">Button</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">      &#x3C;/</span><span style=\"color:#005CC5\">DemoSection</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">    &#x3C;/></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  );</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">}</span></span>\n<span class=\"line\"></span></code></pre>"
