span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  { key: </span><span style=\"color:#032F62\">'a'</span><span style=\"color:#24292E\">, label: </span><span style=\"color:#032F62\">'项目编号'</span><span style=\"color:#24292E\">, children: </span><span style=\"color:#032F62\">'WJ-2026-012'</span><span style=\"color:#24292E\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  { key: </span><span style=\"color:#032F62\">'b'</span><span style=\"color:#24292E\">, label: </span><span style=\"color:#032F62\">'申报单位'</span><span style=\"color:#24292E\">, children: </span><span style=\"color:#032F62\">'机电运输部'</span><span style=\"color:#24292E\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  { key: </span><span style=\"color:#032F62\">'c'</span><span style=\"color:#24292E\">, label: </span><span style=\"color:#032F62\">'资金来源'</span><span style=\"color:#24292E\">, children: </span><span style=\"color:#032F62\">'维简费'</span><span style=\"color:#24292E\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  { key: </span><span style=\"color:#032F62\">'d'</span><span style=\"color:#24292E\">, label: </span><span style=\"color:#032F62\">'本次采购金额'</span><span style=\"color:#24292E\">, children: </span><span style=\"color:#032F62\">'148 万元'</span><span style=\"color:#24292E\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  { key: </span><span style=\"color:#032F62\">'e'</span><span style=\"color:#24292E\">, label: </span><span style=\"color:#032F62\">'经办人'</span><span style=\"color:#24292E\">, children: </span><span style=\"color:#032F62\">'宋桂明'</span><span style=\"color:#24292E\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  { key: </span><span style=\"color:#032F62\">'f'</span><span style=\"color:#24292E\">, label: </span><span style=\"color:#032F62\">'当前状态'</span><span style=\"color:#24292E\">, children: </span><span style=\"color:#032F62\">'审批中'</span><span