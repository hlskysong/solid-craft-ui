pan>\n<span class=\"line\"><span style=\"color:#24292E\">];</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">export</span><span style=\"color:#D73A49\"> const</span><span style=\"color:#005CC5\"> demo</span><span style=\"color:#D73A49\"> =</span><span style=\"color:#24292E\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  title: </span><span style=\"color:#032F62\">'单选'</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  description: </span><span style=\"color:#032F62\">'单选模式不渲染全选，选中集合恒为一行，表头保留可访问文案。'</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">};</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">export</span><span style=\"color:#D73A49\"> default</span><span style=\"color:#D73A49\"> function</span><span style=\"color:#6F42C1\"> SelectionRadioDemo</span><span style=\"color:#24292E\">() {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">  const</span><span style=\"color:#24292E\"> [</span><span style=\"color:#005CC5\">picked</span><span style=\"color:#24292E\">, </span><span style=\"color:#005CC5\">setPicked</span><span style=\"color:#24292E\">] </span><span style=\"color:#D73A49\">=</span><span style=\"color:#6F42C1\"> createSignal</span><span style=\"color:#24292E\">&#x3C;</span><span style=\"color:#D73A49\">readonly</span><span style=\"color:#005CC5\"> string</span><span style=\"color:#24292E\">[]>([</span><span style=\"color:#032F62\">'A02'</span><span style=\"color:#24292E\">]);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">  return</span><span style=\"color:#24292E\"> (</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">    &#x3C;</span><span style=\"color:#005CC5\">DemoSection</span><span style=\"color:#6F42C1\"> title</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"单选行\"</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">      &#x3C;</span><span style=\"color:#22863A\">div</span><span style=\"color:#6F42C1\"> class</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"demo-stack\"</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;</span><span style=\"color:#005CC5\">Table</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">          columns</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{columns}</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">          data</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{rows}</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">          rowKey</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"id\"</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">          rowSelection</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{{</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">            type: </span><span style=\"color:#032F62\">'radio'</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">            selectedRowKeys: </span><span style=\"color:#6F42C1\">picked</span><span style=\"color:#24292E\">(),</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">            onChange</span><span style=\"color:#24292E\">: (</span><span style=\"color:#E36209\">next</span><span style=\"color:#24292E\">) </span><span style=\"color:#D73A49\">=></span><span style=\"color:#24292E\"> {</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">              setPicked</span><span style=\"color:#24292E\">(next);</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">            },</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">          }}</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">          aria-label</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"单选行\"</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        /></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;</span><span style=\"color:#22863A\">span</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">          当前选中：&#x3C;</span><span style=\"color:#22863A\">output</span><span style=\"color:#24292E\">>{</span><span style=\"color:#6F42C1\">picked</span><span style=\"color:#24292E\">()[</span><span style=\"color:#005CC5\">0</span><span style=\"color:#24292E\">] </span><span style=\"color:#D73A49\">??</span><span style=\"color:#032F62\"> '未选择'</span><span style=\"color:#24292E\">}&#x3C;/</span><span style=\"color:#22863A\">output</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;/</span><span style=\"color:#22863A\">span</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">      &#x3C;/</span><span style=\"color:#22863A\">div</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">    &#x3C;/</span><span style=\"color:#005CC5\">DemoSection</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  );</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">}</span></span>\n<span class=\"line\"></span></code></pre>"
