  "source": "import { createSignal } from 'solid-js';\nimport { Table } from 'solid-craft';\nimport type { TableColumn } from 'solid-craft';\nimport { DemoSection } from '../../demos/shared';\n\ninterface Row {\n  id: string;\n  name: string;\n  department: string;\n  years: number;\n}\n\nconst columns: TableColumn<Row>[] = [\n  { title: '工号', dataIndex: 'id', width: 96 },\n  { title: '姓名', dataIndex: 'name', width: 120 },\n  { title: '部门', dataIndex: 'department' },\n  { title: '年限', dataIndex: 'years', align: 'right' },\n];\n\nconst rows: Row[] = [\n  { id: 'A01', name: '张伟', department: '研发', years: 6 },\n  { id: 'A02', name: '李娜', department: '设计', years: 4 },\n  { id: 'A03', name: '王强', department: '测试', years: 3 },\n  { id: 'A04', name: '赵敏', department: '运维', years: 2 },\n];\n\nexport const demo = {\n  title: '单选',\n  description: '单选模式不渲染全选，选中集合恒为一行，表头保留可访问文案。',\n};\n\nexport default function SelectionRadioDemo() {\n  const [picked, setPicked] = createSignal<readonly string[]>(['A02']);\n\n  return (\n    <DemoSection title=\"单选行\">\n      <div class=\"demo-stack\">\n        <Table\n          columns={columns}\n          data={rows}\n          rowKey=\"id\"\n          rowSelection={{\n            type: 'radio',\n            selectedRowKeys: picked(),\n            onChange: (next) => {\n              setPicked(next);\n            },\n          }}\n          aria-label=\"单选行\"\n        />\n        <span>\n          当前选中：<output>{picked()[0] ?? '未选择'}</output>\n        </span>\n      </div>\n    </DemoSection>\n  );\n}\n",
  "html": "<pre class=\"shiki github-light\" style=\"background-color:#fff;color:#24292e\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49\">import</span><span style=\"color:#24292E\"> { createSignal } </span><span style=\"color:#D73A49\">from</span><span style=\"color:#032F62\"> 'solid-js'</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">import</span><span style=\"color:#24292E\"> { Table } </span><span style=\"color:#D73A49\">from</span><span style=\"color:#032F62\"> 'solid-craft'</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">import</span><span style=\"color:#D73A49\"> type</span><span style=\"color:#24292E\"> { TableColumn } </span><span style=\"color:#D73A49\">from</span><span style=\"color:#032F62\"> 'solid-craft'</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">import</span><span style=\"color:#24292E\"> { DemoSection } </span><span style=\"color:#D73A49\">from</span><span style=\"color:#032F62\"> '../../demos/shared'</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">interface</span><span style=\"color:#6F42C1\"> Row</span><span style=\"color:#24292E\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209\">  id</span><span style=\"color:#D73A49\">:</span><span style=\"color:#005CC5\"> string</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209\">  name</span><span style=\"color:#D73A49\">:</span><span style=\"color:#005CC5\"> string</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209\">  department</span><span style=\"color:#D73A49\">:</span><span style=\"color:#005CC5\"> string</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209\">  years</span><span style=\"color:#D73A49\">:</span><span style=\"color:#005CC5\"> number</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">const</span><span style=\"color:#005CC5\"> columns</span><span style=\"color:#D73A49\">:</span><span style=\"color:#6F42C1\"> TableColumn</span><span style=\"color:#24292E\">&#x3C;</span><span style=\"color:#6F42C1\">Row</span><span style=\"color:#24292E\">>[] </span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\"> [</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  { title: </span><span style=\"color:#032F62\">'工号'</span><span style=\"color:#24292E\">, dataIndex: </span><span style=\"color:#032F62\">'id'</span><span style=\"color:#24292E\">, width: </span><span style=\"color:#005CC5\">96</span><span style=\"color:#24292E\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  { title: </span><span style=\"color:#032F62\">'姓名'</span><span style=\"color:#24292E\">, dataIndex: </span><span style=\"color:#032F62\">'name'</span><span style=\"color:#24292E\">, width: </span><span style=\"color:#005CC5\">120</span><span style=\"color:#24292E\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  { title: </span><span style=\"color:#032F62\">'部门'</span><span style=\"color:#24292E\">, dataIndex: </span><span style=\"color:#032F62\">'department'</span><span style=\"color:#24292E\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  { title: </span><span style=\"color:#032F62\">'年限'</span><span style=\"color:#24292E\">, dataIndex: </span><span style=\"color:#032F62\">'years'</span><span style=\"color:#24292E\">, align: </span><span style=\"color:#032F62\">'right'</span><span style=\"color:#24292E\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">];</span></span>\n<span clas