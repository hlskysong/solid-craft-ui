pan style=\"color:#24292E\">}</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">      &#x3C;</span><span style=\"color:#005CC5\">DemoSection</span><span style=\"color:#6F42C1\"> title</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"骨架与真实内容同高\"</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;</span><span style=\"color:#22863A\">div</span><span style=\"color:#6F42C1\"> class</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"demo-row\"</span><span style=\"color:#6F42C1\"> style</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"align-items: flex-start; gap: 24px\"</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">          &#x3C;</span><span style=\"color:#22863A\">div</span><span style=\"color:#6F42C1\"> data-testid</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"skeleton-column\"</span><span style=\"color:#6F42C1\"> style</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"flex: 1 1 200px\"</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">            &#x3C;</span><span style=\"color:#005CC5\">Skeleton</span><span style=\"color:#6F42C1\"> rows</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{</span><span style=\"color:#005CC5\">3</span><span style=\"color:#24292E\">} /></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">          &#x3C;/</span><span style=\"color:#22863A\">div</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">          &#x3C;</span><span style=\"color:#22863A\">div</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">            data-testid</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"text-column\"</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">            style</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"flex: 1 1 200px; font-size: var(--scui-font-size-md); line-height: var(--scui-line-height-md)\"</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">          ></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">            &#x3C;</span><span style=\"color:#22863A\">div</span><span style=\"color:#24292E\">>维简设备采购计划&#x3C;/</span><span style=\"color:#22863A\">div</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">            &#x3C;</span><span style=\"color:#22863A\">div</span><span style=\"color:#24292E\">>维简设备采购计划&#x3C;/</span><span style=\"color:#22863A\">div</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">            &#x3C;</span><span style=\"color:#22863A\">div</span><span style=\"color:#24292E\">>维简设备采购计划&#x3C;/</span><span style=\"color:#22863A\">div</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">          &#x3C;/</span><span style=\"color:#22863A\">div</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;/</span><span style=\"color:#22863A\">div</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">      &#x3C;/</span><span style=\"color:#005CC5\">DemoSection</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">    &#x3C;/></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  );</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">}</span></span>\n<span class=\"line\"></span></code></pre>"
