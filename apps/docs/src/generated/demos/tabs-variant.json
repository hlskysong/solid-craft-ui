  "source": "import { createSignal } from 'solid-js';\nimport { Button, Tabs, type TabsVariant } from 'solid-craft';\n\nimport { DemoSection } from '../../demos/shared';\n\nexport const demo = {\n  title: '线型与卡片',\n  description:\n    '两档样式都由 data-scui-variant 表达（AGENTS 硬约束 3 把「变体」指派给该属性），激活态复用 data-scui-current。切换按钮验证属性与样式同步生效。',\n};\n\nconst items = [\n  { key: 'one', label: '基本信息', content: () => <div>项目编号：WJ-2026-012</div> },\n  { key: 'two', label: '资金计划', content: () => <div>本次采购金额：148 万元</div> },\n  { key: 'three', label: '附件', content: () => <div>共 3 份附件，待补充签字页。</div> },\n];\n\nexport default function TabsVariantDemo() {\n  const [variant, setVariant] = createSignal<TabsVariant>('line');\n\n  return (\n    <DemoSection title=\"线型 / 卡片\">\n      <div class=\"demo-column\">\n        <Button\n          variant=\"outline\"\n          size=\"small\"\n          onClick={() => setVariant(variant() === 'line' ? 'card' : 'line')}\n        >\n          切换样式\n        </Button>\n        <p data-testid=\"tabs-variant-log\">当前样式：{variant() === 'line' ? '线型' : '卡片'}</p>\n        <Tabs items={items} variant=\"line\" aria-label=\"线型标签页\" data-testid=\"tabs-line\" />\n        <Tabs items={items} variant=\"card\" aria-label=\"卡片标签页\" data-testid=\"tabs-card\" />\n        <Tabs items={items} variant={variant()} aria-label=\"可切换标签页\" />\n      </div>\n    </DemoSection>\n  );\n}\n",
  "html": "<pre class=\"shiki github-light\" style=\"background-color:#fff;color:#24292e\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49\">import</span><span style=\"color:#24292E\"> { createSignal } </span><span style=\"color:#D73A49\">from</span><span style=\"color:#032F62\"> 'solid-js'</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">import</span><span style=\"color:#24292E\"> { Button, Tabs, </span><span style=\"color:#D73A49\">type</span><span style=\"color:#24292E\"> TabsVariant } </span><span style=\"color:#D73A49\">from</span><span style=\"color:#032F62\"> 'solid-craft'</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">import</span><span style=\"color:#24292E\"> { DemoSection } </span><span style=\"color:#D73A49\">from</span><span style=\"color:#032F62\"> '../../demos/shared'</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">export</span><span style=\"color:#D73A49\"> const</span><span style=\"color:#005CC5\"> demo</span><span style=\"color:#D73A49\"> =</span><span style=\"color:#24292E\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  title: </span><span style=\"color:#032F62\">'线型与卡片'</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  description:</span></span>\n<span class=\"line\"><span style=\"color:#032F62\">    '两档样式都由 data-scui-variant 表达（AGENTS 硬约束 3 把「变体」指派给该属性），激活态复用 data-scui-current。切换按钮验证属性与样式同步生效。'</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">};</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">const</span><span style=\"color:#005CC5\"> items</span><span style=\"color:#D73A49\"> =</span><span style=\"color:#24292E\"> [</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  { key: </span><span style=\"color:#032F62\">'one'</span><span style=\"color:#24292E\">, label: </span><span style=\"color:#032F62\">'基本信息'</span><span style=\"color:#24292E\">, </span><span style=\"color:#6F42C1\">content</span><span style=\"color:#24292E\">: () </span><span style=\"color:#D73A49\">=></span><span style=\"color:#24292E\"> &#x3C;</span><span style=\"color:#22863A\">div</span><span style=\"color:#24292E\">>项目编号：WJ-2026-012&#x3C;/</span><span style=\"color:#22863A\">div</span><span style=\"color:#24292E\">> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  { key: </span><span style=\"color:#032F62\">'two'</span><span style=\"color:#24292E\">, label: </span><span style=\"color:#032F62\">'资金计划'</span><span style=\"color:#24292E\">, </span><span style=\"color:#6F42C1\">content</span><span style=\"color:#24292E\">: () </span><span style=\"color:#D73A49\">=></span><span style=\"color:#24292E\"> &#x3C;</span><span style=\"color:#22863A\">div</span><span style=\"color:#24292E\">>本次采购金额：148 万元&#x3C;/</span><span style=\"color:#22863A\">div</span><span style=\"color:#24292E\">> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  { key: </span><span style=\"color:#032F62\">'three'</span><span style=\"color:#24292E\">, label: </span><span style=\"color:#032F62\">'附件'</span><span style=\"color:#24292E\">, </span><span style=\"color:#6F42C1\">content</span><span style=\"color:#24292E\">: () </span><span style=\"color:#D73A49\">=></span><span style=\"color:#24292E\"> &#x3C;</span><span style=\"color:#22863A\">div</span><span style=\"color:#24292E\">>共 3 份附件，待补充签字页。&#x3C;/</span><span style=\"color:#22863A\">div</span><span style=\"color:#24292E\">> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">];</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">export</span><span style=\"color:#D73A49\"> defaul