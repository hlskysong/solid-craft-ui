span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{() </span><span style=\"color:#D73A49\">=></span><span style=\"color:#6F42C1\"> setVariant</span><span style=\"color:#24292E\">(</span><span style=\"color:#6F42C1\">variant</span><span style=\"color:#24292E\">() </span><span style=\"color:#D73A49\">===</span><span style=\"color:#032F62\"> 'line'</span><span style=\"color:#D73A49\"> ?</span><span style=\"color:#032F62\"> 'card'</span><span style=\"color:#D73A49\"> :</span><span style=\"color:#032F62\"> 'line'</span><span style=\"color:#24292E\">)}</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        ></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">          切换样式</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;/</span><span style=\"color:#005CC5\">Button</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;</span><span style=\"color:#22863A\">p</span><span style=\"color:#6F42C1\"> data-testid</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"tabs-variant-log\"</span><span style=\"color:#24292E\">>当前样式：{</span><span style=\"color:#6F42C1\">variant</span><span style=\"color:#24292E\">() </span><span style=\"color:#D73A49\">===</span><span style=\"color:#032F62\"> 'line'</span><span style=\"color:#D73A49\"> ?</span><span style=\"color:#032F62\"> '线型'</span><span style=\"color:#D73A49\"> :</span><span style=\"color:#032F62\"> '卡片'</span><span style=\"color:#24292E\">}&#x3C;/</span><span style=\"color:#22863A\">p</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;</span><span style=\"color:#005CC5\">Tabs</span><span style=\"color:#6F42C1\"> items</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{items} </span><span style=\"color:#6F42C1\">variant</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"line\"</span><span style=\"color:#6F42C1\"> aria-label</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"线型标签页\"</span><span style=\"color:#6F42C1\"> data-testid</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"tabs-line\"</span><span style=\"color:#24292E\"> /></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;</span><span style=\"color:#005CC5\">Tabs</span><span style=\"color:#6F42C1\"> items</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{items} </span><span style=\"color:#6F42C1\">variant</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"card\"</span><span style=\"color:#6F42C1\"> aria-label</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"卡片标签页\"</span><span style=\"color:#6F42C1\"> data-testid</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"tabs-card\"</span><span style=\"color:#24292E\"> /></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;</span><span style=\"color:#005CC5\">Tabs</span><span style=\"color:#6F42C1\"> items</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{items} </span><span style=\"color:#6F42C1\">variant</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{</span><span style=\"color:#6F42C1\">variant</span><span style=\"color:#24292E\">()} </span><span style=\"color:#6F42C1\">aria-label</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"可切换标签页\"</span><span style=\"color:#24292E\"> /></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">      &#x3C;/</span><span style=\"color:#22863A\">div</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">    &#x3C;/</span><span style=\"color:#005CC5\">DemoSection</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  );</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">}</span></span>\n<span class=\"line\"></span></code></pre>"
