  "source": "import { Divider, Text } from 'solid-craft';\nimport { DemoSection } from '../../demos/shared';\n\nexport const demo = {\n  title: '基础用法',\n  description: '水平 / 垂直分割线、虚线与带文字分割。',\n};\n\nexport default function Basic() {\n  return (\n    <>\n      <DemoSection title=\"水平分割线\">\n        <div class=\"demo-stack\">\n          <Text>上方内容</Text>\n          <Divider />\n          <Text>下方内容</Text>\n          <Divider dashed>虚线分割</Divider>\n          <Divider plain>带文字分割</Divider>\n        </div>\n      </DemoSection>\n      <DemoSection title=\"垂直分割线\">\n        <div class=\"demo-inline\">\n          <Text>左</Text>\n          <Divider orientation=\"vertical\" />\n          <Text>中</Text>\n          <Divider orientation=\"vertical\" dashed />\n          <Text>右</Text>\n        </div>\n      </DemoSection>\n    </>\n  );\n}\n",
