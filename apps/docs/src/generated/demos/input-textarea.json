  "path": "packages/core/src/components/input/demos/textarea.tsx",
  "source": "import { createSignal } from 'solid-js';\nimport { Textarea } from 'solid-craft';\nimport { DemoSection } from '../../demos/shared';\n\nexport const demo = {\n  title: '多行输入',\n  description: '自动高度（true 与 minRows / maxRows 两种口径）、字数统计、清除按钮与禁用态。',\n};\n\nexport default function TextareaDemo() {\n  const [remark, setRemark] = createSignal('这段文字由 createSignal 驱动，可以继续输入。');\n  const [limited, setLimited] = createSignal('');\n\n  const limit = 50;\n\n  return (\n    <>\n      <DemoSection title=\"自动高度（true）\">\n        <Textarea\n          autoSize\n          aria-label=\"备注内容\"\n          defaultValue={'第一行\\n第二行\\n第三行'}\n          placeholder=\"内容增多时会自动撑高，不封顶\"\n        />\n      </DemoSection>\n\n      <DemoSection title=\"自动高度（minRows / maxRows）\">\n        <Textarea\n          autoSize={{ minRows: 3, maxRows: 6 }}\n          aria-label=\"多行备注\"\n          defaultValue={'最少显示 3 行，最多 6 行，超出后内部滚动。\\n可以继续输入观察高度变化。'}\n          placeholder=\"行数在 3 到 6 之间伸缩\"\n        />\n        <Textarea\n          autoSize={{ minRows: 2, maxRows: 4 }}\n          disabled\n          aria-label=\"禁用态多行输入\"\n          defaultValue=\"禁用态不参与交互\"\n        />\n      </DemoSection>\n\n      <DemoSection title=\"字数统计与上限\">\n        <Textarea\n          showCount\n          maxLength={limit}\n          aria-label=\"受限备注\"\n          value={limited()}\n          onChange={(value) => setLimited(value)}\n          placeholder=\"最多输入 50 个字\"\n        />\n        <Textarea\n          showCount\n          aria-label=\"无上限备注\"\n          defaultValue=\"不传 maxLength 时只显示已输入字数，不显示上限。\"\n          placeholder=\"展示已输入字数\"\n        />\n      </DemoSection>\n\n      <DemoSection title=\"允许清除\">\n        <Textarea\n          allowClear\n          aria-label=\"可清除备注\"\n          defaultValue=\"有值时右下角出现清除按钮。\"\n          placeholder=\"试试清空\"\n        />\n        <Textarea\n          allowClear\n          showCount\n          maxLength={80}\n          aria-label=\"清除与统计\"\n          value={remark()}\n          onChange={(value) => setRemark(value)}\n          placeholder=\"清除与统计可以同时出现\"\n        />\n      </DemoSection>\n\n      <DemoSection title=\"禁用\">\n        <Textarea\n          disabled\n          aria-label=\"禁用的多行输入\"\n          defaultValue=\"禁用状态下不可编辑，也不出现清除按钮。\"\n        />\n        <Textarea\n          showCount\n          maxLength={40}\n          disabled\n          aria-label=\"禁用但计数的多行输入\"\n          defaultValue=\"禁用但保留字数统计。\"\n        />\n      </DemoSection>\n    </>\n  );\n}\n",
  "html": "<pre class=\"shiki github-light\" style=\"background-color:#fff;color:#24292e\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49\">import</span><span style=\"color:#24292E\"> { createSignal } </span><span style=\"color:#D73A49\">from</span><span style=\"color:#032F62\"> 'solid-js'</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">import</span><span style=\"color:#24292E\"> { Textarea } </span><span style=\"color:#D73A49\">from</span><span style=\"color:#032F62\"> 'solid-craft'</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">import</span><span style=\"color:#24292E\"> { DemoSection } </span><span style=\"color:#D73A49\">from</span><span style=\"color:#032F62\"> '../../demos/shared'</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">export</span><span style=\"color:#D73A49\"> const</span><span style=\"color:#005CC5\"> demo</span><span style=\"color:#D73A49\"> =</span><span style=\"color:#24292E\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  title: </span><span style=\"color:#032F62\">'多行输入'</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  description: </span><span style=\"color:#032F62\">'自动高度（true 与 minRows / maxRows 两种口径）、字数统计、清除按钮与禁用态。'</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">};</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">export</span><span style=\"color:#D73A49\"> default</span><span style=\"color:#D73A49\"> function</span><span style=\"color:#6F42C1\"> TextareaDemo</span><span style=\"color:#24292E\">() {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">  const</span><span style=\"color:#24292E\"> [</span><span style=\"color:#005C