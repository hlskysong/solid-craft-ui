{
  "path": "packages/core/src/components/upload/demos/basic.tsx",
  "source": "import { createSignal } from 'solid-js';\nimport { Upload, type UploadChangeInfo, type UploadFile } from 'solid-craft';\n\nimport { DemoSection } from '../../demos/shared';\n\nexport const demo = {\n  title: '点击 / 拖拽与上传前校验',\n  description:\n    '原生 input[type=file] 与 HTML5 拖拽共用同一个入口；accept / maxSize / maxCount / beforeUpload 的拒绝结果以 error 状态留在列表里说明原因，不静默丢弃。受控 fileList 演示「只发事件、DOM 不回弹」。',\n};\n\n// 静态初始数据：视觉基线截的是这一帧，不依赖网络与定时器。\nconst initial: UploadFile[] = [\n  { uid: 'basic-1', name: '设备清单.pdf', size: 24576, status: 'done', percent: 100 },\n  { uid: 'basic-2', name: '采购依据.docx', size: 12288, status: 'done', percent: 100 },\n];\nconst locked: UploadFile[] = [\n  { uid: 'locked-1', name: '受控文件.pdf', size: 4096, status: 'done', percent: 100 },\n];\n\nexport default function UploadBasicDemo() {\n  const [count, setCount] = createSignal(initial.length);\n  const [log, setLog] = createSignal('尚未操作');\n\n  return (\n    <DemoSection title=\"基础用法\">\n      <div class=\"demo-column\">\n        <Upload\n          accept=\".pdf,.docx\"\n          maxSize={2 * 1024 * 1024}\n          defaultFileList={initial}\n          aria-label=\"采购附件上传\"\n          data-testid=\"upload-basic\"\n          onChange={(fileList: UploadFile[], info: UploadChangeInfo) => {\n            setCount(fileList.length);\n            setLog(`${info.file.name}：${info.file.status}`);\n          }}\n        >\n          点击选择，或拖拽 PDF / DOCX 到此处\n        </Upload>\n        <p data-testid=\"upload-basic-count\">当前 {count()} 个文件</p>\n        <p data-testid=\"upload-basic-log\">{log()}</p>\n        <h3>受控 fileList：点击删除只发事件，列表不自行回弹</h3>\n        <Upload\n          fileList={locked}\n          aria-label=\"受控上传\"\n          data-testid=\"upload-controlled\"\n          onChange={(fileList: UploadFile[]) => setLog(`受控收到 ${fileList.length} 项`)}\n        />\n      </div>\n    </DemoSection>\n  );\n}\n",
  "html": "<pre class=\"shiki github-light\" style=\"background-color:#fff;color:#24292e\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49\">import</span><span style=\"color:#24292E\"> { createSignal } </span><span style=\"color:#D73A49\">from</span><span style=\"color:#032F62\"> 'solid-js'</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">import</span><span style=\"color:#24292E\"> { Upload, </span><span style=\"color:#D73A49\">type</span><span style=\"color:#24292E\"> UploadChangeInfo, </span><span style=\"color:#D73A49\">type</span><span style=\"color:#24292E\"> UploadFile } </span><span style=\"color:#D73A49\">from</span><span style=\"color:#032F62\"> 'solid-craft'</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">import</span><span style=\"color:#24292E\"> { DemoSection } </span><span style=\"color:#D73A49\">from</span><span style=\"color:#032F62\"> '../../demos/shared'</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">export</span><span style=\"color:#D73A49\"> const</span><span style=\"color:#005CC5\"> demo</span><span style=\"color:#D73A49\"> =</span><span style=\"color:#24292E\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  title: </span><span style=\"color:#032F62\">'点击 / 拖拽与上传前校验'</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  description:</span></span>\n<span class=\"line\"><span style=\"color:#032F62\">    '原生 input[type=file] 与 HTML5 拖拽共用同一个入口；accept / maxSize / maxCount / beforeUpload 的拒绝结果以 error 状态留在列表里说明原因，不静默丢弃。受控 fileList 演示「只发事件、DOM 不回弹」。'</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">};</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D\">// 静态初始数据：视觉基线截的是这一帧，不依赖网络与定时器。</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">const</span><span style=\"color:#005CC5\"> initial</span><span style=\"color:#D73A49\">:</span><span style=\"color:#6F42C1\"> UploadFile</span><span style=\"color:#24292E\">[] </span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\"> [</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  { uid: </span><span style=\"color:#032F62\">'basic-1'</span><span style=\"color:#24292E\">, name: </span><span style=\"color:#032F62\">'设备清单.pdf'</span><span style=\"color:#24292E\">, size: </span><span style=\"color:#005CC5\">24576</span><span style=\"color:#24292E\">, status: </span><span style=\"color:#032F62\">'done'</span><span style=\"color:#24292E\">, percent: </span><span style=\"color:#005CC5\">100</span><span style=\"color:#24292E\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  { uid: </span><span style=\"color:#032F62\">'basic-2'</span><span style=\"color:#24292E\">, name: </span><span style=\"color:#032F62\">'采购依据.docx'</span><span style=\"color:#24292E\">, size: </span><span style=\"color:#005CC5\">12288</span><span style=\"color:#24292E\">, status: </span><span style=\"color:#032F62\">'done'</span><span style=\"color:#24292E\">, percent: </span><span style=\"color:#005CC5\">100</span><span style=\"color:#24292E\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">];</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">const</span><span style=\"color:#005CC5\"> locked</span><span style=\"color:#D73A49\">:</span><span style=\"color:#6F42C1\"> UploadFile</span><span style=\"color:#24292E\">[] </span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\"> [</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  { uid: </span><span style=\"color:#032F62\">'locked-1'</span><span style=\"color:#24292E\">, name: </span><span style=\"color:#032F62\">'受控文件.pdf'</span><span style=\"color:#24292E\">, size: </span><span style=\"color:#005CC5\">4096</span><span style=\"color:#24292E\">, status: </span><span style=\"color:#032F62\">'done'</span><span style=\"color:#24292E\">, percent: </span><span style=\"color:#005CC5\">100</span><span style=\"color:#24292E\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">];</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">export</span><span style=\"color:#D73A49\"> default</span><span style=\"color:#D73A49\"> function</span><span style=\"color:#6F42C1\"> UploadBasicDemo</span><span style=\"color:#24292E\">() {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">  const</span><span style=\"color:#24292E\"> [</span><span style=\"color:#005CC5\">count</span><span style=\"color:#24292E\">, </span><span style=\"color:#005CC5\">setCount</span><span style=\"color:#24292E\">] </span><span style=\"color:#D73A49\">=</span><span style=\"color:#6F42C1\"> createSignal</span><span style=\"color:#24292E\">(initial.</span><span style=\"color:#005CC5\">length</span><span style=\"color:#24292E\">);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">  const</span><span style=\"color:#24292E\"> [</span><span style=\"color:#005CC5\">log</span><span style=\"color:#24292E\">, </span><span style=\"color:#005CC5\">setLog</span><span style=\"color:#24292E\">] </span><span style=\"color:#D73A49\">=</span><span style=\"color:#6F42C1\"> createSignal</span><span style=\"color:#24292E\">(</span><span style=\"color:#032F62\">'尚未操作'</span><span style=\"color:#24292E\">);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">  return</span><span style=\"color:#24292E\"> (</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">    &#x3C;</span><span style=\"color:#005CC5\">DemoSection</span><span style=\"color:#6F42C1\"> title</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"基础用法\"</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">      &#x3C;</span><span style=\"color:#22863A\">div</span><span style=\"color:#6F42C1\"> class</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"demo-column\"</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;</span><span style=\"color:#005CC5\">Upload</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">          accept</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\".pdf,.docx\"</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">          maxSize</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{</span><span style=\"color:#005CC5\">2</span><span style=\"color:#D73A49\"> *</span><span style=\"color:#005CC5\"> 1024</span><span style=\"color:#D73A49\"> *</span><span style=\"color:#005CC5\"> 1024</span><span style=\"color:#24292E\">}</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">          defaultFileList</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{initial}</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">          aria-label</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"采购附件上传\"</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">          data-testid</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"upload-basic\"</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">          onChange</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{(</span><span style=\"color:#E36209\">fileList</span><span style=\"color:#D73A49\">:</span><span style=\"color:#6F42C1\"> UploadFile</span><span style=\"color:#24292E\">[], </span><span style=\"color:#E36209\">info</span><span style=\"color:#D73A49\">:</span><span style=\"color:#6F42C1\"> UploadChangeInfo</span><span style=\"color:#24292E\">) </span><span style=\"color:#D73A49\">=></span><span style=\"color:#24292E\"> {</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">            setCount</span><span style=\"color:#24292E\">(fileList.</span><span style=\"color:#005CC5\">length</span><span style=\"color:#24292E\">);</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">            setLog</span><span style=\"color:#24292E\">(</span><span style=\"color:#032F62\">`${</span><span style=\"color:#24292E\">info</span><span style=\"color:#032F62\">.</span><span style=\"color:#24292E\">file</span><span style=\"color:#032F62\">.</span><span style=\"color:#24292E\">name</span><span style=\"color:#032F62\">}：${</span><span style=\"color:#24292E\">info</span><span style=\"color:#032F62\">.</span><span style=\"color:#24292E\">file</span><span style=\"color:#032F62\">.</span><span style=\"color:#24292E\">status</span><span style=\"color:#032F62\">}`</span><span style=\"color:#24292E\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">          }}</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        ></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">          点击选择，或拖拽 PDF / DOCX 到此处</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;/</span><span style=\"color:#005CC5\">Upload</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;</span><span style=\"color:#22863A\">p</span><span style=\"color:#6F42C1\"> data-testid</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"upload-basic-count\"</span><span style=\"color:#24292E\">>当前 {</span><span style=\"color:#6F42C1\">count</span><span style=\"color:#24292E\">()} 个文件&#x3C;/</span><span style=\"color:#22863A\">p</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;</span><span style=\"color:#22863A\">p</span><span style=\"color:#6F42C1\"> data-testid</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"upload-basic-log\"</span><span style=\"color:#24292E\">>{</span><span style=\"color:#6F42C1\">log</span><span style=\"color:#24292E\">()}&#x3C;/</span><span style=\"color:#22863A\">p</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;</span><span style=\"color:#22863A\">h3</span><span style=\"color:#24292E\">>受控 fileList：点击删除只发事件，列表不自行回弹&#x3C;/</span><span style=\"color:#22863A\">h3</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;</span><span style=\"color:#005CC5\">Upload</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">          fileList</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{locked}</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">          aria-label</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"受控上传\"</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">          data-testid</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"upload-controlled\"</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">          onChange</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{(</span><span style=\"color:#E36209\">fileList</span><span style=\"color:#D73A49\">:</span><span style=\"color:#6F42C1\"> UploadFile</span><span style=\"color:#24292E\">[]) </span><span style=\"color:#D73A49\">=></span><span style=\"color:#6F42C1\"> setLog</span><span style=\"color:#24292E\">(</span><span style=\"color:#032F62\">`受控收到 ${</span><span style=\"color:#24292E\">fileList</span><span style=\"color:#032F62\">.</span><span style=\"color:#005CC5\">length</span><span style=\"color:#032F62\">} 项`</span><span style=\"color:#24292E\">)}</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        /></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">      &#x3C;/</span><span style=\"color:#22863A\">div</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">    &#x3C;/</span><span style=\"color:#005CC5\">DemoSection</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  );</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">}</span></span>\n<span class=\"line\"></span></code></pre>"
}
