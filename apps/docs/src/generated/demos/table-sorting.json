  "source": "import { createSignal } from 'solid-js';\nimport { Table } from 'solid-craft';\nimport type { TableChange, TableColumn, TableSorter } from 'solid-craft';\nimport { DemoSection } from '../../demos/shared';\n\ninterface Row {\n  id: string;\n  name: string;\n  department: string;\n  years: number;\n}\n\nconst columns: TableColumn<Row>[] = [\n  { title: '工号', dataIndex: 'id', width: 96 },\n  { title: '姓名', dataIndex: 'name', width: 120 },\n  { title: '部门', dataIndex: 'department', sorter: true },\n  { title: '年限', dataIndex: 'years', sorter: true },\n];\n\nconst rows: Row[] = [\n  { id: 'A01', name: '张伟', department: '研发', years: 6 },\n  { id: 'A02', name: '李娜', department: '设计', years: 4 },\n  { id: 'A03', name: '王强', department: '测试', years: 3 },\n  { id: 'A04', name: '赵敏', department: '运维', years: 2 },\n];\n\nexport const demo = {\n  title: '排序',\n  description: '单列三态循环、多列累加与受控回写；每次变更都从同一个 onChange 出口带出完整状态。',\n};\n\nexport default function SortingDemo() {\n  const [controlled, setControlled] = createSignal<TableSorter>([]);\n  const [label, setLabel] = createSignal('不排序');\n\n  const onChange = (change: TableChange): void => {\n    setControlled(change.sorter);\n    setLabel(\n      change.sorter.length === 0\n        ? '不排序'\n        : change.sorter.map((item) => `${item.columnKey} ${item.direction}`).join('、'),\n    );\n  };\n\n  return (\n    <DemoSection title=\"排序\">\n      <div class=\"demo-stack\">\n        <Table columns={columns} data={rows} rowKey=\"id\" aria-label=\"非受控单列排序\" />\n        <Table\n          columns={columns}\n          data={rows}\n          rowKey=\"id\"\n          defaultSorter={[{ columnKey: 'department', direction: 'asc' }]}\n          multipleSorters\n          aria-label=\"非受控多列排序\"\n        />\n        <Table\n          columns={columns}\n          data={rows}\n          rowKey=\"id\"\n          sorter={controlled()}\n          onChange={onChange}\n          aria-label=\"受控排序\"\n        />\n        <span>\n          当前排序：<output>{label()}</output>\n        </span>\n      </div>\n    </DemoSection>\n  );\n}\n",
  "html": "<pre class=\"shiki github-light\" style=\"background-color:#fff;color:#24292e\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49\">import</span><span style=\"color:#24292E\"> { createSignal } </span><span style=\"color:#D73A49\">from</span><span style=\"color:#032F62\"> 'solid-js'</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">import</span><span style=\"color:#24292E\"> { Table } </span><span style=\"color:#D73A49\">from</span><span style=\"color:#032F62\"> 'solid-craft'</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">import</span><span style=\"color:#D73A49\"> type</span><span style=\"color:#24292E\"> { TableChange, TableColumn, TableSorter } </span><span style=\"color:#D73A49\">from</span><span style=\"color:#032F62\"> 'solid-craft'</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">import</span><span style=\"color:#24292E\"> { DemoSection } </span><span style=\"color:#D73A49\">from</span><span style=\"color:#032F62\"> '../../demos/shared'</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">interface</span><span style=\"color:#6F42C1\"> Row</span><span style=\"color:#24292E\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209\">  id</span><span style=\"color:#D73A49\">:</span><span style=\"color:#005CC5\"> string</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209\">  name</span><span style=\"color:#D73A49\">:</span><span style=\"color:#005CC5\"> string</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209\">  department</span><span style=\"color:#D73A49\">:</span><span style=\"color:#005CC5\"> string</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209\">  years</span><span style=\"color:#D73A49\">:</span><span style=\"color:#005CC5\"> number</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">const</span><span style=\"color:#005CC5\"> columns</span><span style=\"color:#D73A49\">:</span><span style=\"color:#6F42C1\"> TableColumn</span><span style=\"color:#24292E\">&#x3C;</span><span style=\"color:#6F42C1\">Row</span><span style=\"color:#24292E\">>[] </span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\"> [</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  { title: </span><span style=\"color:#032F62\">'工号'</span><span style=\"color:#24292E\">, dataIndex: </span><span style=\"color:#032F62\">'id'</span><span style=\"color:#24292E\">, width: </span><span style=\"color:#005CC5\">96</span><span style=\"color:#24292E\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  { title: </span><span style=\"color:#032F62\">'姓名'</span><span style=\"color:#24292E\">, dataIndex: </span><span style=\"color:#032F62\">'name'</span><span style=\"color:#24292E\">, width: </span><span style=\"color:#005CC5\">120</span><span style=\"color:#24292E\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  { title: </span><span style=\"color:#032F62\">'部门'</span><span style=\"color:#24292E\">, dataIndex: </span><span style=\"color:#032F62\">'department'</span><span style=\"color:#24292E\">, sorter: </span><span style=\"color:#005CC5\">true</span><span style=\"color:#24292E\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  { title: </span><span style=\"color:#032F62\">'年限'</span><span style=\"color:#24292E\">, dataIndex: </span><span style=\"color:#032F62\">'years'</span><span style=\"color:#24292E\">, sorter: </span><span style=\"color:#005CC5\">true</span><span style=\"color:#24292E\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">];</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">const</span><span style=\"color:#005CC5\"> rows</span><span style=\"color:#D73A49\">:</span><span style=\"color:#6F42C1\"> Row</span><span style=\"color:#24292E\">[] </span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\"> [</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  { id: </span><span style=\"color:#032F62\">'A01'</span><span style=\"color:#24292E\">, name: </span><span style=\"color:#032F62\">'张伟'</span><span style=\"color:#24292E\">, department: </span><span style=\"color:#032F62\">'研发'</span><span style=\"color:#24292E\">, years: </span><span style=\"color:#005CC5\">6</span><span style=\"color:#24292E\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  { id: </span><span style=\"color:#032F62\">'A02'</span><span style=\"color:#24292E\">, name: </span><span style=\"color:#032F62\">'李娜'</span><span style=\"color:#24292E\">, department: </span><span style=\"color:#032F62\">'设计'</span><span style=\"color:#24292E\">, years: </span><span style=\"color:#005CC5\">4</span><span style=\"color:#24292E\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  { id: </span><span style=\"color:#032F62\">'A03'</span><span style=\"color:#24292E\">, name: </span><span style=\"color:#032F62\">'王强'</span><span style=\"color:#24292E\">, department: </span><span style=\"color:#032F62\">'测试'</span><span style=\"color:#24292E\">, years: </span><span style=\"color:#005CC5\">3</span><span style=\"color:#24292E\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  { id: </span><span style=\"color:#032F62\">'A04'</span><span style=\"color:#24292E\">, name: </span><span style=\"color:#032F62\">'赵敏'</span><span style=\"color:#24292E\">, department: </span><span style=\"color:#032F62\">'运维'</span><span style=\"color:#24292E\">, years: </span><span style=\"color:#005CC5\">2</span><span style=\"color:#24292E\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">];</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">export</span><span style=\"color:#D73A49\"> const</span><span style=\"color:#005CC5\"> demo</span><span style=\"color:#D73A49\"> =</span><span style=\"color:#24292E\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  title: </span><span style=\"color:#032F62\">'排序'</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  description: </span><span style=\"color:#032F62\">'单列三态循环、多列累加与受控回写；每次变更都从同一个 onChange 出口带出完整状态。'</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">};</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">export</span><span style=\"color:#D73A49\"> default</span><span style=\"color:#D73A49\"> function</span><span style=\"color:#6F42C1\"> SortingDemo</span><span style=\"color:#24292E\">() {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">  const</span><span style=\"color:#24292E\"> [</span><span style=\"color:#005CC5\">controlled</span><span style=\"color:#24292E\">, </span><span style=\"color:#005CC5\">setControlled</span><span style=\"color:#24292E\">] </span><span style=\"color:#D73A49\">=</span><span style=\"color:#6F42C1\"> createSignal</span><span style=\"color:#24292E\">&#x3C;</span><span style=\"color:#6F42C1\">TableSorter</span><span style=\"color:#24292E\">>([]);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">  const</span><span style=\"color:#24292E\"> [</span><span style=\"color:#005CC5\">label</span><span style=\"color:#24292E\">, </span><span style=\"color:#005CC5\">setLabel</span><span style=\"color:#24292E\">] </span><span style=\"color:#D73A49\">=</span><span style=\"colo