  "path": "packages/core/src/components/button/demos/basic.tsx",
  "source": "import { createSignal, For } from 'solid-js';\nimport { Button } from 'solid-craft';\nimport { COLORS, DemoSection, DotIcon, SIZES, VARIANTS } from '../../demos/shared';\n\nexport const demo = {\n  title: '基础用法',\n  description: '变体、语义色、尺寸形状、状态与点击 / 键盘交互的完整基线。',\n};\n\nexport default function Basic() {\n  const [clicks, setClicks] = createSignal(0);\n  const [keyboardClicks, setKeyboardClicks] = createSignal(0);\n\n  return (\n    <>\n      <DemoSection title=\"变体\">\n        <For each={VARIANTS}>\n          {(variant, index) => (\n            <Button data-testid={index() === 0 ? 'first-focusable' : undefined} variant={variant}>\n              {`variant ${variant}`}\n            </Button>\n          )}\n        </For>\n      </DemoSection>\n      <DemoSection title=\"语义色\">\n        <For each={COLORS}>{(color) => <Button color={color}>{`color ${color}`}</Button>}</For>\n      </DemoSection>\n      <DemoSection title=\"尺寸与形状\">\n        <For each={SIZES}>{(size) => <Button size={size}>{`size ${size}`}</Button>}</For>\n        <Button shape=\"round\">round</Button>\n        <Button shape=\"circle\" aria-label=\"圆形按钮\" icon={<DotIcon />} />\n      </DemoSection>\n      <DemoSection title=\"状态\">\n        <Button disabled>disabled</Button>\n        <Button loading>loading</Button>\n        <Button block>block</Button>\n      </DemoSection>\n      <DemoSection title=\"交互与默认色\">\n        <Button data-testid=\"click-target\" onClick={() => setClicks((n) => n + 1)}>\n          计数按钮\n        </Button>\n        <Button data-testid=\"keyboard-target\" onClick={() => setKeyboardClicks((n) => n + 1)}>\n          键盘按钮\n        </Button>\n        <Button data-testid=\"default-primary\">默认主色</Button>\n        <span>\n          点击 <output data-testid=\"click-count\">{clicks()}</output> 次 / 键盘{' '}\n          <output data-testid=\"keyboard-count\">{keyboardClicks()}</output> 次\n        </span>\n      </DemoSection>\n    </>\n  );\n}\n",
  "html": "<pre class=\"shiki github-light\" style=\"background-color:#fff;color:#24292e\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49\">import</span><span style=\"color:#24292E\"> { createSignal, For } </span><span style=\"color:#D73A49\">from</span><span style=\"color:#032F62\"> 'solid-js'</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">import</span><span style=\"color:#24292E\"> { Button } </span><span style=\"color:#D73A49\">from</span><span style=\"color:#032F62\"> 'solid-craft'</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">import</span><span style=\"color:#24292E\"> { COLORS, DemoSection, DotIcon, SIZES, VARIANTS } </span><span style=\"color:#D73A49\">from</span><span style=\"color:#032F62\"> '../../demos/shared'</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">export</span><span style=\"color:#D73A49\"> const</span><span style=\"color:#005CC5\"> demo</span><span style=\"color:#D73A49\"> =</span><span style=\"color:#24292E\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  title: </span><span style=\"color:#032F62\">'基础用法'</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  description: </span><span style=\"color:#032F62\">'变体、语义色、尺寸形状、状态与点击 / 键盘交互的完整基线。'</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">};</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">export</span><span style=\"color:#D73A49\"> default</span><span style=\"color:#D73A49\"> function</span><span style=\"color:#6F42C1\"> Basic</span><span style=\"color:#24292E\">() {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">  const</span><span style=\"color:#24292E\"> [</span><span style=\"color:#005CC5\">clicks</span><span style=\"color:#24292E\">, </span><span style=\"color:#005CC5\">setClicks</span><span style=\"color:#24292E\">] </span><span style=\"color:#D73A49\">=</span><span style=\"color:#6F42C1\"> createSignal</span><span style=\"color:#24292E\">(</span><span style=\"color:#005CC5\">0</span><span style=\"color:#24292E\">);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">  const</span><span style=\"color:#24292E\"> [</span><span style=\"color:#005CC5\">keyboardClicks</span><span style=\"color:#24292E\">, </span><span style=\"color:#005CC5\">setKeyboardClicks</span><span style=\"color:#24292E\">] </span><span style=\"color:#D73A49\">=</span><span style=\"color:#6F42C1\"> createSignal</span><span style=\"color:#24292E\">(</span><span style=\"color:#005CC5\">0</span><span style=\"color:#24292E\">);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">  return</span><span style=\"color:#24292E\"> (</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">    &#x3C;></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">      &#x3C;</span><span style=\"color:#005CC5\">DemoSection</span><span style=\"color:#6F42C1\"> title</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"变体\"</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;</span><span style=\"color:#005CC5\">For</span><span style=\"color:#6F42C1\"> each</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{</span><span style=\"color:#005CC5\">VARIANTS</span><span style=\"color:#24292E\">}></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">          {(</span><span style=\"color:#E36209\">variant</span><span style=\"color:#24292E\">, </span><span style=\"color:#E36209\">index</span><span style=\"color:#24292E\">) </span><span style=\"color:#D73A49\">=></span><span style=\"color:#24292E\">