{
  "path": "packages/core/src/components/drawer/demos/basic.tsx",
  "source": "import { createSignal } from 'solid-js';\nimport { Button, Drawer, type DrawerPlacement } from 'solid-craft';\n\nimport { DemoSection } from '../../demos/shared';\n\nexport const demo = {\n  title: '基础用法与四方向',\n  description:\n    '外部按钮受控打开；left / right / top / bottom 四个方向共用同一套浮层行为，切换方向只改贴边定位与尺寸轴。',\n};\n\nconst SIDES: readonly DrawerPlacement[] = ['left', 'right', 'top', 'bottom'];\n\nexport default function DrawerBasicDemo() {\n  const [open, setOpen] = createSignal(false);\n  const [side, setSide] = createSignal<DrawerPlacement>('right');\n\n  const openWith = (next: DrawerPlacement) => {\n    setSide(next);\n    setOpen(true);\n  };\n\n  return (\n    <>\n      <DemoSection title=\"四方向\">\n        <div class=\"demo-row\">\n          {SIDES.map((item) => (\n            <Button variant=\"outline\" onClick={() => openWith(item)}>\n              打开 {item}\n            </Button>\n          ))}\n        </div>\n        <Drawer\n          title=\"设备采购计划明细\"\n          open={open()}\n          placement={side()}\n          onOpenChange={setOpen}\n          footer={\n            <Button variant=\"outline\" color=\"neutral\" onClick={() => setOpen(false)}>\n              关闭抽屉\n            </Button>\n          }\n        >\n          <p>按年度维简计划填写本次采购数量与本次采购单价，提交后进入审批流。</p>\n          <p>当前方向：{side()}</p>\n        </Drawer>\n      </DemoSection>\n\n      <DemoSection title=\"关闭路径\">\n        <p>右上角关闭按钮、ESC、点击遮罩三条路径都走同一个 onOpenChange 出口。</p>\n      </DemoSection>\n    </>\n  );\n}\n",
  "html": "<pre class=\"shiki github-light\" style=\"background-color:#fff;color:#24292e\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49\">import</span><span style=\"color:#24292E\"> { createSignal } </span><span style=\"color:#D73A49\">from</span><span style=\"color:#032F62\"> 'solid-js'</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">import</span><span style=\"color:#24292E\"> { Button, Drawer, </span><span style=\"color:#D73A49\">type</span><span style=\"color:#24292E\"> DrawerPlacement } </span><span style=\"color:#D73A49\">from</span><span style=\"color:#032F62\"> 'solid-craft'</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">import</span><span style=\"color:#24292E\"> { DemoSection } </span><span style=\"color:#D73A49\">from</span><span style=\"color:#032F62\"> '../../demos/shared'</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">export</span><span style=\"color:#D73A49\"> const</span><span style=\"color:#005CC5\"> demo</span><span style=\"color:#D73A49\"> =</span><span style=\"color:#24292E\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  title: </span><span style=\"color:#032F62\">'基础用法与四方向'</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  description:</span></span>\n<span class=\"line\"><span style=\"color:#032F62\">    '外部按钮受控打开；left / right / top / bottom 四个方向共用同一套浮层行为，切换方向只改贴边定位与尺寸轴。'</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">};</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">const</span><span style=\"color:#005CC5\"> SIDES</span><span style=\"color:#D73A49\">:</span><span style=\"color:#D73A49\"> readonly</span><span style=\"color:#6F42C1\"> DrawerPlacement</span><span style=\"color:#24292E\">[] </span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\"> [</span><span style=\"color:#032F62\">'left'</span><span style=\"color:#24292E\">, </span><span style=\"color:#032F62\">'right'</span><span style=\"color:#24292E\">, </span><span style=\"color:#032F62\">'top'</span><span style=\"color:#24292E\">, </span><span style=\"color:#032F62\">'bottom'</span><span style=\"color:#24292E\">];</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">export</span><span style=\"color:#D73A49\"> default</span><span style=\"color:#D73A49\"> function</span><span style=\"color:#6F42C1\"> DrawerBasicDemo</span><span style=\"color:#24292E\">() {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">  const</span><span style=\"color:#24292E\"> [</span><span style=\"color:#005CC5\">open</span><span style=\"color:#24292E\">, </span><span style=\"color:#005CC5\">setOpen</span><span style=\"color:#24292E\">] </span><span style=\"color:#D73A49\">=</span><span style=\"color:#6F42C1\"> createSignal</span><span style=\"color:#24292E\">(</span><span style=\"color:#005CC5\">false</span><span style=\"color:#24292E\">);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">  const</span><span style=\"color:#24292E\"> [</span><span style=\"color:#005CC5\">side</span><span style=\"color:#24292E\">, </span><span style=\"color:#005CC5\">setSide</span><span style=\"color:#24292E\">] </span><span style=\"color:#D73A49\">=</span><span style=\"color:#6F42C1\"> createSignal</span><span style=\"color:#24292E\">&#x3C;</span><span style=\"color:#6F42C1\">DrawerPlacement</span><span style=\"color:#24292E\">>(</span><span style=\"color:#032F62\">'right'</span><span style=\"color:#24292E\">);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">  const</span><span style=\"color:#6F42C1\"> openWith</span><span style=\"color:#D73A49\"> =</span><span style=\"color:#24292E\"> (</span><span style=\"color:#E36209\">next</span><span style=\"color:#D73A49\">:</span><span style=\"color:#6F42C1\"> DrawerPlacement</span><span style=\"color:#24292E\">) </span><span style=\"color:#D73A49\">=></span><span style=\"color:#24292E\"> {</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">    setSide</span><span style=\"color:#24292E\">(next);</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">    setOpen</span><span style=\"color:#24292E\">(</span><span style=\"color:#005CC5\">true</span><span style=\"color:#24292E\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  };</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">  return</span><span style=\"color:#24292E\"> (</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">    &#x3C;></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">      &#x3C;</span><span style=\"color:#005CC5\">DemoSection</span><span style=\"color:#6F42C1\"> title</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"四方向\"</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;</span><span style=\"color:#22863A\">div</span><span style=\"color:#6F42C1\"> class</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"demo-row\"</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">          {</span><span style=\"color:#005CC5\">SIDES</span><span style=\"color:#24292E\">.</span><span style=\"color:#6F42C1\">map</span><span style=\"color:#24292E\">((</span><span style=\"color:#E36209\">item</span><span style=\"color:#24292E\">) </span><span style=\"color:#D73A49\">=></span><span style=\"color:#24292E\"> (</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">            &#x3C;</span><span style=\"color:#005CC5\">Button</span><span style=\"color:#6F42C1\"> variant</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"outline\"</span><span style=\"color:#6F42C1\"> onClick</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{() </span><span style=\"color:#D73A49\">=></span><span style=\"color:#6F42C1\"> openWith</span><span style=\"color:#24292E\">(item)}></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">              打开 {item}</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">            &#x3C;/</span><span style=\"color:#005CC5\">Button</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">          ))}</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;/</span><span style=\"color:#22863A\">div</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;</span><span style=\"color:#005CC5\">Drawer</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">          title</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"设备采购计划明细\"</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">          open</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{</span><span style=\"color:#6F42C1\">open</span><span style=\"color:#24292E\">()}</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">          placement</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{</span><span style=\"color:#6F42C1\">side</span><span style=\"color:#24292E\">()}</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">          onOpenChange</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{setOpen}</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">          footer</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">            &#x3C;</span><span style=\"color:#005CC5\">Button</span><span style=\"color:#6F42C1\"> variant</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"outline\"</span><span style=\"color:#6F42C1\"> color</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"neutral\"</span><span style=\"color:#6F42C1\"> onClick</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{() </span><span style=\"color:#D73A49\">=></span><span style=\"color:#6F42C1\"> setOpen</span><span style=\"color:#24292E\">(</span><span style=\"color:#005CC5\">false</span><span style=\"color:#24292E\">)}></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">              关闭抽屉</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">            &#x3C;/</span><span style=\"color:#005CC5\">Button</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">          }</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        ></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">          &#x3C;</span><span style=\"color:#22863A\">p</span><span style=\"color:#24292E\">>按年度维简计划填写本次采购数量与本次采购单价，提交后进入审批流。&#x3C;/</span><span style=\"color:#22863A\">p</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">          &#x3C;</span><span style=\"color:#22863A\">p</span><span style=\"color:#24292E\">>当前方向：{</span><span style=\"color:#6F42C1\">side</span><span style=\"color:#24292E\">()}&#x3C;/</span><span style=\"color:#22863A\">p</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;/</span><span style=\"color:#005CC5\">Drawer</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">      &#x3C;/</span><span style=\"color:#005CC5\">DemoSection</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E\">      &#x3C;</span><span style=\"color:#005CC5\">DemoSection</span><span style=\"color:#6F42C1\"> title</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"关闭路径\"</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;</span><span style=\"color:#22863A\">p</span><span style=\"color:#24292E\">>右上角关闭按钮、ESC、点击遮罩三条路径都走同一个 onOpenChange 出口。&#x3C;/</span><span style=\"color:#22863A\">p</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">      &#x3C;/</span><span style=\"color:#005CC5\">DemoSection</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">    &#x3C;/></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  );</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">}</span></span>\n<span class=\"line\"></span></code></pre>"
