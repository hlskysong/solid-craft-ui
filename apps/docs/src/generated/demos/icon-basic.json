  &#x3C;></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">      &#x3C;</span><span style=\"color:#005CC5\">DemoSection</span><span style=\"color:#6F42C1\"> title</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"语义图标\"</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;</span><span style=\"color:#005CC5\">Icon</span><span style=\"color:#6F42C1\"> label</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"提示\"</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">          &#x3C;</span><span style=\"color:#005CC5\">DotIcon</span><span style=\"color:#24292E\"> /></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;/</span><span style=\"color:#005CC5\">Icon</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;</span><span style=\"color:#005CC5\">Icon</span><span style=\"color:#6F42C1\"> label</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"成功\"</span><span style=\"color:#6F42C1\"> tone</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"success\"</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">          &#x3C;</span><span style=\"color:#005CC5\">DotIcon</span><span style=\"color:#24292E\"> /></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;/</span><span style=\"color:#005CC5\">Icon</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;</span><span style=\"color:#005CC5\">Icon</span><span style=\"color:#6F42C1\"> label</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"警告\"</span><span style=\"color:#6F42C1\"> tone</span><span style=\"color:#D73A49\">=</span><span style=\"c