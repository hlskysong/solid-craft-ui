  "path": "packages/core/src/components/popconfirm/demos/basic.tsx",
  "source": "import { createSignal } from 'solid-js';\nimport { message, Popconfirm } from 'solid-craft';\n\nimport { DemoSection } from '../../demos/shared';\n\nexport const demo = {\n  title: '异步确认与全局反馈接入',\n  description:\n    'onOk 返回 Promise 期间进入 pending：确认按钮 loading、取消禁用、ESC 与外部点击被拦；resolve 后关闭并调用 T2-06 的静态 message。',\n};\n\nexport default function PopconfirmBasicDemo() {\n  const [count, setCount] = createSignal(0);\n  const [log, setLog] = createSignal('等待操作');\n\n  const submit = (): Promise<void> =>\n    new Promise((resolve) => {\n      setLog('提交中');\n      setTimeout(() => {\n        setCount(count() + 1);\n        setLog('提交完成');\n        void message.success('已删除采购明细');\n        resolve();\n      }, 900);\n    });\n\n  return (\n    <>\n      <DemoSection title=\"删除确认\">\n        <Popconfirm\n          title=\"确认删除这条采购明细？\"\n          description=\"删除后不可恢复。提交期间所有关闭入口都会失效。\"\n          placement=\"right\"\n          onOk={submit}\n          onCancel={() => {\n            setLog('已取消');\n            void message.info('已取消删除');\n          }}\n        >\n          删除明细\n        </Popconfirm>\n      </DemoSection>\n\n      <DemoSection title=\"状态出口\">\n        <p data-testid=\"popconfirm-submit-count\">累计提交 {count()} 次</p>\n        <p data-testid=\"popconfirm-submit-log\">当前状态：{log()}</p>\n      </DemoSection>\n    </>\n  );\n}\n",
  "html": "<pre class=\"shiki github-light\" style=\"background-color:#fff;color:#24292e\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49\">import</span><span style=\"color:#24292E\"> { createSignal } </span><span style=\"color:#D73A49\">from</span><span style=\"color:#032F62\"> 'solid-js'</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">import</span><span style=\"color:#24292E\"> { message, Popconfirm } </span><span style=\"color:#D73A49\">from</span><span style=\"color:#032F62\"> 'solid-craft'</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">import</span><span style=\"color:#24292E\"> { DemoSection } </span><span style=\"color:#D73A49\">from</span><span style=\"color:#032F62\"> '../../demos/shared'</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">export</span><span style=\"color:#D73A49\"> const</span><span style=\"color:#005CC5\"> demo</span><span style=\"color:#D73A49\"> =</span><span style=\"color:#24292E\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  title: </span><span style=\"color:#032F62\">'异步确认与全局反馈接入'</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  description:</span></span>\n<span class=\"line\"><span style=\"color:#032F62\">    'onOk 返回 Promise 期间进入 pending：确认按钮 loading、取消禁用、ESC 与外部点击被拦；resolve 后关闭并调用 T2-06 的静态 message。'</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">};</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">export</span><span style=\"color:#D73A49\"> default</span><span style=\"color:#D73A49\"> function</span><span style=\"color:#6F42C1\"> PopconfirmBasicDemo</span><span style=\"color:#24292E\">() {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">  const</span><span style=\"color:#24292E\"> [</span><span style=\"color:#005CC5\">count</span><span style=\"color:#24292E\">, </span><span style=\"color:#005CC5\">setCount</span><span style=\"color:#24292E\">] </span><span style=\"color:#D73A49\">=</span><span style=\"color:#6F42C1\"> createSignal</span><span style=\"color:#24292E\">(</span><span style=\"color:#005CC5\">0</span><span style=\"color:#24292E\">);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">  const</span><span style=\"color:#24292E\"> [</span><span style=\"color:#005CC5\">log</span><span style=\"color:#24292E\">, </span><span style=\"color:#005CC5\">setLog</span><span style=\"color:#24292E\">] </span><span style=\"color:#D73A49\">=</span><span style=\"color:#6F42C1\"> createSignal</span><span style=\"color:#24292E\">(</span><span style=\"color:#032F62\">'等待操作'</span><span style=\"color:#24292E\">);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">  const</span><span style=\"color:#6F42C1\"> submit</span><span style=\"color:#D73A49\"> =</span><span style=\"color:#24292E\"> ()</span><span style=\"color:#D73A49\">:</span><span style=\"color:#6F42C1\"> Promise</span><span style=\"color:#24292E\">&#x3C;</span><span style=\"color:#005CC5\">void</span><span style=\"color:#24292E\">> </span><span style=\"color:#D73A49\">=></span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">    new</span><span style=\"color:#005CC5\"> Promise</span><span style=\"color:#24292E\">((</span><span style=\"color:#E36209\">resolve</span><span style=\"color:#24292E\">) </span><span style=\"color:#D73A49\">=></span><span style=\"color:#24292E\"> {</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">      setLog</span><span style=\"color:#24292E\">(</span><span style=\"color:#032F62\">'提交中'</span><span style=\"color:#24292E\">);</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">      setTimeout</span><span style=\"color:#24292E\">(() </span><span style=\"color:#D73A49\">=></span><span style=\"color:#24292E\"> {</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">        setCount</span><span style=\"color:#24292E\">(</span><span style=\"color:#6F42C1\">count</span><span style=\"color:#24292E\">() </span><span style=\"color:#D73A49\">+</span><span style=\"color:#005CC5\"> 1</span><span style=\"color:#24292E\">);</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">        setLog</span><span style=\"color:#24292E\">(</span><span style=\"color:#032F62\">'提交完成'</span><span style=\"color:#24292E\">);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">        void</span><span style=\"color:#24292E\"> message.</span><span style=\"color:#6F42C1\">success</span><span style=\"color:#24292E\">(</span><span style=\"color:#032F62\">'已删除采购明细'</span><span style=\"color:#24292E\">);</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">        resolve</span><span style=\"color:#24292E\">();</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">      }, </span><span style=\"color:#005CC5\">900</span><span style=\"color:#24292E\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">    });</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">  return</span><span style=\"color:#24292E\"> (</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">    &#x3C;></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">      &#x3C;</span><span style=\"color:#005CC5\">DemoSection</span><span style=\"color:#6F42C1\"> title</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"删除确认\"</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;</span><span style=\"color:#005CC5\">Popconfirm</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">          title</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"确认删除这条采购明细？\"</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">          description</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"删除后不可恢复。提交期间所有关闭入口都会失效。\"</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">          placement</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"right\"</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">          onOk</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{submit}</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">          onCancel</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{() </span><span style=\"color:#D73A49\">=></span><span style=\"color:#24292E\"> {</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">            setLog</span><span style=\"color:#24292E\">(</span><span style=\"color:#032F62\">'已取消'</span><span style=\"color:#24292E\">);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">            void</span><span style=\"color:#24292E\"> message.</span><span style=\"color:#6F42C1\">info</span><span style=\"color:#24292E\">(</span><span style=\"color:#032F62\">'已取消删除'</span><span style=\"color:#24292E\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">          }}</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        ></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">          删除明细</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;/</span><span style=\"color:#005CC5\">Popconfirm</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">      &#x3C;/</span><span style=\"color:#005CC5\">DemoSection</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E\">      &#x3C;</span><span style=\"color:#005CC5\">DemoSection</span><span style=\"color:#6F42C1\"> title</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"状态出口\"</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;</span><span style=\"color:#22863A\">p</span><span style=\"color:#6F42C1\"> data-testid</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"popconfirm-submit-count\"</span><span style=\"color:#24292E\">>累计提交 {</span><span style=\"color:#6F42C1\">count</span><span style=\"color:#24292E\">()} 次&#x3C;/</span><span style=\"color:#22863A\">p</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;</span><span style=\"color:#22863A\">p</span><span style=\"color:#6F42C1\"> data-testid</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"popconfirm-submit-log\"</span><span style=\"color:#24292E\">>当前状态：{</span><span style=\"color:#6F42C1\">log</span><span style=\"color:#24292E\">()}&#x3C;/</span><span style=\"color:#22863A\">p</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">      &#x3C;/</span><span style=\"color:#005CC5\">DemoSection</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">    &#x3C;/></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  );</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">}</span></span>\n<span class=\"line\"></span></code></pre>"
