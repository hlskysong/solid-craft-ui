an></span>\n<span class=\"line\"><span style=\"color:#24292E\">  { key: </span><span style=\"color:#032F62\">'name'</span><span style=\"color:#24292E\">, label: </span><span style=\"color:#032F62\">'项目名称'</span><span style=\"color:#24292E\">, children: </span><span style=\"color:#032F62\">'主通风机更新改造'</span><span style=\"color:#24292E\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  { key: </span><span style=\"color:#032F62\">'dept'</span><span style=\"color:#24292E\">, label: </span><span style=\"color:#032F62\">'申报单位'</span><span style=\"color:#24292E\">, children: </span><span style=\"color:#032F62\">'机电运输部'</span><span style=\"color:#24292E\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  { key: </span><span style=\"color:#032F62\">'amount'</span><span style=\"color:#24292E\">, label: </span><span style=\"color:#032F62\">'本次采购金额'</span><span style=\"color:#24292E\">, children: </span><span style=\"color:#032F62\">'148 万元'</span><span style=\"color:#24292E\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  { key: </span><span style=\"color:#032F62\">'date'</span><span style=\"color:#24292E\">, label: </span><span style=\"color:#032F62\">'计划完成时间'</span><span style=\"color:#24292E\">, children: </span><span style=\"color:#032F62\">'2026-12-31'</span><span style=\"color:#24292E\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  { key: </span><span style=\"color:#032F62\">'status'</span><span style=\"color:#24292E\">, label: </span><span style=\"color:#032F62\">'当前状态'</span><span style=\"color:#24292E\">, children: </span><span style=\"color:#032F62\">'审批中'</span><span style=\"color:#24292E\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  {</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">    key: </span><span style=\"color:#032F62\">'note'</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color: