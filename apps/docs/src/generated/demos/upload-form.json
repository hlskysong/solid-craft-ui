{
  "path": "packages/core/src/components/upload/demos/form.tsx",
  "source": "import { createSignal } from 'solid-js';\nimport { Button, Form, Upload, useForm, type FormValues, type UploadFile } from 'solid-craft';\n\nimport { DemoSection } from '../../demos/shared';\n\nexport const demo = {\n  title: '与 Form.Item 接入',\n  description:\n    'Upload 在 <Form.Item> 内由字段上下文接管 fileList，值优先级高于 props；删除、重试、进度都回写同一个字段，提交时拿到的是变更后的列表。必填规则对空数组同样生效。',\n};\n\nconst initial: UploadFile[] = [\n  { uid: 'form-1', name: '立项批复.pdf', size: 30720, status: 'done', percent: 100 },\n  { uid: 'form-2', name: '预算明细.pdf', size: 15360, status: 'done', percent: 100 },\n];\n\nexport default function UploadFormDemo() {\n  const [form] = useForm<FormValues>({ attachments: initial });\n  const [result, setResult] = createSignal('尚未提交');\n\n  return (\n    <DemoSection title=\"表单接入\">\n      <div class=\"demo-column\">\n        <Form\n          form={form}\n          aria-label=\"附件提交表单\"\n          data-testid=\"upload-form\"\n          onFinish={(values: FormValues) => {\n            const raw = values.attachments;\n            const count = Array.isArray(raw) ? raw.length : 0;\n            setResult(`提交成功：${count} 个附件`);\n          }}\n        >\n          <Form.Item\n            name=\"attachments\"\n            label=\"附件\"\n            rules={[{ required: true, message: '请至少上传一个附件' }]}\n          >\n            <Upload aria-label=\"表单附件\" data-testid=\"upload-form-control\" />\n          </Form.Item>\n          <Button htmlType=\"submit\" data-testid=\"upload-form-submit\">\n            提交附件\n          </Button>\n        </Form>\n        <p data-testid=\"upload-form-result\">{result()}</p>\n      </div>\n    </DemoSection>\n  );\n}\n",
  "html": "<pre class=\"shiki github-light\" style=\"background-color:#fff;color:#24292e\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49\">import</span><span style=\"color:#24292E\"> { createSignal } </span><span style=\"color:#D73A49\">from</span><span style=\"color:#032F62\"> 'solid-js'</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">import</span><span style=\"color:#24292E\"> { Button, Form, Upload, useForm, </span><span style=\"color:#D73A49\">type</span><span style=\"color:#24292E\"> FormValues, </span><span style=\"color:#D73A49\">type</span><span style=\"color:#24292E\"> UploadFile } </span><span style=\"color:#D73A49\">from</span><span style=\"color:#032F62\"> 'solid-craft'</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">import</span><span style=\"color:#24292E\"> { DemoSection } </span><span style=\"color:#D73A49\">from</span><span style=\"color:#032F62\"> '../../demos/shared'</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">export</span><span style=\"color:#D73A49\"> const</span><span style=\"color:#005CC5\"> demo</span><span style=\"color:#D73A49\"> =</span><span style=\"color:#24292E\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  title: </span><span style=\"color:#032F62\">'与 Form.Item 接入'</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  description:</span></span>\n<span class=\"line\"><span style=\"color:#032F62\">    'Upload 在 &#x3C;Form.Item> 内由字段上下文接管 fileList，值优先级高于 props；删除、重试、进度都回写同一个字段，提交时拿到的是变更后的列表。必填规则对空数组同样生效。'</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">};</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">const</span><span style=\"color:#005CC5\"> initial</span><span style=\"color:#D73A49\">:</span><span style=\"color:#6F42C1\"> UploadFile</span><span style=\"color:#24292E\">[] </span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\"> [</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  { uid: </span><span style=\"color:#032F62\">'form-1'</span><span style=\"color:#24292E\">, name: </span><span style=\"color:#032F62\">'立项批复.pdf'</span><span style=\"color:#24292E\">, size: </span><span style=\"color:#005CC5\">30720</span><span style=\"color:#24292E\">, status: </span><span style=\"color:#032F62\">'done'</span><span style=\"color:#24292E\">, percent: </span><span style=\"color:#005CC5\">100</span><span style=\"color:#24292E\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  { uid: </span><span style=\"color:#032F62\">'form-2'</span><span style=\"color:#24292E\">, name: </span><span style=\"color:#032F62\">'预算明细.pdf'</span><span style=\"color:#24292E\">, size: </span><span style=\"color:#005CC5\">15360</span><span style=\"color:#24292E\">, status: </span><span style=\"color:#032F62\">'done'</span><span style=\"color:#24292E\">, percent: </span><span style=\"color:#005CC5\">100</span><span style=\"color:#24292E\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">];</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">export</span><span style=\"color:#D73A49\"> default</span><span style=\"color:#D73A49\"> function</span><span style=\"color:#6F42C1\"> UploadFormDemo</span><span style=\"color:#24292E\">() {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">  const</span><span style=\"color:#24292E\"> [</span><span style=\"color:#005CC5\">form</span><span style=\"color:#24292E\">] </span><span style=\"color:#D73A49\">=</span><span style=\"color:#6F42C1\"> useForm</span><span style=\"color:#24292E\">&#x3C;</span><span style=\"color:#6F42C1\">FormValues</span><span style=\"color:#24292E\">>({ attachments: initial });</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">  const</span><span style=\"color:#24292E\"> [</span><span style=\"color:#005CC5\">result</span><span style=\"color:#24292E\">, </span><span style=\"color:#005CC5\">setResult</span><span style=\"color:#24292E\">] </span><span style=\"color:#D73A49\">=</span><span style=\"color:#6F42C1\"> createSignal</span><span style=\"color:#24292E\">(</span><span style=\"color:#032F62\">'尚未提交'</span><span style=\"color:#24292E\">);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">  return</span><span style=\"color:#24292E\"> (</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">    &#x3C;</span><span style=\"color:#005CC5\">DemoSection</span><span style=\"color:#6F42C1\"> title</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"表单接入\"</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">      &#x3C;</span><span style=\"color:#22863A\">div</span><span style=\"color:#6F42C1\"> class</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"demo-column\"</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;</span><span style=\"color:#005CC5\">Form</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">          form</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{form}</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">          aria-label</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"附件提交表单\"</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">          data-testid</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"upload-form\"</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">          onFinish</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{(</span><span style=\"color:#E36209\">values</span><span style=\"color:#D73A49\">:</span><span style=\"color:#6F42C1\"> FormValues</span><span style=\"color:#24292E\">) </span><span style=\"color:#D73A49\">=></span><span style=\"color:#24292E\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">            const</span><span style=\"color:#005CC5\"> raw</span><span style=\"color:#D73A49\"> =</span><span style=\"color:#24292E\"> values.attachments;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">            const</span><span style=\"color:#005CC5\"> count</span><span style=\"color:#D73A49\"> =</span><span style=\"color:#24292E\"> Array.</span><span style=\"color:#6F42C1\">isArray</span><span style=\"color:#24292E\">(raw) </span><span style=\"color:#D73A49\">?</span><span style=\"color:#24292E\"> raw.</span><span style=\"color:#005CC5\">length</span><span style=\"color:#D73A49\"> :</span><span style=\"color:#005CC5\"> 0</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">            setResult</span><span style=\"color:#24292E\">(</span><span style=\"color:#032F62\">`提交成功：${</span><span style=\"color:#24292E\">count</span><span style=\"color:#032F62\">} 个附件`</span><span style=\"color:#24292E\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">          }}</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        ></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">          &#x3C;</span><span style=\"color:#005CC5\">Form.Item</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">            name</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"attachments\"</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">            label</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"附件\"</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">            rules</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{[{ required: </span><span style=\"color:#005CC5\">true</span><span style=\"color:#24292E\">, message: </span><span style=\"color:#032F62\">'请至少上传一个附件'</span><span style=\"color:#24292E\"> }]}</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">          ></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">            &#x3C;</span><span style=\"color:#005CC5\">Upload</span><span style=\"color:#6F42C1\"> aria-label</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"表单附件\"</span><span style=\"color:#6F42C1\"> data-testid</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"upload-form-control\"</span><span style=\"color:#24292E\"> /></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">          &#x3C;/</span><span style=\"color:#005CC5\">Form.Item</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">          &#x3C;</span><span style=\"color:#005CC5\">Button</span><span style=\"color:#6F42C1\"> htmlType</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"submit\"</span><span style=\"color:#6F42C1\"> data-testid</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"upload-form-submit\"</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">            提交附件</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">          &#x3C;/</span><span style=\"color:#005CC5\">Button</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;/</span><span style=\"color:#005CC5\">Form</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;</span><span style=\"color:#22863A\">p</span><span style=\"color:#6F42C1\"> data-testid</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"upload-form-result\"</span><span style=\"color:#24292E\">>{</span><span style=\"color:#6F42C1\">result</span><span style=\"color:#24292E\">()}&#x3C;/</span><span style=\"color:#22863A\">p</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">      &#x3C;/</span><span style=\"color:#22863A\">div</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">    &#x3C;/</span><span style=\"color:#005CC5\">DemoSection</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  );</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">}</span></span>\n<span class=\"line\"></span></code></pre>"
}
