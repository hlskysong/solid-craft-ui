  "source": "import { Tag, type TagColor, type TagVariant } from 'solid-craft';\n\nimport { COLORS, DemoSection } from '../../demos/shared';\n\nexport const demo = {\n  title: '五种配色 × 四种形态',\n  description:\n    '配色走 data-scui-color（neutral 对应 TDesign 的 default，高饱和色只落在文字或底色）；形态走 data-scui-variant，对齐 dark / light / outline / light-outline 四档。',\n};\n\nconst LABELS: Record<TagColor, string> = {\n  primary: '进行中',\n  neutral: '草稿',\n  success: '已通过',\n  warning: '待复核',\n  danger: '已驳回',\n};\n\nconst VARIANTS: { value: TagVariant; label: string }[] = [\n  { value: 'dark', label: '深色' },\n  { value: 'light', label: '浅色' },\n  { value: 'outline', label: '描边' },\n  { value: 'light-outline', label: '浅色描边' },\n];\n\nexport default function TagBasicDemo() {\n  return (\n    <>\n      {VARIANTS.map((variant) => (\n        <DemoSection title={variant.label}>\n          <div class=\"demo-row\" data-testid={`tag-variant-${variant.value}`}>\n            {COLORS.map((color) => (\n              <Tag\n                color={color}\n                variant={variant.value}\n                data-testid={`tag-${variant.value}-${color}`}\n              >\n                {LABELS[color]}\n              </Tag>\n            ))}\n          </div>\n        </DemoSection>\n      ))}\n    </>\n  );\n}\n",
  "html": "<pre class=\"shiki github-light\" style=\"background-color:#fff;color:#24292e\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49\">import</span><span style=\"color:#24292E\"> { Tag, </span><span style=\"color:#D73A49\">type</span><span style=\"color:#24292E\"> TagColor, </span><span style=\"color:#D73A49\">type</span><span style=\"color:#24292E\"> TagVariant } </span><span style=\"color:#D73A49\">from</span><span style=\"color:#032F62\"> 'solid-craft'</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">import</span><span style=\"color:#24292E\"> { COLORS, DemoSection } </span><span style=\"color:#D73A49\">from</span><span style=\"color:#032F62\"> '../../demos/shared'</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">export</span><span style=\"color:#D73A49\"> const</span><span style=\"color:#005CC5\"> demo</span><span style=\"color:#D73A49\"> =</span><span style=\"color:#24292E\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  title: </span><span style=\"color:#032F62\">'五种配色 × 四种形态'</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  description:</span></span>\n<span class=\"line\"><span style=\"color:#032F62\">    '配色走 data-scui-color（neutral 对应 TDesign 的 default，高饱和色只落在文字或底色）；形态走 data-scui-variant，对齐 dark / light / outline / light-outline 四档。'</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">};</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">const</span><span style=\"color:#005CC5\"> LABELS</span><span style=\"color:#D73A49\">:</span><span style=\"color:#6F42C1\"> Record</span><span style=\"color:#24292E\">&#x3C;</span><span style=\"color:#6F42C1\">TagColor</span><span style=\"color:#24292E\">, </span><span style=\"color:#005CC5\">string</span><span style=\"color:#24292E\">> </span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  primary: </span><span style=\"color:#032F62\">'进行中'</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  neutral: </span><span style=\"color:#032F62\">'草稿'</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  success: </span><span style=\"color:#032F62\">'已通过'</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  warning: </span><span style=\"color:#032F62\">'待复核'</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  danger: </span><span style=\"color:#032F62\">'已驳回'</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">};</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">const</span><span style=\"color:#005CC5\"> VARIANTS</span><span style=\"color:#D73A49\">:</span><span style=\"color:#24292E\"> { </span><span style=\"color:#E36209\">value</span><span style=\"color:#D73A49\">:</span><span style=\"color:#6F42C1\"> TagVariant</span><span style=\"color:#24292E\">; </span><span style=\"color:#E36209\">label</span><span style=\"color:#D73A49\">:</span><span style=\"color:#005CC5\"> string</span><span style=\"color:#24292E\"> }[] </span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\"> [</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  { value: </span><span style=\"color:#032F62\">'dark'</span><span style=\"color:#24292E\">, label: </span><span style=\"color:#032F62\">'深色'</span><span style=\"color:#24292E\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  { value: </span><span style=\"color:#032F62\">'light'</span><span style=\"color:#24292E\">, label: </span><span style=\"color:#032F62\">'浅色'</span><span style=\"color:#24292E\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  { value: </span><span style=\"color:#032F62\">'outline'</span><span style=\"color:#24292E\">, label: </span><span style=\"color:#032F62\">'描边'</span><span style=\"color:#24292E\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  { value: </span><span style=\"color:#032F62\">'light-outline'</span><span style=\"color:#24292E\">, label: </span><span style=\"color:#032F62\">'浅色描边'</span><span style=\"color:#24292E\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">];</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">export</span><span style=\"color:#D73A49\"> default</span><span style=\"color:#D73A49\"> function</span><span style=\"color:#6F42C1\"> TagBasicDemo</span><span style=\"color:#24292E\">() {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">  return</span><span style=\"color:#24292E\"> (</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">    &#x3C;></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">      {</span><span style=\"color:#005CC5\">VARIANTS</span><span style=\"color:#24292E\">.</span><span style=\"color:#6F42C1\">map</span><span style=\"color:#24292E\">((</span><span style=\"color:#E36209\">variant</span><span style=\"color:#24292E\">) </span><span style=\"color:#D73A49\">=></span><span style=\"color:#24292E\"> (</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;</span><span style=\"color:#005CC5\">DemoSection</span><span style=\"color:#6F42C1\"> title</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{variant.label}></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">          &#x3C;</span><span style=\"color:#22863A\">div</span><span style=\"color:#6F42C1\"> class</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"demo-row\"</span><span style=\"color:#6F42C1\"> data-testid</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{</span><span style=\"color:#032F62\">`tag-variant-${</span><span style=\"color:#24292E\">variant</span><span style=\"color:#032F62\">.</span><span style=\"color:#24292E\">value</span><span style=\"color:#032F62\">}`</span><span style=\"color:#24292E\">}></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">            {</span><span style=\"color:#005CC5\">COLORS</span><span style=\"color:#24292E\">.</span><span style=\"color:#6F42C1\">map</span><span style=\"color:#24292E\">((</span><span style=\"color:#E36209\">color</span><span style=\"color:#24292E\">) </span><span style=\"color:#D73A49\">=></span><span style=\"color:#24292E\"> (</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">              &#x3C;</span><span style=\"color:#005CC5\">Tag</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">                color</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{color}</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">                variant</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{variant.value}</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">                data-testid</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{</span><span style=\"color:#032F62\">`tag-${</span><span style=\"color:#24292E\">variant</span><span style=\"color:#032F62\">.</span><span style=\"color:#24292E\">value</span><span style=\"color:#032F62\">}-${</span><span style=\"color:#24292E\">color</span><span style=\"color:#032F62\">}`</span><span style=\"color:#24292E\">}</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">              ></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">                {</span><span style=\"color:#005CC5\">LABELS</span><span style=\"color:#24292E\">[color]}</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">              &#x3C;/</span><span style=\"color:#005CC5\">Tag</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">            ))}</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">          &#x3C;/</span><span style=\"color:#22863A\">div</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;/</span><span style=\"color:#005CC5\">DemoSection</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">      ))}</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">    &#x3C;/></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  );</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">}</span></span>\n<span class=\"line\"></span></code></pre>"
