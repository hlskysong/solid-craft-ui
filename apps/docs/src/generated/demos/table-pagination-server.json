  "source": "import { createMemo, createSignal } from 'solid-js';\nimport { Table } from 'solid-craft';\nimport type { TableChange, TableColumn } from 'solid-craft';\nimport { DemoSection } from '../../demos/shared';\n\ninterface Row {\n  id: string;\n  name: string;\n  department: string;\n}\n\nconst columns: TableColumn<Row>[] = [\n  { title: '工号', dataIndex: 'id', width: 96 },\n  { title: '姓名', dataIndex: 'name', width: 120 },\n  { title: '部门', dataIndex: 'department' },\n];\n\nconst allRows: Row[] = Array.from({ length: 12 }, (_, index) => ({\n  id: `A${String(index + 1).padStart(2, '0')}`,\n  name: `员工${index + 1}`,\n  department: index % 2 === 0 ? '研发' : '设计',\n}));\n\nexport const demo = {\n  title: '服务端分页',\n  description:\n    'server 模式表内一行都不切，业务侧拿 onChange.pagination 直接拼请求、回写当前页数据；total 由调用方给出。',\n};\n\nexport default function PaginationServerDemo() {\n  const [page, setPage] = createSignal(1);\n  const [pageSize, setPageSize] = createSignal(5);\n  const [request, setRequest] = createSignal('尚未请求');\n\n  // 模拟一次服务端响应：真实项目里这一步换成 fetch 后回写 data 即可。\n  const currentPageRows = createMemo(() =>\n    allRows.slice((page() - 1) * pageSize(), page() * pageSize()),\n  );\n\n  const onChange = (change: TableChange): void => {\n    const paging = change.pagination;\n    if (paging === undefined) return;\n    setPage(paging.current);\n    setPageSize(paging.pageSize);\n    setRequest(`?page=${paging.current}&pageSize=${paging.pageSize}&total=${paging.total}`);\n  };\n\n  return (\n    <DemoSection title=\"服务端分页\">\n      <div class=\"demo-stack\">\n        <Table\n          columns={columns}\n          data={currentPageRows()}\n          rowKey=\"id\"\n          server\n          pagination={{\n            current: page(),\n            pageSize: pageSize(),\n            total: allRows.length,\n            pageSizeOptions: [5, 10],\n            showSizeChanger: true,\n            showTotal: (total) => <span>服务端共 {total} 条</span>,\n          }}\n          onChange={onChange}\n          aria-label=\"服务端分页表格\"\n        />\n        <span>\n          请求参数：<output>{request()}</output>\n        </span>\n      </div>\n    </DemoSection>\n  );\n}\n",
  "html": "<pre class=\"shiki github-light\" style=\"background-color:#fff;color:#24292e\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49\">import</span><span style=\"color:#24292E\"> { createMemo, createSignal } </span><span style=\"color:#D73A49\">from</span><span style=\"color:#032F62\"> 'solid-js'</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">import</span><span style=\"color:#24292E\"> { Table } </span><span style=\"color:#D73A49\">from</span><span style=\"color:#032F62\"> 'solid-craft'</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">import</span><span style=\"color:#D73A49\"> type</span><span style=\"color:#24292E\"> { TableChange, TableColumn } </span><span style=\"color:#D73A49\">from</span><span style=\"color:#032F62\"> 'solid-craft'</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">import</span><span style=\"color:#24292E\"> { DemoSection } </span><span style=\"color:#D73A49\">from</span><span style=\"color:#032F62\"> '../../demos/shared'</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">interface</span><span style=\"color:#6F42C1\"> Row</span><span style=\"color:#24292E\"> {</span></span>\n<span class=\"line\"><span style=\"color:#E36209\">  id</span><span style=\"color:#D73A49\">:</span><span style=\"color:#005CC5\"> string</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209\">  name</span><span style=\"color:#D73A49\">:</span><span style=\"color:#005CC5\"> string</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"><span style=\"color:#E36209\">  department</span><span style=\"color:#D73A49\">:</span><span style=\"color:#005CC5\"> string</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">const</span><span style=\"color:#005CC5\"> columns</span><span style=\"color:#D73A49\">:</span><span style=\"color:#6F42C1\"> TableColumn</span><span style=\"color:#24292E\">&#x3C;</span><span style=\"color:#6F42C1\">Row</span><span style=\"color:#24292E\">>[] </span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\"> [</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  { title: </span><span style=\"color:#032F62\">'工号'</span><span style=\"color:#24292E\">, dataIndex: </span><span style=\"color:#032F62\">'id'</span><span style=\"color:#24292E\">, width: </span><span style=\"color:#005CC5\">96</span><span style=\"color:#24292E\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  { title: </span><span style=\"color:#032F62\">'姓名'</span><span style=\"color:#24292E\">, dataIndex: </span><span style=\"color:#032F62\">'name'</span><span style=\"color:#24292E\">, width: </span><span style=\"color:#005CC5\">120</span><span style=\"color:#24292E\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  { title: </span><span style=\"color:#032F62\">'部门'</span><span style=\"color:#24292E\">, dataIndex: </span><span style=\"color:#032F62\">'department'</span><span style=\"color:#24292E\"> },</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">];</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">const</span><span style=\"color:#005CC5\"> allRows</span><span style=\"color:#D73A49\">:</span><span style=\"color:#6F42C1\"> Row</span><span style=\"color:#24292E\">[] </span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\"> Array.</span><span style=\"color:#6F42C1\">from</span><span style=\"color:#24292E\">({ length: </span><span style=\"color:#005CC5\">12</span><span style=\"color:#24292E\"> }, (</span><span style=\"color:#E36209\">_</span><span style=\"color:#24292E\">, </span><span style=\"color:#E36209\">index</span><span style=\"color:#24292E\">) </span><span style=\"color:#D73A49\">=></span><span style=\"color:#24292E\"> ({</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  id: </span><span style=\"color:#032F62\">`A${</span><span style=\"color:#6F42C1\">String</span><span style=\"color:#032F62\">(</span><span style=\"color:#24292E\">index</span><span style=\"color:#D73A49\"> +</span><span style=\"color:#005CC5\"> 1</span><span style=\"color:#032F62\">).</span><span style=\"color:#6F42C1\">padStart</span><span style=\"color:#032F62\">(</span><span style=\"color:#005CC5\">2</span><span style=\"color:#032F62\">, </span><span style=\"color:#032F62\">'0'</span><span style=\"color:#032F62\">)</span><span style=\"color:#032F62\">}`</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  name: </span><span style=\"color:#032F62\">`员工${</span><span style=\"color:#24292E\">index</span><span style=\"color:#D73A49\"> +</span><span style=\"color:#005CC5\"> 1</span><span style=\"color:#032F62\">}`</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  department: index </span><span style=\"color:#D73A49\">%</span><span style=\"color:#005CC5\"> 2</span><span style=\"color:#D73A49\"> ===</span><span style=\"color:#005CC5\"> 0</span><span style=\"color:#D73A49\"> ?</span><span style=\"color:#032F62\"> '研发'</span><span style=\"color:#D73A49\"> :</span><span style=\"color:#032F62\"> '设计'</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">}));</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">export</span><span style=\"color:#D73A49\"> const</span><span style=\"color:#005CC5\"> demo</span><span style=\"color:#D73A49\"> =</span><span style=\"color:#24292E\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  title: </span><span style=\"color:#032F62\">'服务端分页'</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  description:</span></span>\n<span class=\"line\"><span style=\"color:#032F62\">    'server 模式表内一行都不切，业务侧拿 onChange.pagination 直接拼请求、回写当前页数据；total 由调用方给出。'</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">};</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">export</span><span style=\"color:#D73A49\"> default</span><span style=\"color:#D73A49\"> function</span><span style=\"color:#6F42C1\"> PaginationServerDemo</span><span style=\"color:#24292E\">() {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">  const</span><span style=\"color:#24292E\"> [</span><span style=\"color:#005CC5\">page</span><span style=\"color:#24292E\">, </span><span style=\"color:#005CC5\">setPage</span><span style=\"color:#24292E\">] </span><span style=\"color:#D73A49\">=</span><span style=\"color:#6F42C1\"> createSignal</span><span style=\"color:#24292E\">(</span><span style=\"color:#005CC5\">1</span><span style=\"color:#24292E\">);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">  const</span><span style=\"color:#24292E\"> [</span><span style=\"color:#005CC5\">pageSize</span><span style=\"color:#24292E\">, </span><span style=\"color:#005CC5\">setPageSize</span><span style=\"color:#24292E\">] </span><span style=\"color:#D73A49\">=</span><span style=\"color:#6F42C1\"> createSignal</span><span style=\"color:#24292E\">(</span><span style=\"color:#005CC5\">5</span><span style=\"color:#24292E\">);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">  const</span><span style=\"color:#24292E\"> [</span><span style=\"color:#005CC5\">request</span><span style=\"color:#24292E\">, </span><span style=\"color:#005CC5\">setRequest</span><span style=\"color:#24292E\">] </span><span style=\"color:#D73A49\">=</span><span style=\"color:#6F42C1\"> createSignal</span><span style=\"color:#24292E\">(</span><span style=\"color:#032F62\">'尚未请求'</span><span style=\"color:#24292E\">);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D\">  // 模拟一次服务端响应：真实项目里这一步换成 fetch 后回写 data 即可。</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">  const</span><span style=\"color:#005CC5\"> currentPageRows</span><span style=\"color:#D73A49\"> =</span><span style=\"color:#6F42C1\"> createMemo</span><span style=\"color:#24292E\">(() </span><span style=\"color:#D73A49\">=></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">    allRows.</span><span style=\"color:#6F42C1\">slice</span><span style=\"color:#24292E\">((</span><span style=\"color:#6F42C1\">page</span><span style=\"color:#24292E\">() </span><span style=\"color:#D73A49\">-</span><span style=\"color:#005CC5\"> 1</span><span style=\"color:#24292E\">) </span><span style=\"color:#D73A49\">*</span><span style=\"color:#6F42C1\"> pageSize</span><span style=\"color:#24292E\">(), </span><span style=\"color:#6F42C1\">page</span><span style=\"color:#24292E\">() </span><span style=\"color:#D73A49\">*</span><span style=\"color:#6F42C1\"> pageSize</span><span style=\"color:#24292E\">()),</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  );</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">  const</span><span style=\"color:#6F42C1\"> onChange</span><span style=\"color:#D73A49\"> =</span><span style=\"color:#24292E\"> (</span><span style=\"color:#E36209\">change</span><span style=\"color:#D73A49\">:</span><span style=\"color:#6F42C1\"> TableChange</span><span style=\"color:#24292E\">)</span><span style=\"color:#D73A49\">:</span><span style=\"color:#005CC5\"> void</span><span style=\"color:#D73A49\"> =></span><span style=\"color:#24292E\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">    const</span><span style=\"color:#005CC5\"> paging</span><span style=\"color:#D73A49\"> =</span><span style=\"color:#24292E\"> change.pagination;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">    if</span><span style=\"color:#24292E\"> (paging </span><span style=\"color:#D73A49\">===</span><span style=\"color:#005CC5\"> undefined</span><span style=\"color:#24292E\">) </span><span style=\"color:#D73A49\">return</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">    setPage</span><span style=\"color:#24292E\">(paging.current);</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">    setPageSize</span><span style=\"color:#24292E\">(paging.pageSize);</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">    setRequest</span><span style=\"color:#24292E\">(</span><span style=\"color:#032F62\">`?page=${</span><span style=\"color:#24292E\">paging</span><span style=\"color:#032F62\">.</span><span style=\"color:#24292E\">current</span><span style=\"color:#032F62\">}&#x26;pageSize=${</span><span style=\"color:#24292E\">paging</span><span style=\"color:#032F62\">.</span><span style=\"color:#24292E\">pageSize</span><span style=\"color:#032F62\">}&#x26;total=${</span><span style=\"color:#24292E\">paging</span><span style=\"color:#032F62\">.</span><span style=\"color:#24292E\">total</span><span style=\"color:#032F62\">}`</span><span style=\"color:#24292E\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  };</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">  return</span><span style=\"color:#24292E\"> (</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">    &#x3C;</span><span style=\"color:#005CC5\">DemoSection</span><span style=\"color:#6F42C1\"> title</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"服务端分页\"</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">      &#x3C;</span><span style=\"color:#22863A\">div</span><span style=\"color:#6F42C1\"> class</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"demo-stack\"</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;</span><span style=\"color:#005CC5\">Table</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">          columns</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{columns}</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">          data</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{</span><span style=\"color:#6F42C1\">currentPageRows</span><span style=\"color:#24292E\">()}</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">          rowKey</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"id\"</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">          server</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">          pagination</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{{</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">            current: </span><span style=\"color:#6F42C1\">page</span><span style=\"color:#24292E\">(),</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">            pageSize: </span><span style=\"color:#6F42C1\">pageSize</span><span style=\"color:#24292E\">(),</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">            total: allRows.</span><span style=\"color:#005CC5\">length</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">            pageSizeOptions: [</span><span style=\"color:#005CC5\">5</span><span style=\"color:#24292E\">, </span><span style=\"color:#005CC5\">10</span><span style=\"color:#24292E\">],</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">            showSizeChanger: </span><span style=\"color:#005CC5\">true</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">            showTotal</span><span style=\"color:#24292E\">: (</span><span style=\"color:#E36209\">total</span><span style=\"color:#24292E\">) </span><span style=\"color:#D73A49\">=></span><span style=\"color:#24292E\"> &#x3C;</span><span style=\"color:#22863A\">span</span><span style=\"color:#24292E\">>服务端共 {total} 条&#x3C;/</span><span style=\"color:#22863A\">span</span><span style=\"color:#24292E\">>,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">          }}</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">          onChange</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{onChange}</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">          aria-label</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"服务端分页表格\"</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        /></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;</span><span style=\"color:#22863A\">span</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">          请求参数：&#x3C;</span><span style=\"color:#22863A\">output</span><span style=\"color:#24292E\">>{</span><span style=\"color:#6F42C1\">request</span><span style=\"color:#24292E\">()}&#x3C;/</span><span style=\"color:#22863A\">output</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;/</span><span style=\"color:#22863A\">span</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">      &#x3C;/</span><span style=\"color:#22863A\">div</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">    &#x3C;/</span><span style=\"color:#005CC5\">DemoSection</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  );</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">}</span></span>\n<span class=\"line\"></span></code></pre>"
