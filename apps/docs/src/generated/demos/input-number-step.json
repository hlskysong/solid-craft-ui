{
  "path": "packages/core/src/components/input/demos/number-step.tsx",
  "source": "import { createSignal } from 'solid-js';\nimport { InputNumber } from 'solid-craft';\nimport { DemoSection } from '../../demos/shared';\n\nexport const demo = {\n  title: '步进与范围',\n  description:\n    '小数步进 0.1、十位步进 10、min / max 到界后按钮置灰，以及 createSignal 驱动的受控写法。',\n};\n\nexport default function NumberStepDemo() {\n  const [decimal, setDecimal] = createSignal<number | null>(0);\n  const [count, setCount] = createSignal<number | null>(5);\n\n  return (\n    <>\n      <DemoSection title=\"小数步进 0.1\">\n        <InputNumber\n          step={0.1}\n          aria-label=\"小数步进\"\n          value={decimal()}\n          onChange={(value) => setDecimal(value)}\n        />\n        <span>\n          当前值：\n          <output>{decimal() ?? '空'}</output>，连点 3 次上箭头得到 0.3。\n        </span>\n      </DemoSection>\n\n      <DemoSection title=\"十位步进 10\">\n        <InputNumber step={10} aria-label=\"十位步进\" defaultValue={100} />\n        <span>每次步进 10，适合以十为单位调整的数量。</span>\n      </DemoSection>\n\n      <DemoSection title=\"到达上下界后按钮禁用\">\n        <InputNumber min={0} max={10} aria-label=\"已到上界的数字\" defaultValue={10} />\n        <InputNumber min={0} max={10} aria-label=\"已到下界的数字\" defaultValue={0} />\n        <span>到达 min / max 后对应按钮变灰禁用，避免「点了没反应」。</span>\n      </DemoSection>\n\n      <DemoSection title=\"受控用法\">\n        <InputNumber\n          min={0}\n          max={20}\n          aria-label=\"受控数字\"\n          value={count()}\n          onChange={(value) => setCount(value)}\n        />\n        <span>\n          当前值：\n          <output>{count() ?? '空'}</output>\n        </span>\n        <button type=\"button\" onClick={() => setCount(20)}>\n          设为 20\n        </button>\n      </DemoSection>\n    </>\n  );\n}\n",
  "html": "<pre class=\"shiki github-light\" style=\"background-color:#fff;color:#24292e\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49\">import</span><span style=\"color:#24292E\"> { createSignal } </span><span style=\"color:#D73A49\">from</span><span style=\"color:#032F62\"> 'solid-js'</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">import</span><span style=\"color:#24292E\"> { InputNumber } </span><span style=\"color:#D73A49\">from</span><span style=\"color:#032F62\"> 'solid-craft'</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">import</span><span style=\"color:#24292E\"> { DemoSection } </span><span style=\"color:#D73A49\">from</span><span style=\"color:#032F62\"> '../../demos/shared'</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">export</span><span style=\"color:#D73A49\"> const</span><span style=\"color:#005CC5\"> demo</span><span style=\"color:#D73A49\"> =</span><span style=\"color:#24292E\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  title: </span><span style=\"color:#032F62\">'步进与范围'</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  description:</span></span>\n<span class=\"line\"><span style=\"color:#032F62\">    '小数步进 0.1、十位步进 10、min / max 到界后按钮置灰，以及 createSignal 驱动的受控写法。'</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">};</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">export</span><span style=\"color:#D73A49\"> default</span><span style=\"color:#D73A49\"> function</span><span style=\"color:#6F42C1\"> NumberStepDemo</span><span style=\"color:#24292E\">() {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">  const</span><span style=\"color:#24292E\"> [</span><span style=\"color:#005CC5\">decimal</span><span style=\"color:#24292E\">, </span><span style=\"color:#005CC5\">setDecimal</span><span style=\"color:#24292E\">] </span><span style=\"color:#D73A49\">=</span><span style=\"color:#6F42C1\"> createSignal</span><span style=\"color:#24292E\">&#x3C;</span><span style=\"color:#005CC5\">number</span><span style=\"color:#D73A49\"> |</span><span style=\"color:#005CC5\"> null</span><span style=\"color:#24292E\">>(</span><span style=\"color:#005CC5\">0</span><span style=\"color:#24292E\">);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">  const</span><span style=\"color:#24292E\"> [</span><span style=\"color:#005CC5\">count</span><span style=\"color:#24292E\">, </span><span style=\"color:#005CC5\">setCount</span><span style=\"color:#24292E\">] </span><span style=\"color:#D73A49\">=</span><span style=\"color:#6F42C1\"> createSignal</span><span style=\"color:#24292E\">&#x3C;</span><span style=\"color:#005CC5\">number</span><span style=\"color:#D73A49\"> |</span><span style=\"color:#005CC5\"> null</span><span style=\"color:#24292E\">>(</span><span style=\"color:#005CC5\">5</span><span style=\"color:#24292E\">);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">  return</span><span style=\"color:#24292E\"> (</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">    &#x3C;></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">      &#x3C;</span><span style=\"color:#005CC5\">DemoSection</span><span style=\"color:#6F42C1\"> title</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"小数步进 0.1\"</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;</span><span style=\"color:#005CC5\">InputNumber</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">          step</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{</span><span style=\"color:#005CC5\">0.1</span><span style=\"color:#24292E\">}</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">          aria-label</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"小数步进\"</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">          value</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{</span><span style=\"color:#6F42C1\">decimal</span><span style=\"color:#24292E\">()}</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">          onChange</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{(</span><span style=\"color:#E36209\">value</span><span style=\"color:#24292E\">) </span><span style=\"color:#D73A49\">=></span><span style=\"color:#6F42C1\"> setDecimal</span><span style=\"color:#24292E\">(value)}</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        /></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;</span><span style=\"color:#22863A\">span</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">          当前值：</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">          &#x3C;</span><span style=\"color:#22863A\">output</span><span style=\"color:#24292E\">>{</span><span style=\"color:#6F42C1\">decimal</span><span style=\"color:#24292E\">() </span><span style=\"color:#D73A49\">??</span><span style=\"color:#032F62\"> '空'</span><span style=\"color:#24292E\">}&#x3C;/</span><span style=\"color:#22863A\">output</span><span style=\"color:#24292E\">>，连点 3 次上箭头得到 0.3。</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;/</span><span style=\"color:#22863A\">span</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">      &#x3C;/</span><span style=\"color:#005CC5\">DemoSection</span><span style=\"color:#24292E\">></span></s