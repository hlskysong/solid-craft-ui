         打开自定义尺寸</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;/</span><span style=\"color:#005CC5\">Button</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;</span><span style=\"color:#005CC5\">Drawer</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">          title</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"自定义高度\"</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">          open</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{</span><span style=\"color:#6F42C1\">customOpen</span><span style=\"color:#24292E\">()}</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">          placement</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"bottom\"</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">          height</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"42vh\"</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">          width</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{</span><span style=\"color:#005CC5\">999</span><span style=\"color:#24292E\">}</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">          onOpenChange</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{setCustomOpen}</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        ></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">          &#x3C;</span><span style=\"color:#22863A\">p</span><span style=\"color:#24292E\">>bottom 方向只认 height：这里传的 width 不会把抽屉撑宽。&#x3C;/</span><span style=\"color:#22863A\">p</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;/</span><span style=\"color:#005CC5\">Drawer</span><span style=\"color:#24292E\">></span></span>\n