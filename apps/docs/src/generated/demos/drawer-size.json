{
  "path": "packages/core/src/components/drawer/demos/size.tsx",
  "source": "import { createSignal } from 'solid-js';\nimport { Button, Drawer, type DrawerSize } from 'solid-craft';\n\nimport { DemoSection } from '../../demos/shared';\n\nexport const demo = {\n  title: '尺寸与显式宽高',\n  description:\n    '三档尺寸共用同一套贴边规则；左右方向用 width、上下方向用 height 显式覆盖，数字按 px 处理。',\n};\n\nconst SIZES: readonly DrawerSize[] = ['small', 'medium', 'large'];\n\nexport default function DrawerSizeDemo() {\n  const [open, setOpen] = createSignal(false);\n  const [customOpen, setCustomOpen] = createSignal(false);\n  const [size, setSize] = createSignal<DrawerSize>('medium');\n\n  const openWith = (next: DrawerSize) => {\n    setSize(next);\n    setOpen(true);\n  };\n\n  return (\n    <>\n      <DemoSection title=\"三档尺寸\">\n        <div class=\"demo-row\">\n          {SIZES.map((item) => (\n            <Button variant=\"outline\" onClick={() => openWith(item)}>\n              打开 {item}\n            </Button>\n          ))}\n        </div>\n        <Drawer title=\"尺寸档位\" open={open()} size={size()} onOpenChange={setOpen}>\n          <p>左右方向的抽屉按 inline-size 铺开，三档分别是 280 / 378 / 520 像素。</p>\n          <p>当前尺寸：{size()}</p>\n        </Drawer>\n      </DemoSection>\n\n      <DemoSection title=\"显式尺寸\">\n        <Button variant=\"outline\" onClick={() => setCustomOpen(true)}>\n          打开自定义尺寸\n        </Button>\n        <Drawer\n          title=\"自定义高度\"\n          open={customOpen()}\n          placement=\"bottom\"\n          height=\"42vh\"\n          width={999}\n          onOpenChange={setCustomOpen}\n        >\n          <p>bottom 方向只认 height：这里传的 width 不会把抽屉撑宽。</p>\n        </Drawer>\n      </DemoSection>\n    </>\n  );\n}\n",
  "html": "<pre class=\"shiki github-light\" style=\"background-color:#fff;color:#24292e\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49\">import</span><span style=\"color:#24292E\"> { createSignal } </span><span style=\"color:#D73A49\">from</span><span style=\"color:#032F62\"> 'solid-js'</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">import</span><span style=\"color:#24292E\"> { Button, Drawer, </span><span style=\"color:#D73A49\">type</span><span style=\"color:#24292E\"> DrawerSize } </span><span style=\"color:#D73A49\">from</span><span style=\"color:#032F62\"> 'solid-craft'</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">import</span><span style=\"color:#24292E\"> { DemoSection } </span><span style=\"color:#D73A49\">from</span><span style=\"color:#032F62\"> '../../demos/shared'</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">export</span><span style=\"color:#D73A49\"> const</span><span style=\"color:#005CC5\"> demo</span><span style=\"color:#D73A49\"> =</span><span style=\"color:#24292E\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  title: </span><span style=\"color:#032F62\">'尺寸与显式宽高'</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  description:</span></span>\n<span class=\"line\"><span style=\"color:#032F62\">    '三档尺寸共用同一套贴边规则；左右方向用 width、上下方向用 height 显式覆盖，数字按 px 处理。'</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">};</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">const</span><span style=\"color:#005CC5\"> SIZES</span><span style=\"color:#D73A49\">:</span><span style=\"color:#D73A49\"> readonly</span><span style=\"color:#6F42C1