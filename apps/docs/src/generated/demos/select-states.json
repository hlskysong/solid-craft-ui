tton</span><span style=\"color:#6F42C1\"> onClick</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{() </span><span style=\"color:#D73A49\">=></span><span style=\"color:#6F42C1\"> setLoading</span><span style=\"color:#24292E\">((</span><span style=\"color:#E36209\">value</span><span style=\"color:#24292E\">) </span><span style=\"color:#D73A49\">=></span><span style=\"color:#D73A49\"> !</span><span style=\"color:#24292E\">value)}></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">          {</span><span style=\"color:#6F42C1\">loading</span><span style=\"color:#24292E\">() </span><span style=\"color:#D73A49\">?</span><span style=\"color:#032F62\"> '结束加载'</span><span style=\"color:#D73A49\"> :</span><span style=\"color:#032F62\"> '进入加载态'</span><span style=\"color:#24292E\">}</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;/</span><span style=\"color:#005CC5\">Button</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">      &#x3C;/</span><span style=\"color:#005CC5\">DemoSection</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E\">      &#x3C;</span><span style=\"color:#005CC5\">DemoSection</span><span style=\"color:#6F42C1\"> title</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"校验与禁用\"</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;</span><span style=\"color:#005CC5\">Select</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">          options</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{cities}</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">          status</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"error\"</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">          placeholder</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"必填项未选择\"</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">          aria-label</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"校验失败的选择器\"</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        /></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;</span><span style=\"color:#005CC5\">Select</span><span style=\"color:#6F42C1\"> options</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{cities} </span><span style=\"color:#6F42C1\">disabled</span><span style=\"color:#6F42C1\"> defaultValue</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"sjz\"</span><span style=\"color:#6F42C1\"> aria-label</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"禁用的选择器\"</span><span style=\"color:#24292E\"> /></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">      &#x3C;/</span><span style=\"color:#005CC5\">DemoSection</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">    &#x3C;/></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  );</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">}</span></span>\n<span class=\"line\"></span></code></pre>"
