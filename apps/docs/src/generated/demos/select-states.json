  "path": "packages/core/src/components/select/demos/states.tsx",
  "source": "import { createSignal } from 'solid-js';\nimport { Button, Select } from 'solid-craft';\nimport { DemoSection } from '../../demos/shared';\n\nconst cities = [\n  { value: 'sjz', label: '石家庄' },\n  { value: 'hd', label: '邯郸' },\n  { value: 'ts', label: '唐山' },\n];\n\nexport const demo = {\n  title: '状态与边界',\n  description: '空选项、加载中、校验失败与禁用四种边界状态。',\n};\n\nexport default function StatesDemo() {\n  const [loading, setLoading] = createSignal(false);\n\n  return (\n    <>\n      <DemoSection title=\"空态与加载\">\n        <Select\n          options={[]}\n          placeholder=\"没有可选项\"\n          emptyText=\"暂无城市数据\"\n          aria-label=\"空选项选择器\"\n        />\n        <Select\n          options={cities}\n          loading={loading()}\n          loadingText=\"正在加载城市列表\"\n          placeholder=\"加载中的选择器\"\n          aria-label=\"加载态选择器\"\n        />\n        <Button onClick={() => setLoading((value) => !value)}>\n          {loading() ? '结束加载' : '进入加载态'}\n        </Button>\n      </DemoSection>\n\n      <DemoSection title=\"校验与禁用\">\n        <Select\n          options={cities}\n          status=\"error\"\n          placeholder=\"必填项未选择\"\n          aria-label=\"校验失败的选择器\"\n        />\n        <Select options={cities} disabled defaultValue=\"sjz\" aria-label=\"禁用的选择器\" />\n      </DemoSection>\n    </>\n  );\n}\n",
