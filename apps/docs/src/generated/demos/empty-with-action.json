49\">=</span><span style=\"color:#032F62\">\"引导新建\"</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;</span><span style=\"color:#005CC5\">Empty</span><span style=\"color:#6F42C1\"> description</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"还没有维简设备采购计划\"</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">          &#x3C;</span><span style=\"color:#005CC5\">Button</span><span style=\"color:#6F42C1\"> variant</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"solid\"</span><span style=\"color:#24292E\">>新建计划&#x3C;/</span><span style=\"color:#005CC5\">Button</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;/</span><span style=\"color:#005CC5\">Empty</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">      &#x3C;/</span><span style=\"color:#005CC5\">DemoSection</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#24292E\">      &#x3C;</span><span style=\"color:#005CC5\">DemoSection</span><span style=\"color:#6F42C1\"> title</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"两个操作\"</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;</span><span style=\"color:#005CC5\">Empty</span><span style=\"color:#6F42C1\"> description</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"当前筛选条件下没有匹配结果\"</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">          &#x3C;</span><span style=\"color:#005CC5\">Button</span><span style=\"color:#24292E\">>清空筛选&#x3C;/</span><span style=\"color:#005CC5\">Button</span><span style=\"color:#24292E\">></span></span>\n<sp