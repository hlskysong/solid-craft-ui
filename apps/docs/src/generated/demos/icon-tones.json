  "source": "import {\n  Activity,\n  Bell,\n  ChartColumn,\n  Folder,\n  House,\n  Loader,\n  Search,\n  Star,\n} from 'solid-craft-icons';\nimport { For, type Component } from 'solid-js';\nimport { Icon } from 'solid-craft';\nimport { DemoSection } from '../../demos/shared';\n\nexport const demo = {\n  title: '语义色与旋转',\n  description: '七档语义色一次对照，以及 spin 在加载态里的用法。',\n};\n\n/** 顺序与 `IconProps['tone']` 的声明顺序一致；`as const` 让取值不接受拼错。 */\nconst TONES = [\n  'primary',\n  'secondary',\n  'tertiary',\n  'disabled',\n  'success',\n  'warning',\n  'danger',\n] as const;\n\n/** 按 tone 建索引而不是按下标取数组：`noUncheckedIndexedAccess` 下后者会带 undefined。 */\nconst TONE_ICONS: Record<(typeof TONES)[number], Component> = {\n  primary: House,\n  secondary: Search,\n  tertiary: Star,\n  disabled: Folder,\n  success: Activity,\n  warning: Bell,\n  danger: ChartColumn,\n};\n\nexport default function Tones() {\n  return (\n    <>\n      <DemoSection title=\"语义色\">\n        <For each={TONES}>\n          {(tone) => {\n            const Glyph = TONE_ICONS[tone];\n            return (\n              <Icon tone={tone} label={`${tone} 图标`}>\n                <Glyph />\n              </Icon>\n            );\n          }}\n        </For>\n      </DemoSection>\n      <DemoSection title=\"加载旋转\">\n        <Icon spin label=\"正在加载\">\n          <Loader />\n        </Icon>\n      </DemoSection>\n    </>\n  );\n}\n",
  "html": "<pre class=\"shiki github-light\" style=\"background-color:#fff;color:#24292e\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49\">import</span><span style=\"color:#24292E\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  Activity,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  Bell,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  ChartColumn,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  Folder,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  House,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  Loader,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  Search,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  Star,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">} </span><span style=\"color:#D73A49\">from</span><span style=\"color:#032F62\"> 'solid-craft-icons'</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">import</span><span style=\"color:#24292E\"> { For, </span><span style=\"color:#D73A49\">type</span><span style=\"color:#24292E\"> Component } </span><span style=\"color:#D73A49\">from</span><span style=\"color:#032F62\"> 'solid-js'</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">import</span><span style=\"color:#24292E\"> { Icon } </span><span style=\"color:#D73A49\">from</span><span style=\"color:#032F62\"> 'solid-craft'</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">import</span><span style=\"color:#24292E\"> { DemoSection } </span><span style=\"color:#D73A49\">from</span><span style=\"color:#032F62\"> '../../demos/shared'</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">export</span><span style=\"col