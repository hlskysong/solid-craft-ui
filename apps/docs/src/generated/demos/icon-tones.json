\">/** 按 tone 建索引而不是按下标取数组：`noUncheckedIndexedAccess` 下后者会带 undefined。 */</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">const</span><span style=\"color:#005CC5\"> TONE_ICONS</span><span style=\"color:#D73A49\">:</span><span style=\"color:#6F42C1\"> Record</span><span style=\"color:#24292E\">&#x3C;(</span><span style=\"color:#D73A49\">typeof</span><span style=\"color:#005CC5\"> TONES</span><span style=\"color:#24292E\">)[</span><span style=\"color:#005CC5\">number</span><span style=\"color:#24292E\">], </span><span style=\"color:#6F42C1\">Component</span><span style=\"color:#24292E\">> </span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  primary: House,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  secondary: Search,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  tertiary: Star,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  disabled: Folder,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  success: Activity,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  warning: Bell,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  danger: ChartColumn,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">};</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">export</span><span style=\"color:#D73A49\"> default</span><span style=\"color:#D73A49\"> function</span><span style=\"color:#6F42C1\"> Tones</span><span style=\"color:#24292E\">() {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">  return</span><span style=\"color:#24292E\"> (</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">    &#x3C;></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">      &#x3C;</span><span style=\"color:#005CC5\">DemoSection</span><span style=\"color:#6F42C1\"> title</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"语义色\"</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;</span><span style=\"color:#005CC5\">For</span><span style=\"color:#6F42C1\"> each</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{</span><span style=\"color:#005CC5\">TONES</span><span style=\"color:#24292E\">}></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">          {(</span><span style=\"color:#E36209\">tone</span><span style=\"color:#24292E\">) </span><span style=\"color:#D73A49\">=></span><span style=\"color:#24292E\"> {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">            const</span><span style=\"color:#005CC5\"> Glyph</span><span style=\"color:#D73A49\"> =</span><span style=\"color:#005CC5\"> TONE_ICONS</span><span style=\"color:#24292E\">[tone];</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">            return</span><span style=\"color:#24292E\"> (</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">              &#x3C;</span><span style=\"color:#005CC5\">Icon</span><span style=\"color:#6F42C1\"> tone</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{tone} </span><span style=\"color:#6F42C1\">label</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{</span><span style=\"color:#032F62\">`${</span><span style=\"color:#24292E\">tone</span><span style=\"color:#032F62\">} 图标`</span><span style=\"color:#24292E\">}></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">                &#x3C;</span><span style=\"color:#005CC5\">Glyph</span><span style=\"color:#24292E\"> /></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">              &#x3C;/</span><span style=\"color:#005CC5\">Icon</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">            );</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">          }}</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;/</span><span style=\"color:#005CC5\">For</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">      &#x3C;/</span><span style=\"color:#005CC5\">DemoSection</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">      &#x3C;</span><span style=\"color:#005CC5\">DemoSection</span><span style=\"color:#6F42C1\"> title</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"加载旋转\"</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;</span><span style=\"color:#005CC5\">Icon</span><span style=\"color:#6F42C1\"> spin</span><span style=\"color:#6F42C1\"> label</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"正在加载\"</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">          &#x3C;</span><span style=\"color:#005CC5\">Loader</span><span style=\"color:#24292E\"> /></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;/</span><span style=\"color:#005CC5\">Icon</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">      &#x3C;/</span><span style=\"color:#005CC5\">DemoSection</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">    &#x3C;/></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  );</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">}</span></span>\n<span class=\"line\"></span></code></pre>"
