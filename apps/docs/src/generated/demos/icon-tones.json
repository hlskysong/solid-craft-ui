  "source": "import { For } from 'solid-js';\nimport { Icon } from 'solid-craft';\nimport { DemoSection, DotIcon } from '../../demos/shared';\n\nexport const demo = {\n  title: '语义色与旋转',\n  description: '七档语义色一次对照，以及 spin 在加载态里的用法。',\n};\n\n/** 顺序与 `IconProps['tone']` 的声明顺序一致；`as const` 让取值不接受拼错。 */\nconst TONES = [\n  'primary',\n  'secondary',\n  'tertiary',\n  'disabled',\n  'success',\n  'warning',\n  'danger',\n] as const;\n\nexport default function Tones() {\n  return (\n    <>\n      <DemoSection title=\"语义色\">\n        <For each={TONES}>\n          {(tone) => (\n            <Icon tone={tone} label={`${tone} 图标`}>\n              <DotIcon />\n            </Icon>\n          )}\n        </For>\n      </DemoSection>\n      <DemoSection title=\"加载旋转\">\n        <Icon spin label=\"正在加载\">\n          <svg viewBox=\"0 0 16 16\" width=\"16\" height=\"16\" aria-hidden=\"true\">\n            <path\n              d=\"M8 1.5A6.5 6.5 0 1 1 1.5 8\"\n              fill=\"none\"\n              stroke=\"currentColor\"\n              stroke-width=\"2\"\n              stroke-linecap=\"round\"\n            />\n          </svg>\n        </Icon>\n      </DemoSection>\n    </>\n  );\n}\n",
  "html": "<pre class=\"shiki github-light\" style=\"background-color:#fff;color:#24292e\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49\">import</span><span style=\"color:#24292E\"> { For } </span><span style=\"color:#D73A49\">from</span><span style=\"color:#032F62\"> 'solid-js'</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">import</span><span style=\"color:#24292E\"> { Icon } </span><span style=\"color:#D73A49\">from</span><span style=\"color:#032F62\"> 'solid-craft'</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">import</span><span style=\"color:#24292E\"> { DemoSection, DotIcon } </span><span style=\"color:#D73A49\">from</span><span style=\"color:#032F62\"> '../../demos/shared'</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">export</span><span style=\"color:#D73A49\"> const</span><span style=\"color:#005CC5\"> demo</span><span style=\"color:#D73A49\"> =</span><span style=\"color:#24292E\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  title: </span><span style=\"color:#032F62\">'语义色与旋转'</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  description: </span><span style=\"color:#032F62\">'七档语义色一次对照，以及 spin 在加载态里的用法。'</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">};</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D\">/** 顺序与 `IconProps['tone']` 的声明顺序一致；`as const` 让取值不接受拼错。 */</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">const</span><span style=\"color:#005CC5\"> TONES</span><span style=\"color:#D73A49\"> =</span><span style=\"color:#24292E\"> [</span></span>\n<span class=\"line\"><span style=\"color:#032F62\">  'primary'</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#032F62\">  'secondary'</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#032F62\">  'tertiary'</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#032F62\">  'disabled'</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#032F62\">  'success'</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#032F62\">  'warning'</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#032F62\">  'danger'</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">] </span><span style=\"color:#D73A49\">as</span><span style=\"color:#D73A49\"> const</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">export</span><span style=\"color:#D73A49\"> default</span><span style=\"color:#D73A49\"> function</span><span style=\"color:#6F42C1\"> Tones</span><span style=\"color:#24292E\">() {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">  return</span><span style=\"color:#24292E\"> (</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">    &#x3C;></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">      &#x3C;</span><span style=\"color:#005CC5\">DemoSection</span><span style=\"color:#6F42C1\"> title</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"语义色\"</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;</span><span style=\"color:#005CC5\">For</span><span style=\"color:#6F42C1\"> each</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{</span><span style=\"color:#005CC5\">TONES</span><span style=\"color:#24292E\">}></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">          {(</span><span style=\"color:#E36209\">tone</span><span style=\"color:#24292E\">) </span><span style=\"color:#D73A49\">=></span><span style=\"color:#24292E\"> (</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">            &#x3C;</span><span style=\"color:#005CC5\">Icon</span><span style=\"color:#6F42C1\"> tone</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{tone} </span><span style=\"color:#6F42C1\">label</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{</span><span style=\"color:#032F62\">`${</span><span style=\"color:#24292E\">tone</span><span style=\"color:#032F62\">} 图标`</span><span style=\"color:#24292E\">}></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">              &#x3C;</span><span style=\"color:#005CC5\">DotIcon</span><span style=\"color:#24292E\"> /></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">            &#x3C;/</span><span style=\"color:#005CC5\">Icon</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">          )}</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;/</span><span style=\"color:#005CC5\">For</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">      &#x3C;/</span><span style=\"color:#005CC5\">DemoSection</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">      &#x3C;</span><span style=\"color:#005CC5\">DemoSection</span><span style=\"color:#6F42C1\"> title</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"加载旋转\"</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;</span><span style=\"color:#005CC5\">Icon</span><span style=\"color:#6F42C1\"> spin</span><span style=\"color:#6F42C1\"> label</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"正在加载\"</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">          &#x3C;</span><span style=\"color:#22863A\">svg</span><span style=\"color:#6F42C1\"> viewBox</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"0 0 16 16\"</span><span style=\"color:#6F42C1\"> width</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"16\"</span><span style=\"color:#6F42C1\"> height</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"16\"</span><span style=\"color:#6F42C1\"> aria-hidden</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"true\"</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">            &#x3C;</span><span style=\"color:#22863A\">path</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">              d</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"M8 1.5A6.5 6.5 0 1 1 1.5 8\"</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">              fill</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"none\"</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">              stroke</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"currentColor\"</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">              stroke-width</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"2\"</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">              stroke-linecap</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"round\"</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">            /></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">          &#x3C;/</span><span style=\"color:#22863A\">svg</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;/</span><span style=\"color:#005CC5\">Icon</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">      &#x3C;/</span><span style=\"color:#005CC5\">DemoSection</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">    &#x3C;/></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  );</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">}</span></span>\n<span class=\"line\"></span></code></pre>"
}
