ateTime</span><span style=\"color:#24292E\">, </span><span style=\"color:#005CC5\">setDateTime</span><span style=\"color:#24292E\">] </span><span style=\"color:#D73A49\">=</span><span style=\"color:#6F42C1\"> createSignal</span><span style=\"color:#24292E\">(</span><span style=\"color:#032F62\">'2026-03-15T09:30'</span><span style=\"color:#24292E\">);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">  return</span><span style=\"color:#24292E\"> (</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">    &#x3C;></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">      &#x3C;</span><span style=\"color:#005CC5\">DemoSection</span><span style=\"color:#6F42C1\"> title</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"自定义格式\"</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;</span><span style=\"color:#005CC5\">DatePicker</span><span style=\"color:#6F42C1\"> format</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"YYYY年M月D日\"</span><span style=\"color:#6F42C1\"> defaultValue</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"2026-03-15\"</span><span style=\"color:#6F42C1\"> aria-label</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"中文格式\"</span><span style=\"color:#24292E\"> /></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;</span><span style=\"color:#005CC5\">DatePicker</span><span style=\"color:#6F42C1\"> format</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"MM/DD\"</span><span style=\"color:#6F42C1\"> defaultValue</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"2026-03-15\"</span><span style=\"color:#6F42C1\"> aria-label</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"短格式\"</span><span style=\"color:#24292E\"> 