  "source": "import { For } from 'solid-js';\nimport { Button, Icon } from 'solid-craft';\nimport { DemoSection, SIZES } from '../../demos/shared';\n\nexport const demo = {\n  title: '自定义图标与内联',\n  description: '自带 SVG 直接嵌入、尺寸由 Icon 统一控制，以及按钮内的图标对齐。',\n};\n\n/** 自定义 SVG 只负责形状：宽高由 `Icon` 的 `size` 统一决定。 */\nfunction Triangle() {\n  return (\n    <svg viewBox=\"0 0 16 16\" aria-hidden=\"true\">\n      <path d=\"M8 2 14 13H2Z\" fill=\"currentColor\" />\n    </svg>\n  );\n}\n\nexport default function Custom() {\n  return (\n    <>\n      <DemoSection title=\"自定义 SVG 与尺寸\">\n        <For each={SIZES}>\n          {(size) => (\n            <Icon size={size} label={`${size} 三角图标`}>\n              <Triangle />\n            </Icon>\n          )}\n        </For>\n      </DemoSection>\n      <DemoSection title=\"按钮内对齐\">\n        <Button>\n          <Icon size=\"small\">\n            <Triangle />\n          </Icon>\n          导出\n        </Button>\n        <Button variant=\"outline\">\n          <Icon size=\"small\">\n            <Triangle />\n          </Icon>\n          复制\n        </Button>\n      </DemoSection>\n    </>\n  );\n}\n",
  "html": "<pre class=\"shiki github-light\" style=\"background-color:#fff;color:#24292e\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49\">import</span><span style=\"color:#24292E\"> { For } </span><span style=\"color:#D73A49\">from</span><span style=\"color:#032F62\"> 'solid-js'</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">import</span><span style=\"color:#24292E\"> { Button, Icon } </span><span style=\"color:#D73A49\">from</span><span style=\"color:#032F62\"> 'solid-craft'</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">import</span><span style=\"color:#24292E\"> { DemoSection, SIZES } </span><span style=\"color:#D73A49\">from</span><span style=\"color:#032F62\"> '../../demos/shared'</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">export</span><span style=\"color:#D73A49\"> const</span><span style=\"color:#005CC5\"> demo</span><span style=\"color:#D73A49\"> =</span><span style=\"color:#24292E\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  title: </span><span style=\"color:#032F62\">'自定义图标与内联'</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  description: </span><span style=\"color:#032F62\">'自带 SVG 直接嵌入、尺寸由 Icon 统一控制，以及按钮内的图标对齐。'</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">};</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#6A737D\">/** 自定义 SVG 只负责形状：宽高由 `Icon` 的 `size` 统一决定。 */</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">function</span><span style=\"color:#6F42C1\"> Triangle</span><span style=\"color:#24292E\">() {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">  return</span><span style=\"color:#24292E\"> (</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">    &#x3C;</span><span style=\"color:#22863A\">svg</span><span style=\"color:#6F42C1\"> viewBox</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"0 0 16 16\"</span><span style=\"color:#6F42C1\"> aria-hidden</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"true\"</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">      &#x3C;</span><span style=\"color:#22863A\">path</span><span style=\"color:#6F42C1\"> d</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"M8 2 14 13H2Z\"</span><span style=\"color:#6F42C1\"> fill</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"currentColor\"</span><span style=\"color:#24292E\"> /></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">    &#x3C;/</span><span style=\"color:#22863A\">svg</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  );</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">}</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">export</span><span style=\"color:#D73A49\"> default</span><span style=\"color:#D73A49\"> function</span><span style=\"color:#6F42C1\"> Custom</span><span style=\"color:#24292E\">() {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">  return</span><span style=\"color:#24292E\"> (</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">    &#x3C;></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">      &#x3C;</span><span style=\"color:#005CC5\">DemoSection</span><span style=\"color:#6F42C1\"> title</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"自定义 SVG 与尺寸\"</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;</span><span style=\"color:#0