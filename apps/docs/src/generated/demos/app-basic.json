  "source": "import { Button, message } from 'solid-craft';\nimport { DemoSection } from '../../demos/shared';\n\nexport const demo = {\n  title: '基础用法',\n  description: '脱离组件树调用静态 message，五种语义各用一个按钮触发。',\n};\n\nexport default function AppBasicDemo() {\n  return (\n    <>\n      <DemoSection title=\"静态短提示\">\n        <Button\n          onClick={() => {\n            message.info('普通提示');\n          }}\n        >\n          普通提示\n        </Button>\n        <Button\n          onClick={() => {\n            message.success('操作成功');\n          }}\n        >\n          成功提示\n        </Button>\n        <Button\n          onClick={() => {\n            message.warning('请注意风险');\n          }}\n        >\n          警告提示\n        </Button>\n      </DemoSection>\n      <DemoSection title=\"异常与加载\">\n        <Button\n          onClick={() => {\n            message.error('操作失败');\n          }}\n        >\n          错误提示\n        </Button>\n        <Button\n          onClick={() => {\n            message.loading('加载中');\n          }}\n        >\n          加载提示\n        </Button>\n      </DemoSection>\n    </>\n  );\n}\n",
