  "path": "packages/core/src/components/tabs/demos/lazy.tsx",
  "source": "import { Tabs } from 'solid-craft';\n\nimport { DemoSection } from '../../demos/shared';\n\nexport const demo = {\n  title: '懒加载开关',\n  description:\n    'lazy 默认 true：未激活 panel 的 content 工厂一次都不调用，切换才创建。lazy=false 时所有 panel 首帧挂载，非激活的用原生 hidden 收起，不重复创建。',\n};\n\nconst makeItems = (mode: string) => [\n  {\n    key: 'first',\n    label: '第一页',\n    content: () => <div data-testid={`tabs-lazy-${mode}-first`}>第一页内容：概览数据。</div>,\n  },\n  {\n    key: 'second',\n    label: '第二页',\n    content: () => <div data-testid={`tabs-lazy-${mode}-second`}>第二页内容：明细表格。</div>,\n  },\n  {\n    key: 'third',\n    label: '第三页',\n    content: () => <div data-testid={`tabs-lazy-${mode}-third`}>第三页内容：审批意见。</div>,\n  },\n];\n\nexport default function TabsLazyDemo() {\n  return (\n    <DemoSection title=\"懒加载\">\n      <div class=\"demo-column\">\n        <h3>默认 lazy=true（只挂载激活 panel）</h3>\n        <Tabs items={makeItems('lazy')} aria-label=\"懒加载标签页\" data-testid=\"tabs-lazy-on\" />\n        <h3>lazy=false（全部挂载，非激活 hidden）</h3>\n        <Tabs\n          items={makeItems('eager')}\n          lazy={false}\n          aria-label=\"全量挂载标签页\"\n          data-testid=\"tabs-lazy-off\"\n        />\n      </div>\n    </DemoSection>\n  );\n}\n",
  "html": "<pre class=\"shiki github-light\" style=\"background-color:#fff;color:#24292e\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49\">import</span><span style=\"color:#24292E\"> { Tabs } </span><span style=\"color:#D73A49\">from</span><span style=\"color:#032F62\"> 'solid-craft'</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">import</span><span style=\"color:#24292E\"> { DemoSection } </span><span style=\"color:#D73A49\">from</span><span style=\"color:#032F62\"> '../../demos/shared'</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">export</span><span style=\"color:#D73A49\"> const</span><span style=\"color:#005CC5\"> demo</span><span style=\"color:#D73A49\"> =</span><span style=\"color:#24292E\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  title: </span><span style=\"color:#032F62\">'懒加载开关'</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  description:</span></span>\n<span class=\"line\"><span style=\"color:#032F62\">    'lazy 默认 true：未激活 panel 的 content 工厂一次都不调用，切换才创建。lazy=false 时所有 panel 首帧挂载，非激活的用原生 hidden 收起，不重复创建。'</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">};</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">const</span><span style=\"color:#6F42C1\"> makeItems</span><span style=\"color:#D73A49\"> =</span><span style=\"color:#24292E\"> (</span><span style=\"color:#E36209\">mode</span><span style=\"color:#D73A49\">:</span><span style=\"color:#005CC5\"> string</span><span style=\"color:#24292E\">) </span><span style=\"color:#D73A49\">=></span><span style=\"color:#24292E\"> [</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  {</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">    key: </span><span style=\"color:#032F62\">'first'</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">    label: </span><span style=\"color:#032F62\">'第一页'</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">    content</span><span style=\"color:#24292E\">: () </span><span style=\"color:#D73A49\">=></span><span style=\"color:#24292E\"> &#x3C;</span><span style=\"color:#22863A\">div</span><span style=\"color:#6F42C1\"> data-testid</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{</span><span style=\"color:#032F62\">`tabs-lazy-${</span><span style=\"color:#24292E\">mode</span><span style=\"color:#032F62\">}-first`</span><span style=\"color:#24292E\">}>第一页内容：概览数据。&#x3C;/</span><span style=\"color:#22863A\">div</span><span style=\"color:#24292E\">>,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  },</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  {</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">    key: </span><span style=\"color:#032F62\">'second'</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">    label: </span><span style=\"color:#032F62\">'第二页'</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">    content</span><span style=\"color:#24292E\">: () </span><span style=\"color:#D73A49\">=></span><span style=\"color:#24292E\"> &#x3C;</span><span style=\"color:#22863A\">div</span><span style=\"color:#6F42C1\"> data-testid</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{</span><span style=\"color:#032F62\">`tabs-lazy-${</span><span style=\"color:#24292E\">mode</span><span style=\"color:#032F62\">}-second`</span><span style=\"color:#24292E\">}>第二页内容：明细表格。&#x3C;/</span><span style=\"color:#22863A\">div</span><span style=\"color:#24292E\">>,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  },</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  {</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">    key: </span><span style=\"color:#032F62\">'third'</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">    label: </span><span style=\"color:#032F62\">'第三页'</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">    content</span><span style=\"color:#24292E\">: () </span><span style=\"color:#D73A49\">=></span><span style=\"color:#24292E\"> &#x3C;</span><span style=\"color:#22863A\">div</span><span style=\"color:#6F42C1\"> data-testid</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{</span><span style=\"color:#032F62\">`tabs-lazy-${</span><span style=\"color:#24292E\">mode</span><span style=\"color:#032F62\">}-third`</span><span style=\"color:#24292E\">}>第三页内容：审批意见。&#x3C;/</span><span style=\"color:#22863A\">div</span><span style=\"color:#24292E\">>,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  },</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">];</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">export</span><span style=\"color:#D73A49\"> default</span><span style=\"color:#D73A49\"> function</span><span style=\"color:#6F42C1\"> TabsLazyDemo</span><span style=\"color:#24292E\">() {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">  return</span><span style=\"color:#24292E\"> (</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">    &#x3C;</span><span style=\"color:#005CC5\">DemoSection</span><span style=\"color:#6F42C1\"> title</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"懒加载\"</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#242