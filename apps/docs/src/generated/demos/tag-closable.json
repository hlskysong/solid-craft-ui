  "source": "import { createSignal } from 'solid-js';\nimport { Tag } from 'solid-craft';\n\nimport { DemoSection } from '../../demos/shared';\n\nexport const demo = {\n  title: '可关闭',\n  description:\n    '关闭是非受控的：组件自己移除 DOM 并发一次 onClose。关闭按钮恒带 aria-label，可用 closeLabel 覆盖。',\n};\n\nexport default function TagClosableDemo() {\n  const [closed, setClosed] = createSignal(0);\n\n  const handleClose = (): void => {\n    setClosed(closed() + 1);\n  };\n\n  return (\n    <DemoSection title=\"可关闭\">\n      <div class=\"demo-column\">\n        <div class=\"demo-row\">\n          <Tag closable onClose={handleClose}>\n            待复核\n          </Tag>\n          <Tag closable closeLabel=\"移除已通过标签\" color=\"success\" onClose={handleClose}>\n            已通过\n          </Tag>\n          <Tag closable color=\"danger\" onClose={handleClose}>\n            已驳回\n          </Tag>\n          <Tag color=\"neutral\">不可关闭</Tag>\n        </div>\n        <p data-testid=\"tag-close-count\">累计关闭 {closed()} 次</p>\n        <p data-testid=\"tag-close-log\">当前状态：{closed() === 0 ? '尚未关闭' : '已有关闭'}</p>\n      </div>\n    </DemoSection>\n  );\n}\n",
  "html": "<pre class=\"shiki github-light\" style=\"background-color:#fff;color:#24292e\" tabindex=\"0\"><code><span class=\"line\"><span style=\"color:#D73A49\">import</span><span style=\"color:#24292E\"> { createSignal } </span><span style=\"color:#D73A49\">from</span><span style=\"color:#032F62\"> 'solid-js'</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">import</span><span style=\"color:#24292E\"> { Tag } </span><span style=\"color:#D73A49\">from</span><span style=\"color:#032F62\"> 'solid-craft'</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">import</span><span style=\"color:#24292E\"> { DemoSection } </span><span style=\"color:#D73A49\">from</span><span style=\"color:#032F62\"> '../../demos/shared'</span><span style=\"color:#24292E\">;</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">export</span><span style=\"color:#D73A49\"> const</span><span style=\"color:#005CC5\"> demo</span><span style=\"color:#D73A49\"> =</span><span style=\"color:#24292E\"> {</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  title: </span><span style=\"color:#032F62\">'可关闭'</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  description:</span></span>\n<span class=\"line\"><span style=\"color:#032F62\">    '关闭是非受控的：组件自己移除 DOM 并发一次 onClose。关闭按钮恒带 aria-label，可用 closeLabel 覆盖。'</span><span style=\"color:#24292E\">,</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">};</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">export</span><span style=\"color:#D73A49\"> default</span><span style=\"color:#D73A49\"> function</span><span style=\"color:#6F42C1\"> TagClosableDemo</span><span style=\"color:#24292E\">() {</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">  const</span><span style=\"color:#24292E\"> [</span><span style=\"color:#005CC5\">closed</span><span style=\"color:#24292E\">, </span><span style=\"color:#005CC5\">setClosed</span><span style=\"color:#24292E\">] </span><span style=\"color:#D73A49\">=</span><span style=\"color:#6F42C1\"> createSignal</span><span style=\"color:#24292E\">(</span><span style=\"color:#005CC5\">0</span><span style=\"color:#24292E\">);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">  const</span><span style=\"color:#6F42C1\"> handleClose</span><span style=\"color:#D73A49\"> =</span><span style=\"color:#24292E\"> ()</span><span style=\"color:#D73A49\">:</span><span style=\"color:#005CC5\"> void</span><span style=\"color:#D73A49\"> =></span><span style=\"color:#24292E\"> {</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">    setClosed</span><span style=\"color:#24292E\">(</span><span style=\"color:#6F42C1\">closed</span><span style=\"color:#24292E\">() </span><span style=\"color:#D73A49\">+</span><span style=\"color:#005CC5\"> 1</span><span style=\"color:#24292E\">);</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  };</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">  return</span><span style=\"color:#24292E\"> (</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">    &#x3C;</span><span style=\"color:#005CC5\">DemoSection</span><span style=\"color:#6F42C1\"> title</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"可关闭\"</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">      &#x3C;</span><span style=\"color:#22863A\">div</span><span style=\"color:#6F42C1\"> class</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"demo-column\"</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;</span><span style=\"color:#22863A\">div</span><span style=\"color:#6F42C1\"> class</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"demo-row\"</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">          &#x3C;</span><span style=\"color:#005CC5\">Tag</span><span style=\"color:#6F42C1\"> closable</span><span style=\"color:#6F42C1\"> onClose</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{handleClose}></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">            待复核</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">          &#x3C;/</span><span style=\"color:#005CC5\">Tag</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">          &#x3C;</span><span style=\"color:#005CC5\">Tag</span><span style=\"color:#6F42C1\"> closable</span><span style=\"color:#6F42C1\"> closeLabel</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"移除已通过标签\"</span><span style=\"color:#6F42C1\"> color</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"success\"</span><span style=\"color:#6F42C1\"> onClose</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{handleClose}></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">            已通过</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">          &#x3C;/</span><span style=\"color:#005CC5\">Tag</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">          &#x3C;</span><span style=\"color:#005CC5\">Tag</span><span style=\"color:#6F42C1\"> closable</span><span style=\"color:#6F42C1\"> color</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"danger\"</span><span style=\"color:#6F42C1\"> onClose</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{handleClose}></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">            已驳回</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">          &#x3C;/</span><span style=\"color:#005CC5\">Tag</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">          &#x3C;</span><span style=\"color:#005CC5\">Tag</span><span style=\"color:#6F42C1\"> color</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"neutral\"</span><span style=\"color:#24292E\">>不可关闭&#x3C;/</span><span style=\"color:#005CC5\">Tag</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;/</span><span style=\"color:#22863A\">div</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;</span><span style=\"color:#22863A\">p</span><span style=\"color:#6F42C1\"> data-testid</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"tag-close-count\"</span><span style=\"color:#24292E\">>累计关闭 {</span><span style=\"color:#6F42C1\">closed</span><span style=\"color:#24292E\">()} 次&#x3C;/</span><span style=\"color:#22863A\">p</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;</span><span style=\"color:#22863A\">p</span><span style=\"color:#6F42C1\"> data-testid</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"tag-close-log\"</span><span style=\"color:#24292E\">>当前状态：{</span><span style=\"color:#6F42C1\">closed</span><span style=\"color:#24292E\">() </span><span style=\"color:#D73A49\">===</span><span style=\"color:#005CC5\"> 0</span><span style=\"color:#D73A49\"> ?</span><span style=\"color:#032F62\"> '尚未关闭'</span><span style=\"color:#D73A49\"> :</span><span style=\"color:#032F62\"> '已有关闭'</span><span style=\"color:#24292E\">}&#x3C;/</span><span style=\"color:#22863A\">p</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">      &#x3C;/</span><span style=\"color:#22863A\">div</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">    &#x3C;/</span><span style=\"color:#005CC5\">DemoSection</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  );</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">}</span></span>\n<span class=\"line\"></span></code></pre>"
