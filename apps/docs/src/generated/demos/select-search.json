  "source": "import { createSignal } from 'solid-js';\nimport { Select } from 'solid-craft';\nimport { DemoSection } from '../../demos/shared';\n\nconst cities = [\n  { value: 'sjz', label: '石家庄' },\n  { value: 'hd', label: '邯郸' },\n  { value: 'ts', label: '唐山' },\n  { value: 'bd', label: '保定' },\n  { value: 'qhd', label: '秦皇岛' },\n];\n\nexport const demo = {\n  title: '搜索与清除',\n  description: '开启本地搜索按选项文案过滤，开启清除后可一键清空已选值。',\n};\n\nexport default function SearchDemo() {\n  const [searched, setSearched] = createSignal('');\n  const [cleared, setCleared] = createSignal('ts');\n\n  return (\n    <>\n      <DemoSection title=\"本地搜索\">\n        <Select\n          options={cities}\n          searchable\n          clearable\n          placeholder=\"请选择城市\"\n          searchPlaceholder=\"搜索城市\"\n          clearLabel=\"清除已选城市\"\n          emptyText=\"没有匹配的城市\"\n          onChange={(value) => setSearched(value)}\n          aria-label=\"可搜索的城市\"\n        />\n        <span>\n          当前选中：<output>{searched() === '' ? '（未选择）' : searched()}</output>\n        </span>\n      </DemoSection>\n\n      <DemoSection title=\"带默认值可清除\">\n        <Select\n          options={cities}\n          defaultValue=\"ts\"\n          clearable\n          placeholder=\"请选择城市\"\n          clearLabel=\"清除已选城市\"\n          onChange={(value) => setCleared(value)}\n          aria-label=\"可清除的城市\"\n        />\n        <span>\n          当前选中：<output>{cleared() === '' ? '（已清空）' : cleared()}</output>\n        </span>\n      </DemoSection>\n    </>\n  );\n}\n",
