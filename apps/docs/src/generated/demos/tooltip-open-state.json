 const</span><span style=\"color:#24292E\"> [</span><span style=\"color:#005CC5\">open</span><span style=\"color:#24292E\">, </span><span style=\"color:#005CC5\">setOpen</span><span style=\"color:#24292E\">] </span><span style=\"color:#D73A49\">=</span><span style=\"color:#6F42C1\"> createSignal</span><span style=\"color:#24292E\">(</span><span style=\"color:#005CC5\">true</span><span style=\"color:#24292E\">);</span></span>\n<span class=\"line\"><span style=\"color:#D73A49\">  const</span><span style=\"color:#24292E\"> [</span><span style=\"color:#005CC5\">arrow</span><span style=\"color:#24292E\">, </span><span style=\"color:#005CC5\">setArrow</span><span style=\"color:#24292E\">] </span><span style=\"color:#D73A49\">=</span><span style=\"color:#6F42C1\"> createSignal</span><span style=\"color:#24292E\">(</span><span style=\"color:#005CC5\">true</span><span style=\"color:#24292E\">);</span></span>\n<span class=\"line\"></span>\n<span class=\"line\"><span style=\"color:#D73A49\">  return</span><span style=\"color:#24292E\"> (</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">    &#x3C;</span><span style=\"color:#005CC5\">DemoSection</span><span style=\"color:#6F42C1\"> title</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"打开态视觉基线\"</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">      &#x3C;</span><span style=\"color:#22863A\">div</span><span style=\"color:#6F42C1\"> class</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"demo-row\"</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;</span><span style=\"color:#005CC5\">Tooltip</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">          content</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"本次采购数量按年度维简计划填写，提交后进入审批流。\"</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">          placement</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"bottom\"</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">          arrow</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{</span><span style=\"color:#6F42C1\">arrow</span><span style=\"color:#24292E\">()}</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">          open</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{</span><span style=\"color:#6F42C1\">open</span><span style=\"color:#24292E\">()}</span></span>\n<span class=\"line\"><span style=\"color:#6F42C1\">          onOpenChange</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{setOpen}</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        ></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">          &#x3C;</span><span style=\"color:#22863A\">span</span><span style=\"color:#24292E\">>采购数量说明&#x3C;/</span><span style=\"color:#22863A\">span</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;/</span><span style=\"color:#005CC5\">Tooltip</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;</span><span style=\"color:#005CC5\">Button</span><span style=\"color:#6F42C1\"> variant</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"outline\"</span><span style=\"color:#6F42C1\"> color</span><span style=\"color:#D73A49\">=</span><span style=\"color:#032F62\">\"neutral\"</span><span style=\"color:#6F42C1\"> onClick</span><span style=\"color:#D73A49\">=</span><span style=\"color:#24292E\">{() </span><span style=\"color:#D73A49\">=></span><span style=\"color:#6F42C1\"> setArrow</span><span style=\"color:#24292E\">(</span><span style=\"color:#D73A49\">!</span><span style=\"color:#6F42C1\">arrow</span><span style=\"color:#24292E\">())}></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">          {</span><span style=\"color:#6F42C1\">arrow</span><span style=\"color:#24292E\">() </span><span style=\"color:#D73A49\">?</span><span style=\"color:#032F62\"> '隐藏箭头'</span><span style=\"color:#D73A49\"> :</span><span style=\"color:#032F62\"> '显示箭头'</span><span style=\"color:#24292E\">}</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">        &#x3C;/</span><span style=\"color:#005CC5\">Button</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">      &#x3C;/</span><span style=\"color:#22863A\">div</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">      &#x3C;</span><span style=\"color:#22863A\">p</span><span style=\"color:#24292E\">>提示面板由 Portal 在客户端挂载，服务端只输出触发按钮静态骨架。&#x3C;/</span><span style=\"color:#22863A\">p</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">    &#x3C;/</span><span style=\"color:#005CC5\">DemoSection</span><span style=\"color:#24292E\">></span></span>\n<span class=\"line\"><span style=\"color:#24292E\">  );</span></span>\n<span class=\"line\"><span style=\"color:#24292E\">}</span></span>\n<span class=\"line\"></span></code></pre>"
