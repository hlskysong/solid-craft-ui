          "default": null
        },
        {
          "name": "pageSize",
          "type": "number",
          "optional": false,
          "description": "变更后的每页条数。",
          "default": null
        },
        {
          "name": "total",
          "type": "number",
          "optional": false,
          "description": "总条数（原样回传，便于服务端请求直接拼参数）。",
          "default": null
        }
      ]
    },
    {
      "name": "PaginationItem",
      "inherits": null,
      "props": [
        {
          "name": "key",
          "type": "string",
          "optional": false,
          "description": "稳定标识：`page-3` / `gap-left` / `gap-right`。",
          "default": null
        },
        {
          "name": "type",
          "type": "'page' | 'gap'",
          "optional": false,
          "description": "`page` 是可点击页码，`gap` 是省略号占位。",
          "default": null
        },
        {
          "name": "page",
          "type": "number",
          "optional": false,
          "description": "`type === 'page'` 时的页码；`gap` 时无意义。",
          "default": null
        }
      ]
    },
    {
      "name": "PaginationProps",
      "inherits": "Omit<\n  JSX.HTMLAttributes<HTMLElement>,\n  'children' | 'onChange' | 'style'\n>",
      "props": [
        {
          "name": "total",
          "type": "MaybeAccessor<number>",
          "optional": true,
          "description": "总条数；`0` 时页码列表只剩第 1 页且上一页 / 下一页全部禁用。",
          "default": "0"
        },
        {
          "name": "current",
          "type": "MaybeAccessor<number>",
          "optional": true,
          "description": "受控当前页；给了就完全受控，点击只发 `onChange` 不改内部状态。 越界值在渲染时收敛到 `[1, pageCount]`，不会输出越界页码。",
          "default": "undefined（非受控）"
        },
        {
          "name": "defaultCurrent",
