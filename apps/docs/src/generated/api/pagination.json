          "description": "非受控初始页码；仅在挂载时读取一次。",
          "default": "1"
        },
        {
          "name": "pageSize",
          "type": "MaybeAccessor<number>",
          "optional": true,
          "description": "受控每页条数。",
          "default": "undefined（非受控）"
        },
        {
          "name": "defaultPageSize",
          "type": "MaybeAccessor<number>",
          "optional": true,
          "description": "非受控初始每页条数；仅在挂载时读取一次。",
          "default": "10"
        },
        {
          "name": "pageSizeOptions",
          "type": "MaybeAccessor<PaginationPageSizeOptions>",
          "optional": true,
          "description": "每页条数候选值；`showSizeChanger` 开启时渲染成原生下拉。",
          "default": "[10, 20, 50, 100]"
        },
        {
          "name": "showSizeChanger",
          "type": "MaybeAccessor<boolean>",
          "optional": true,
          "description": "是否显示每页条数切换器。",
          "default": "false"
        },
        {
          "name": "showQuickJumper",
          "type": "MaybeAccessor<boolean>",
          "optional": true,
          "description": "是否显示快速跳转输入框（Enter 提交，越界收敛）。",
          "default": "false"
        },
        {
          "name": "showTotal",
          "type": "(total: number, range: readonly [number, number]) => JSX.Element",
          "optional": true,
          "description": "总数文案渲染函数；返回 `JSX.Element`，由调用方决定语言与排版。 拿到的是区间而不是单个数字，避免调用方自己算 `(current - 1) * pageSize`。",
          "default": "undefined（不渲染）"
