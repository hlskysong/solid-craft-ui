        },
        {
          "name": "size",
          "type": "PaginationSize",
          "optional": true,
          "description": "尺寸。",
          "default": "'medium'"
        },
        {
          "name": "onChange",
          "type": "PaginationChangeHandler",
          "optional": true,
          "description": "分页变更回调；页码与每页条数共用这一个出口。",
          "default": "undefined"
        },
        {
          "name": "style",
          "type": "string",
          "optional": true,
          "description": "根节点样式；与 `class` 一样合并而非覆盖。",
          "default": null
        }
      ]
    }
  ]
}
