{
  "slug": "checkbox",
  "source": "packages/core/src/components/checkbox/types.ts",
  "interfaces": [
    {
      "name": "CheckboxProps",
      "inherits": "Omit<\n  JSX.InputHTMLAttributes<HTMLInputElement>,\n  | 'value'\n  | 'checked'\n  | 'defaultChecked'\n  | 'onChange'\n  | 'children'\n  | 'size'\n  | 'type'\n  | 'indeterminate'\n>",
      "props": [
        {
          "name": "checked",
          "type": "MaybeAccessor<boolean>",
          "optional": true,
          "description": "受控选中态；支持传值或 getter（`MaybeAccessor`）。",
          "default": "undefined（非受控）"
        },
        {
          "name": "defaultChecked",
          "type": "MaybeAccessor<boolean>",
          "optional": true,
          "description": "非受控初始选中态；仅在挂载时读取一次。",
          "default": "false"
        },
        {
          "name": "indeterminate",
          "type": "MaybeAccessor<boolean>",
          "optional": true,
          "description": "半选态。只影响展示与 `aria-checked=\"mixed\"`，不改变 `checked` 的值； 原生 `indeterminate` 是 DOM property，由客户端 effect 写入，SSR 不输出属性。",
          "default": "false"
        },
        {
          "name": "value",
          "type": "string",
          "optional": true,
          "description": "在 `CheckboxGroup` 内的选项值；独立使用时只作为原生 `value` 透传。",
          "default": "undefined"
        },
        {
          "name": "onChange",
          "type": "CheckboxChangeHandler",
          "optional": true,
          "description": "选中态变更回调；第一参数是切换后的布尔值。",
          "default": "undefined"
        },
        {
          "name": "size",
          "type": "CheckboxSize",
          "optional": true,
          "description": "尺寸；在 Group 内未显式给出时继承 Group 的尺寸。",
          "default": "'medium'"
        },
        {
          "name": "status",
          "type": "CheckboxStatus",
          "optional": true,
          "description": "校验态；`error` 时输出 `data-scui-invalid=\"true\"`。被 `<Form.Item>` 包裹时字段状态优先。",
          "default": "'default'"
        },
        {
          "name": "children",
          "type": "JSX.Element",
          "optional": true,
          "description": "文案；由 `<label>` 包裹输入控件，点击文字即可切换。无文案时须自行提供 `aria-label`。",
          "default": "undefined"
        }
      ]
    },
    {
      "name": "CheckboxGroupProps",
      "inherits": "Omit<\n  JSX.FieldsetHTMLAttributes<HTMLFieldSetElement>,\n  'onChange' | 'children' | 'defaultValue'\n>",
      "props": [
        {
          "name": "value",
          "type": "MaybeAccessor<string[]>",
          "optional": true,
          "description": "受控值（已选中的 `value` 数组）；支持传值或 getter。",
          "default": "undefined（非受控）"
        },
        {
          "name": "defaultValue",
          "type": "MaybeAccessor<string[]>",
          "optional": true,
          "description": "非受控初始值；仅在挂载时读取一次。",
          "default": "[]"
        },
        {
          "name": "onChange",
          "type": "CheckboxGroupChangeHandler",
          "optional": true,
          "description": "整组值变更回调；第一参数是去重后的数组。",
          "default": "undefined"
        },
        {
          "name": "options",
          "type": "CheckboxOption[]",
          "optional": true,
          "description": "选项写法；给出后忽略 `children`。",
          "default": "undefined"
        },
        {
          "name": "disabled",
          "type": "boolean",
          "optional": true,
          "description": "整组禁用。",
          "default": "false"
        },
        {
          "name": "size",
          "type": "CheckboxSize",
          "optional": true,
          "description": "尺寸；子项未显式传 `size` 时继承本值。",
          "default": "'medium'"
        },
        {
          "name": "orientation",
          "type": "CheckboxOrientation",
          "optional": true,
          "description": "排列方向，落成 `data-scui-orientation`。",
          "default": "'horizontal'"
        },
        {
          "name": "name",
          "type": "string",
          "optional": true,
          "description": "原生 name；同组同源，缺省由 `createUniqueId()` 生成（SSR 稳定）。",
          "default": "自动生成"
        },
        {
          "name": "children",
          "type": "JSX.Element",
          "optional": true,
          "description": "手写子项写法：直接放 `<Checkbox value=\"...\">...</Checkbox>`。",
          "default": "undefined"
        }
      ]
    }
  ]
}
