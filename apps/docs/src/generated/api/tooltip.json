        {
          "name": "open",
          "type": "boolean",
          "optional": true,
          "description": "受控打开状态；给了就完全由调用方驱动。 @default undefined",
          "default": null
        },
        {
          "name": "defaultOpen",
          "type": "boolean",
          "optional": true,
          "description": "非受控初始状态。 @default false",
          "default": null
        },
        {
          "name": "onOpenChange",
          "type": "(open: boolean) => void",
          "optional": true,
          "description": "打开状态变化出口；hover / focus / ESC 都汇到这一条。",
          "default": null
        },
        {
          "name": "class",
          "type": "string",
          "optional": true,
          "description": "触发按钮自定义类名。 @default undefined",
          "default": null
        }
      ]
    }
  ]
