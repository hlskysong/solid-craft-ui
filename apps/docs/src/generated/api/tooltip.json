{
  "slug": "tooltip",
  "source": "packages/core/src/components/tooltip/types.ts",
  "interfaces": [
    {
      "name": "TooltipProps",
      "inherits": null,
      "props": [
        {
          "name": "content",
          "type": "JSX.Element",
          "optional": false,
          "description": "提示内容，渲染进 `role=\"tooltip\"` 的浮层。",
          "default": null
        },
        {
          "name": "children",
          "type": "JSX.Element",
          "optional": false,
          "description": "触发元素内容；原语负责包成按钮并接管 hover / focus 时序与键盘。",
          "default": null
        },
        {
          "name": "placement",
          "type": "TooltipPlacement",
          "optional": true,
          "description": "锚定方向，恒输出为 `data-scui-anchor`。 @default 'top'",
          "default": null
        },
        {
          "name": "openDelay",
          "type": "number",
          "optional": true,
          "description": "指针进入触发元素到打开的时间（ms）。 @default 200",
          "default": null
        },
        {
          "name": "closeDelay",
          "type": "number",
          "optional": true,
          "description": "指针离开到关闭的时间（ms）。 @default 100",
          "default": null
        },
        {
          "name": "arrow",
          "type": "boolean",
          "optional": true,
          "description": "是否渲染箭头。 @default true",
          "default": null
        },
        {
          "name": "disabled",
          "type": "boolean",
          "optional": true,
          "description": "是否禁用触发（禁用后不响应 hover / focus）。 @default false",
          "default": null
