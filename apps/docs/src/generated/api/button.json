        },
        {
          "name": "iconPosition",
          "type": "'start' | 'end'",
          "optional": true,
          "description": "图标位置。",
          "default": "'start'"
        },
        {
          "name": "shape",
          "type": "'default' | 'round' | 'circle'",
          "optional": true,
          "description": "形状。",
          "default": "'default'"
