          "type": "'solid' | 'outline' | 'dashed' | 'text' | 'link'",
          "optional": true,
          "description": "视觉变体。",
          "default": "'solid'"
        },
        {
          "name": "color",
          "type": "'primary' | 'neutral' | 'success' | 'warning' | 'danger'",
          "optional": true,
          "description": "语义色；neutral 需显式传入。",
          "default": "'primary'"
        },
        {
          "name": "size",
          "type": "'small' | 'medium' | 'large'",
          "optional": true,
          "description": "尺寸。",
          "default": "'medium'"
