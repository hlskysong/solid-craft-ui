{
  "name": "solid-craft",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "author": "Aming <hlsky@foxmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hlskysong/solid-craft-ui.git"
  },
  "homepage": "https://github.com/hlskysong/solid-craft-ui",
  "bugs": {
    "url": "https://github.com/hlskysong/solid-craft-ui/issues"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "LICENSE",
    "llms.txt",
    "llms-full.txt",
    "llms-manifest.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "solid": "./dist/source/index.jsx",
      "import": "./dist/esm/index.js",
      "default": "./dist/esm/index.js"
    },
    "./button": {
      "types": "./dist/types/components/button/index.d.ts",
      "solid": "./dist/source/components/button/index.jsx",
      "import": "./dist/esm/components/button/index.js",
      "default": "./dist/esm/components/button/index.js"
    },
    "./icon": {
      "types": "./dist/types/components/icon/index.d.ts",
      "solid": "./dist/source/components/icon/index.jsx",
      "import": "./dist/esm/components/icon/index.js",
      "default": "./dist/esm/components/icon/index.js"
    },
    "./typography": {
      "types": "./dist/types/components/typography/index.d.ts",
      "solid": "./dist/source/components/typography/index.jsx",
      "import": "./dist/esm/components/typography/index.js",
      "default": "./dist/esm/components/typography/index.js"
    },
    "./space": {
      "types": "./dist/types/components/space/index.d.ts",
      "solid": "./dist/source/components/space/index.jsx",
      "import": "./dist/esm/components/space/index.js",
      "default": "./dist/esm/components/space/index.js"
    },
    "./divider": {
      "types": "./dist/types/components/divider/index.d.ts",
      "solid": "./dist/source/components/divider/index.jsx",
      "import": "./dist/esm/components/divider/index.js",
      "default": "./dist/esm/components/divider/index.js"
    },
    "./layout": {
      "types": "./dist/types/components/layout/index.d.ts",
      "solid": "./dist/source/components/layout/index.jsx",
      "import": "./dist/esm/components/layout/index.js",
      "default": "./dist/esm/components/layout/index.js"
    },
    "./grid": {
      "types": "./dist/types/components/grid/index.d.ts",
      "solid": "./dist/source/components/grid/index.jsx",
      "import": "./dist/esm/components/grid/index.js",
      "default": "./dist/esm/components/grid/index.js"
    },
    "./input": {
      "types": "./dist/types/components/input/index.d.ts",
      "solid": "./dist/source/components/input/index.jsx",
      "import": "./dist/esm/components/input/index.js",
      "default": "./dist/esm/components/input/index.js"
    },
    "./checkbox": {
      "types": "./dist/types/components/checkbox/index.d.ts",
      "solid": "./dist/source/components/checkbox/index.jsx",
      "import": "./dist/esm/components/checkbox/index.js",
      "default": "./dist/esm/components/checkbox/index.js"
    },
    "./radio": {
      "types": "./dist/types/components/radio/index.d.ts",
      "solid": "./dist/source/components/radio/index.jsx",
      "import": "./dist/esm/components/radio/index.js",
      "default": "./dist/esm/components/radio/index.js"
    },
    "./switch": {
      "types": "./dist/types/components/switch/index.d.ts",
      "solid": "./dist/source/components/switch/index.jsx",
      "import": "./dist/esm/components/switch/index.js",
      "default": "./dist/esm/components/switch/index.js"
    },
    "./app": {
      "types": "./dist/types/components/app/index.d.ts",
      "solid": "./dist/source/components/app/index.jsx",
      "import": "./dist/esm/components/app/index.js",
      "default": "./dist/esm/components/app/index.js"
    },
    "./config-provider": {
      "types": "./dist/types/config-provider/index.d.ts",
      "solid": "./dist/source/config-provider/index.jsx",
      "import": "./dist/esm/config-provider/index.js",
      "default": "./dist/esm/config-provider/index.js"
    },
    "./styles.css": {
      "types": "./dist/types/styles.css.d.ts",
      "default": "./dist/styles/index.css"
    },
    "./styles/*": "./dist/styles/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build && node ../../scripts/build-source.mjs packages/core && tsc -p tsconfig.build.json && node ../../scripts/fix-dts.mjs packages/core && node ../../scripts/build-css.mjs && node ../../scripts/check-exports.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "solid-js": "^1.9.0"
  },
  "dependencies": {
    "solid-craft-icons": "workspace:^",
    "solid-craft-tokens": "workspace:^",
    "@floating-ui/dom": "^1.8.0",
    "@internationalized/date": "^3.12.4",
    "@kobalte/core": "^0.13.14",
    "@tanstack/solid-table": "^9.3.1"
  },
  "devDependencies": {
    "solid-js": "1.9.18"
  }
}
