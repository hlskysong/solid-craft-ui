{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "paths": {
      "solid-craft": ["./src/index.ts"],
      "solid-craft/*": ["./src/*"]
    }
  },
  // spikes/ 只做 Phase 0 可行性预研、不进 dist；但类型必须和发布源码一起过 tsc
  "include": ["src/**/*", "spikes/**/*", "vitest.setup.ts"],
  "exclude": ["dist", "node_modules"]
}
