{
  "fontFamily": {
    "$type": "fontFamily",
    "$value": "-apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', 'Helvetica Neue', Arial, sans-serif",
    "$usage": "基础字族（03 §4.1 系统字体栈，不引入 Web Font）"
  },
  "fontFamilyCode": {
    "$type": "fontFamily",
    "$value": "'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, monospace",
    "$usage": "等宽字族：代码、数字对齐场景"
  },
  "fontSize": {
    "xs": { "$type": "dimension", "$value": "12px", "$usage": "辅助说明、标签" },
    "sm": { "$type": "dimension", "$value": "13px", "$usage": "紧凑表格、次要信息" },
    "md": { "$type": "dimension", "$value": "14px", "$usage": "正文、表单、按钮（基准字号）" },
    "lg": { "$type": "dimension", "$value": "16px", "$usage": "卡片标题、强调" },
    "xl": { "$type": "dimension", "$value": "20px", "$usage": "页面小标题" },
    "2xl": { "$type": "dimension", "$value": "24px", "$usage": "页面标题" },
    "3xl": { "$type": "dimension", "$value": "30px", "$usage": "大标题 / 空状态" },
    "4xl": { "$type": "dimension", "$value": "38px", "$usage": "结果页数字" }
  },
  "lineHeight": {
    "xs": { "$type": "dimension", "$value": "20px" },
    "sm": { "$type": "dimension", "$value": "20px" },
    "md": { "$type": "dimension", "$value": "22px" },
    "lg": { "$type": "dimension", "$value": "24px" },
    "xl": { "$type": "dimension", "$value": "28px" },
    "2xl": { "$type": "dimension", "$value": "32px" },
    "3xl": { "$type": "dimension", "$value": "38px" },
    "4xl": { "$type": "dimension", "$value": "46px" }
  },
  "iconSize": {
    "sm": { "$type": "dimension", "$value": "12px", "$usage": "紧凑行内、小号控件内图标" },
    "md": { "$type": "dimension", "$value": "16px", "$usage": "默认图标（对齐 Semi default / TDesign comp-size-xs）" },
    "lg": { "$type": "dimension", "$value": "20px", "$usage": "强调、独立入口图标" }
  }
}
