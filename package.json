{
  "name": "solid-craft-ui-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hlskysong/solid-craft-ui.git"
  },
  "homepage": "https://github.com/hlskysong/solid-craft-ui",
  "bugs": {
    "url": "https://github.com/hlskysong/solid-craft-ui/issues"
  },
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24.15.0",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:browser": "playwright test tests/e2e/specs/browser.spec.ts",
    "test:visual": "playwright test tests/e2e/specs/visual.spec.ts",
    "test:docs": "playwright test tests/e2e/specs/docs.spec.ts",
    "test:llms": "playwright test tests/e2e/specs/llms.spec.ts",
    "test:e2e": "pnpm test:browser && pnpm test:visual && pnpm test:docs && pnpm test:llms",
    "test:visual:update": "playwright test tests/e2e/specs/visual.spec.ts --update-snapshots",
    "lint": "pnpm lint:oxlint && pnpm lint:biome && pnpm lint:style && pnpm lint:format",
    "lint:oxlint": "oxlint --type-aware -c .oxlintrc.json .",
    "lint:biome": "biome lint .",
    "lint:style": "stylelint \"packages/**/src/**/*.scss\"",
    "lint:format": "prettier --check \"packages/**/src/**/*.{ts,tsx,scss}\" \"packages/**/scripts/**/*.mjs\" \"examples/**/src/**/*.{ts,tsx}\" \"examples/**/*.{mjs,ts,json}\" \"apps/**/src/**/*.{ts,tsx,css,mjs}\" \"apps/**/*.{mjs,ts,json}\" \"scripts/**/*.mjs\" \"tests/**/*.ts\" \"playwright.config.ts\" \"*.json\" \".size-limit.json\" \".github/workflows/*.yml\"",
    "format": "prettier --write \"packages/**/src/**/*.{ts,tsx,scss}\" \"packages/**/scripts/**/*.mjs\" \"examples/**/src/**/*.{ts,tsx}\" \"examples/**/*.{mjs,ts,json}\" \"apps/**/src/**/*.{ts,tsx,css,mjs}\" \"apps/**/*.{mjs,ts,json}\" \"scripts/**/*.mjs\" \"tests/**/*.ts\" \"playwright.config.ts\" \"*.json\" \".size-limit.json\" \".github/workflows/*.yml\"",
    "docs:dev": "pnpm --filter solid-craft-ui-docs dev",
    "docs:generate": "node scripts/generate-docs.mjs && node scripts/generate-llms.mjs",
    "generate:llms": "node scripts/generate-llms.mjs",
    "check:docs": "node scripts/generate-docs.mjs --check",
    "check:llms": "node scripts/generate-llms.mjs --check",
    "check:styles": "node scripts/check-styles.mjs",
    "check:accessors": "node scripts/check-accessors.mjs",
    "check:platforms": "node scripts/check-platforms.mjs",
    "check:ci": "node scripts/check-ci.mjs",
    "check:release": "node scripts/check-release.mjs",
    "check:naming": "node scripts/check-naming.mjs",
    "check:public": "node scripts/check-public-repo.mjs",
    "check:goals": "node scripts/check-goals.mjs",
    "check:todo": "node scripts/check-todo.mjs",
    "check:decisions": "node scripts/check-decisions.mjs",
    "size": "size-limit",
    "check:exports": "node scripts/check-exports.mjs",
    "check:slice": "node scripts/check-slice.mjs",
    "check:tokens": "pnpm --filter solid-craft-tokens run typecheck",
    "publint": "pnpm --filter solid-craft exec publint",
    "attw": "pnpm --filter solid-craft exec attw --pack . --profile esm-only --exclude-entrypoints './styles.css' './styles/*' './package.json' --ignore-rules no-resolution cjs-resolves-to-esm",
    "smoke:ssr": "pnpm --filter solid-craft-example-solid-start bundle && pnpm --filter solid-craft-example-solid-start smoke",
    "smoke:consumers": "pnpm --filter solid-craft-example-vite bundle && pnpm --filter solid-craft-example-webpack bundle && pnpm --filter solid-craft-example-rspack bundle && node scripts/check-consumers.mjs",
    "smoke:tarball": "node scripts/smoke-tarball.mjs",
    "smoke:start-real": "pnpm --filter solid-craft-example-start-real bundle && pnpm --filter solid-craft-example-start-real smoke",
    "verify": "pnpm build && pnpm test && pnpm test:e2e && pnpm typecheck && pnpm lint && pnpm check:docs && pnpm check:llms && pnpm check:release && pnpm check:naming && pnpm check:public && pnpm check:goals && pnpm check:todo && pnpm check:decisions && pnpm check:styles && pnpm check:accessors && pnpm check:exports && pnpm check:slice && pnpm size && pnpm check:platforms && pnpm check:ci && pnpm publint && pnpm attw && pnpm smoke:consumers && pnpm smoke:tarball && pnpm smoke:ssr && pnpm smoke:start-real",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm check:release --strict && pnpm build && pnpm check:naming && pnpm check:public && pnpm check:llms && changeset publish",
    "preview:release": "node scripts/preview-release.mjs",
    "stage:release": "node scripts/stage-release.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.5",
    "@changesets/cli": "3.0.3",
    "@playwright/test": "1.64.1",
    "@size-limit/file": "14.3.0",
    "@solidjs/testing-library": "0.8.10",
    "@testing-library/jest-dom": "7.0.1",
    "autoprefixer": "10.6.2",
    "axe-core": "4.14.0",
    "colorjs.io": "0.7.1",
    "esbuild": "0.28.2",
    "fuse.js": "7.5.0",
    "jsdom": "30.1.3",
    "lucide-solid": "1.69.0",
    "oxc-parser": "0.157.0",
    "oxlint": "1.91.0",
    "oxlint-tsgolint": "7.0.2005",
    "postcss": "8.5.32",
    "postcss-preset-env": "11.6.2",
    "postcss-scss": "4.0.9",
    "prettier": "3.9.10",
    "publint": "0.3.25",
    "sass": "1.107.1",
    "shiki": "4.6.0",
    "size-limit": "14.3.0",
    "style-dictionary": "5.8.0",
    "stylelint": "17.16.0",
    "stylelint-config-standard-scss": "17.0.0",
    "turbo": "2.11.10",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vite-plugin-solid": "2.11.15",
    "vitest": "5.1.0"
  },
  "browserslist": [
    "chrome >= 128",
    "last 2 versions",
    "not dead"
  ]
}
